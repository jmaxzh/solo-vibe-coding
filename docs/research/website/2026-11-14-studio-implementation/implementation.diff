+
+<script>
+  const stage = document.querySelector<HTMLElement>('[data-task-stage]');
+  const choices = stage?.querySelectorAll<HTMLInputElement>('.task-choice');
+  const startLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-home-start]')];
+  const synchronizeTask = (task: string, persist = true) => {
+    const choice = [...(choices ?? [])].find((input) => input.value === task);
+    if (!choice) return;
+    choice.checked = true;
+    for (const link of startLinks) {
+      const target = new URL(link.href);
+      target.searchParams.set('task', task);
+      target.hash = 'task-' + task;
+      link.href = target.href;
+    }
+    if (!persist) return;
+    const current = new URL(window.location.href);
+    current.searchParams.set('task', task);
+    window.history.replaceState(window.history.state, '', current);
+    const language = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
+    if (language) {
+      const alternate = new URL(language.href);
+      alternate.searchParams.set('task', task);
+      language.href = alternate.href;
+    }
+  };
+  for (const choice of choices ?? []) choice.addEventListener('change', () => {
+    if (choice.checked) synchronizeTask(choice.value);
+  });
+  const requested = new URLSearchParams(window.location.search).get('task');
+  synchronizeTask(requested ?? 'development', Boolean(requested));
+</script>
