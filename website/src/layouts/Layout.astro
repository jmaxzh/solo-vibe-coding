---
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import { UI, PROJECT, href, type Locale, type PageName } from '../data/site';

interface Props {
  locale: Locale;
  page: PageName;
  title: string;
  description: string;
  route?: string;
  article?: { title: string; date: string; };
  noindex?: boolean;
}

const { locale, page, title, description, route = page === 'home' ? '' : page, article, noindex = false } = Astro.props;
const ui = UI[locale];
const canonical = new URL(href(locale, route), PROJECT.origin).href;
const alternate = locale === 'en' ? 'zh-CN' : 'en';
const englishURL = new URL(href('en', route), PROJECT.origin).href;
const chineseURL = new URL(href('zh-CN', route), PROJECT.origin).href;
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': PROJECT.origin + PROJECT.base + '#website', name: PROJECT.name, url: PROJECT.origin + PROJECT.base, inLanguage: ['en', 'zh-CN'], sameAs: PROJECT.repository },
  { '@type': article ? 'BlogPosting' : 'WebPage', '@id': canonical + '#page', url: canonical, name: title, headline: article?.title ?? title, description, inLanguage: locale, isPartOf: { '@id': PROJECT.origin + PROJECT.base + '#website' }, author: { '@type': 'Person', name: PROJECT.author, url: PROJECT.authorURL }, ...(article ? { datePublished: article.date, image: PROJECT.origin + PROJECT.base + 'social-card.png', mainEntityOfPage: canonical } : {}) },
];
if (page === 'home') graph.push({ '@type': 'CreativeWork', '@id': PROJECT.origin + PROJECT.base + '#skill', name: PROJECT.name, description: UI.en.hero.description, url: PROJECT.repository, license: PROJECT.license, creator: { '@type': 'Person', name: PROJECT.author, url: PROJECT.authorURL }, isAccessibleForFree: true });
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="en" href={englishURL} />
      <link rel="alternate" hreflang="zh-CN" href={chineseURL} />
      <link rel="alternate" hreflang="x-default" href={englishURL} />
    </>}
    <link rel="icon" type="image/svg+xml" href={PROJECT.base + 'favicon.svg'} />
    <link rel="sitemap" href={PROJECT.base + 'sitemap-index.xml'} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={PROJECT.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={PROJECT.origin + PROJECT.base + 'social-card.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Solo Vibe Coding — Build, ship, and grow your product." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={PROJECT.origin + PROJECT.base + 'social-card.png'} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c')} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{ui.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href(locale)} aria-label="Solo Vibe Coding">
          <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect width="40" height="40" rx="11" fill="currentColor"/><path d="m14 12-6 8 6 8m12-16 6 8-6 8m-4-15-4 14" stroke="#f7f5ef" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Solo Vibe Coding</span>
        </a>
        <nav class="main-navigation" aria-label={locale === 'en' ? 'Main navigation' : '主导航'}>
          {(['getting-started', 'guides', 'build-log'] as const).map((item) => <a href={href(locale, item)} data-page={item} aria-current={page === item ? 'page' : undefined}>{ui.nav[item]}</a>)}
          <a class="github-link" href={PROJECT.repository}>{ui.nav.github}<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </nav>
        <a class="language-switch" data-language-switch href={href(alternate, route)} lang={alternate} aria-label={ui.switchLanguage}>{ui.language}</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div><a class="footer-brand" href={href(locale)}>Solo Vibe Coding<span aria-hidden="true">✳</span></a><p>{ui.footer}</p><p class="footer-license">{ui.footerLicense}</p><p class="footer-license">{locale === 'en' ? 'Fonts:' : '字体：'} <a href={PROJECT.base + 'licenses/manrope-OFL.txt'}>Manrope</a> / <a href={PROJECT.base + 'licenses/ibm-plex-mono-OFL.txt'}>IBM Plex Mono</a></p></div>
        <div class="footer-links"><a href={PROJECT.repository}>{ui.footerSource}</a><a href={PROJECT.license}>MIT License</a><a href="#top">{ui.footerTop}</a></div>
      </div>
    </footer>
    <script>
      const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        if (!navigator.clipboard?.writeText) return;
        button.hidden = false;
        button.addEventListener('click', async () => {
          const block = button.closest('.code-block');
          const code = block?.querySelector('code');
          const text = button.querySelector('[data-copy-text]');
          const status = block?.querySelector('[data-copy-status]');
          if (!code || !text || !status) return;
          clearTimeout(timers.get(button));
          try {
            await navigator.clipboard.writeText(code.textContent ?? '');
            text.textContent = button.dataset.copiedLabel ?? 'Copied';
            status.textContent = text.textContent;
            button.dataset.copied = 'true';
          } catch {
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(code);
            selection?.removeAllRanges();
            selection?.addRange(range);
            text.textContent = button.dataset.failedLabel ?? 'Select and copy the text';
            status.textContent = text.textContent;
            delete button.dataset.copied;
          }
          timers.set(button, setTimeout(() => {
            text.textContent = button.dataset.copyLabel ?? 'Copy';
            delete button.dataset.copied;
          }, 2400));
        });
      });

      document.querySelectorAll<HTMLElement>('[data-task-explorer]').forEach((explorer) => {
        const tabs = [...explorer.querySelectorAll<HTMLAnchorElement>('[data-task-tab]')];
        const panels = [...explorer.querySelectorAll<HTMLElement>('[data-task-panel]')];
        explorer.querySelector('[data-task-tabs]')?.setAttribute('role', 'tablist');
        tabs.forEach((tab) => tab.setAttribute('role', 'tab'));
        panels.forEach((panel) => panel.setAttribute('role', 'tabpanel'));
        const select = (index: number, focus = false) => {
          tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
          panels.forEach((panel, i) => { panel.hidden = i !== index; });
          if (focus) tabs[index]?.focus();
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener('click', (event) => { event.preventDefault(); select(index); });
          tab.addEventListener('keydown', (event) => {
            const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index - 1 + tabs.length) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : null;
            if (next === null) return;
            event.preventDefault();
            select(next, true);
          });
        });
        const selectFromHash = () => {
          const index = tabs.findIndex((tab) => tab.hash === window.location.hash);
          if (index >= 0) select(index);
        };
        select(0);
        selectFromHash();
        window.addEventListener('hashchange', selectFromHash);
      });
    </script>
  </body>
</html>
