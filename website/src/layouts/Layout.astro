---
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import { UI, PROJECT, PAGE_PATHS, href, type Locale, type PageName } from '../data/site';

interface Props {
  locale: Locale;
  page: PageName;
  title: string;
  description: string;
  route?: string;
  article?: { title: string; date: string; };
  noindex?: boolean;
}

const { locale, page, title, description, route = PAGE_PATHS[page], article, noindex = false } = Astro.props;
const ui = UI[locale];
const canonical = new URL(href(locale, route), PROJECT.origin).href;
const alternate = locale === 'en' ? 'zh-CN' : 'en';
const englishURL = new URL(href('en', route), PROJECT.origin).href;
const chineseURL = new URL(href('zh-CN', route), PROJECT.origin).href;
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': PROJECT.origin + PROJECT.base + '#website', name: PROJECT.name, url: PROJECT.origin + PROJECT.base, inLanguage: ['en', 'zh-CN'], sameAs: PROJECT.repository },
  { '@type': article ? 'BlogPosting' : 'WebPage', '@id': canonical + '#page', url: canonical, name: title, headline: article?.title ?? title, description, inLanguage: locale, isPartOf: { '@id': PROJECT.origin + PROJECT.base + '#website' }, author: { '@type': 'Person', name: PROJECT.author, url: PROJECT.authorURL }, ...(article ? { datePublished: article.date, image: PROJECT.origin + PROJECT.base + 'social-card.png', mainEntityOfPage: canonical } : {}) },
];
if (page === 'home') graph.push({ '@type': 'CreativeWork', '@id': PROJECT.origin + PROJECT.base + '#skill', name: PROJECT.name, description: UI.en.hero.description, url: PROJECT.repository, license: PROJECT.license, creator: { '@type': 'Person', name: PROJECT.author, url: PROJECT.authorURL }, isAccessibleForFree: true });
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="en" href={englishURL} />
      <link rel="alternate" hreflang="zh-CN" href={chineseURL} />
      <link rel="alternate" hreflang="x-default" href={englishURL} />
    </>}
    <link rel="icon" type="image/svg+xml" href={PROJECT.base + 'favicon.svg'} />
    <link rel="sitemap" href={PROJECT.base + 'sitemap-index.xml'} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={PROJECT.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={PROJECT.origin + PROJECT.base + 'social-card.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Solo Vibe Coding — Get it built. Make it worth sharing." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={PROJECT.origin + PROJECT.base + 'social-card.png'} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c')} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{ui.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href(locale)} aria-label="Solo Vibe Coding">
          <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect width="40" height="40" rx="11" fill="currentColor"/><path d="m14 12-6 8 6 8m12-16 6 8-6 8m-4-15-4 14" stroke="#f7f5ef" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Solo Vibe Coding</span>
        </a>
        <nav class="main-navigation" aria-label={locale === 'en' ? 'Main navigation' : '主导航'}>
          <a href={href(locale, '', 'why-skill')}>{locale === 'en' ? 'Find your task' : '使用场景'}</a>
          <a href={href(locale, '', 'how-it-helps')}>{locale === 'en' ? 'How it helps' : '怎么帮你'}</a>
          <a href={href(locale, 'getting-started')} data-page="getting-started" aria-current={page === 'getting-started' ? 'page' : undefined}>{ui.nav['getting-started']}</a>
        </nav>
        <a class="language-switch" data-language-switch href={href(alternate, route)} lang={alternate} aria-label={ui.switchLanguage}>{ui.language}</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div><a class="footer-brand" href={href(locale)}>Solo Vibe Coding<span aria-hidden="true">✳</span></a><p>{ui.footer}</p><p class="footer-license">{ui.footerLicense}</p></div>
        <div class="footer-links"><a href={href(locale, 'guides')}>{ui.nav.guides}</a><a href={href(locale, PAGE_PATHS.examples)}>{ui.nav.examples}</a><a data-case-link href={href(locale, PAGE_PATHS['case-study'])}>{locale === 'en' ? 'Execution record' : '历史执行记录'}</a><a href={href(locale, 'build-log')}>{ui.nav['build-log']}</a><a href={PROJECT.repository}>{ui.footerSource}</a><a href={PROJECT.license}>MIT License</a><a href="#top">{ui.footerTop}</a></div>
      </div>
    </footer>
    <script>
      const languageLink = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
      const keepTaskInOtherLanguage = () => {
        if (!languageLink) return;
        const target = new URL(languageLink.href);
        target.hash = window.location.hash;
        const task = new URLSearchParams(window.location.search).get('task');
        if (task) target.searchParams.set('task', task);
        else target.searchParams.delete('task');
        languageLink.href = target.href;
      };
      keepTaskInOtherLanguage();
      window.addEventListener('hashchange', keepTaskInOtherLanguage);
      window.addEventListener('popstate', keepTaskInOtherLanguage);
      languageLink?.addEventListener('click', keepTaskInOtherLanguage);

      const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        if (!navigator.clipboard?.writeText) return;
        button.hidden = false;
        button.addEventListener('click', async () => {
          const block = button.closest('.code-block');
          const code = block?.querySelector('code');
          const text = button.querySelector('[data-copy-text]');
          const status = block?.querySelector('[data-copy-status]');
          if (!code || !text || !status) return;
          clearTimeout(timers.get(button));
          try {
            await navigator.clipboard.writeText(code.textContent ?? '');
            text.textContent = button.dataset.copiedLabel ?? 'Copied';
            status.textContent = text.textContent;
            button.dataset.copied = 'true';
          } catch {
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(code);
            selection?.removeAllRanges();
            selection?.addRange(range);
            text.textContent = button.dataset.failedLabel ?? 'Select and copy the text';
            status.textContent = text.textContent;
            delete button.dataset.copied;
          }
          timers.set(button, setTimeout(() => {
            text.textContent = button.dataset.copyLabel ?? 'Copy';
            delete button.dataset.copied;
          }, 2400));
        });
      });

    </script>
  </body>
</html>
