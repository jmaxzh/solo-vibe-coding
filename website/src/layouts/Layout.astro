---
import '../styles/global.css';
import { UI, PROJECT, PAGE_PATHS, href, type Locale, type PageName } from '../data/site';

interface Props {
  locale: Locale;
  page: PageName;
  title: string;
  description: string;
  route?: string;
  article?: { title: string; date: string; };
  noindex?: boolean;
}

const { locale, page, title, description, route = PAGE_PATHS[page], article, noindex = false } = Astro.props;
const ui = UI[locale];
const canonical = new URL(href(locale, route), PROJECT.origin).href;
const alternate = locale === 'en' ? 'zh-CN' : 'en';
const englishURL = new URL(href('en', route), PROJECT.origin).href;
const chineseURL = new URL(href('zh-CN', route), PROJECT.origin).href;
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': PROJECT.origin + PROJECT.base + '#website', name: PROJECT.name, url: PROJECT.origin + PROJECT.base, inLanguage: ['en', 'zh-CN'], sameAs: PROJECT.repository },
  { '@type': article ? 'BlogPosting' : 'WebPage', '@id': canonical + '#page', url: canonical, name: title, headline: article?.title ?? title, description, inLanguage: locale, isPartOf: { '@id': PROJECT.origin + PROJECT.base + '#website' }, author: { '@type': 'Person', name: PROJECT.author, url: PROJECT.authorURL }, ...(article ? { datePublished: article.date, image: PROJECT.origin + PROJECT.base + 'social-card.png', mainEntityOfPage: canonical } : {}) },
];
if (page === 'home') graph.push({ '@type': 'CreativeWork', '@id': PROJECT.origin + PROJECT.base + '#skill', name: PROJECT.name, description: UI.en.hero.description, url: PROJECT.repository, license: PROJECT.license, creator: { '@type': 'Person', name: PROJECT.author, url: PROJECT.authorURL }, isAccessibleForFree: true });
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={page === 'home' ? '#070b0d' : '#f4f0e7'} />
    <meta name="color-scheme" content={page === 'home' ? 'dark' : 'light'} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="en" href={englishURL} />
      <link rel="alternate" hreflang="zh-CN" href={chineseURL} />
      <link rel="alternate" hreflang="x-default" href={englishURL} />
    </>}
    <link rel="icon" type="image/svg+xml" href={PROJECT.base + 'favicon.svg'} />
    <link rel="sitemap" href={PROJECT.base + 'sitemap-index.xml'} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={PROJECT.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={PROJECT.origin + PROJECT.base + 'social-card.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === 'en' ? 'Solo Vibe Coding — Build it sooner. Make it worth sharing.' : 'Solo Vibe Coding：把专业做法，用到你的项目里。'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={PROJECT.origin + PROJECT.base + 'social-card.png'} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c')} />}
  </head>
  <body id="top" class:list={{ homepage: page === 'home' }}>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href(locale)} aria-label="Solo Vibe Coding">
          <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect width="40" height="40" rx="11" fill="currentColor"/><path d="m14 12-6 8 6 8m12-16 6 8-6 8m-4-15-4 14" stroke={page === 'home' ? '#09120d' : '#f7f5ef'} stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Solo Vibe Coding</span>
        </a>
        <nav class="main-navigation" aria-label={locale === 'en' ? 'Main navigation' : '主导航'}>
          <a href={href(locale, '', 'why-skill')}>{locale === 'en' ? 'Find your task' : '使用场景'}</a>
          <a href={href(locale, '', 'how-it-helps')}>{locale === 'en' ? 'How it helps' : '怎么帮你'}</a>
          <a href={href(locale, 'getting-started')} data-page="getting-started" data-home-start={page === 'home' || undefined} aria-current={page === 'getting-started' ? 'page' : undefined}>{ui.nav['getting-started']}</a>
        </nav>
        <a class="language-switch" data-language-switch href={href(alternate, route)} lang={alternate} aria-label={ui.switchLanguage}>{ui.language}</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div><a class="footer-brand" href={href(locale)}>Solo Vibe Coding<span aria-hidden="true">✳</span></a><p>{ui.footer}</p><p class="footer-license">{ui.footerLicense} <a href={PROJECT.base + 'licenses/visual-assets.txt'}>{locale === 'en' ? 'Visual credits' : '视觉素材来源'}</a></p></div>
        <div class="footer-links"><a href={href(locale, '', 'why-skill')}>{locale === 'en' ? 'Find your task' : '使用场景'}</a><a href={href(locale, '', 'how-it-helps')}>{locale === 'en' ? 'How it helps' : '怎么帮你'}</a><a href={href(locale, 'guides')}>{ui.nav.guides}</a><a href={href(locale, PAGE_PATHS.examples)}>{ui.nav.examples}</a><a data-case-link href={href(locale, PAGE_PATHS['case-study'])}>{locale === 'en' ? 'Execution record' : '历史执行记录'}</a><a href={href(locale, 'build-log')}>{ui.nav['build-log']}</a><a href={PROJECT.repository}>{ui.footerSource}</a><a href={PROJECT.license}>MIT License</a><a href="#top">{ui.footerTop}</a></div>
      </div>
    </footer>
    <script>
      const languageLink = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
      const keepTaskInOtherLanguage = () => {
        if (!languageLink) return;
        const target = new URL(languageLink.href);
        target.hash = window.location.hash;
        const task = new URLSearchParams(window.location.search).get('task');
        if (task) target.searchParams.set('task', task);
        else target.searchParams.delete('task');
        languageLink.href = target.href;
      };
      keepTaskInOtherLanguage();
      window.addEventListener('hashchange', keepTaskInOtherLanguage);
      window.addEventListener('popstate', keepTaskInOtherLanguage);
      languageLink?.addEventListener('click', keepTaskInOtherLanguage);

      const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        if (!navigator.clipboard?.writeText) return;
        button.hidden = false;
        button.addEventListener('click', async () => {
          const block = button.closest('.code-block');
          const code = block?.querySelector('code');
          const text = button.querySelector('[data-copy-text]');
          const status = block?.querySelector('[data-copy-status]');
          if (!code || !text || !status) return;
          clearTimeout(timers.get(button));
          try {
            await navigator.clipboard.writeText(code.textContent ?? '');
            text.textContent = button.dataset.copiedLabel ?? 'Copied';
            status.textContent = text.textContent;
            button.dataset.copied = 'true';
          } catch {
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(code);
            selection?.removeAllRanges();
            selection?.addRange(range);
            text.textContent = button.dataset.failedLabel ?? 'Select and copy the text';
            status.textContent = text.textContent;
            delete button.dataset.copied;
          }
          timers.set(button, setTimeout(() => {
            text.textContent = button.dataset.copyLabel ?? 'Copy';
            delete button.dataset.copied;
          }, 2400));
        });
      });

    </script>
  </body>
</html>

<style>
  :global(body.homepage) { --home-header-height: 88px; --paper: #070b0d; --surface: #151d19; --ink: #f1f9f5; --muted: #bcd1c7; --action: #c5f8b9; --action-hover: #aae1c7; --accent-ink: #d1ecdf; --line: #486054; --blue: #bce8d3; --radius-panel: 16px; --radius-card: 12px; background: #070b0d; color-scheme: dark; }
  :global(.homepage .container) { width: min(1320px, calc(100% - 112px)); }
  :global(.homepage .site-header) { position: absolute; inset: 0 0 auto; z-index: 20; border: 0; background: linear-gradient(180deg, #070908fa 0%, #070908c9 70%, #07090800 100%); }
  :global(.homepage .header-inner) { min-height: var(--home-header-height); gap: 32px; flex-wrap: nowrap; padding-block: 0; }
  :global(.homepage .brand) { gap: 10px; font-size: 16px; min-height: 44px; margin-right: 0; letter-spacing: -.04em; }
  :global(.homepage .brand-mark) { width: 31px; height: 31px; color: #eaf8f1; }
  :global(.homepage .main-navigation) { gap: 29px; order: 0; width: auto; margin-left: auto; justify-content: initial; }
  :global(.homepage .main-navigation a) { min-height: 44px; display: inline-flex; align-items: center; font-size: 11px; font-weight: 500; color: #cadcd3; }
  :global(.homepage .main-navigation a:hover) { color: #b5e5ce; }
  :global(.homepage .main-navigation a:last-child) { padding: 9px 20px; border: 1px solid #b8cbc2; border-radius: 99px; color: #f3fbf7; background: #33493e40; }
  :global(.homepage .language-switch) { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; margin-left: 0; font-size: 10px; padding: 5px 10px; border: 1px solid #819e90; background: #121f1980; color: #e4f6ed; border-radius: 99px; }
  :global(.homepage .site-footer) { background: #0c1310; border-color: #415a4e; padding-block: 40px; position: relative; z-index: 2; }
  :global(.homepage .footer-inner) { gap: 60px; }
  :global(.homepage .footer-brand) { font-size: 15px; }
  :global(.homepage .site-footer p) { font-size: 11px; max-width: 400px; color: #b9d1c5; }
  :global(.homepage .site-footer .footer-license) { font-size: 10px; max-width: 420px; line-height: 1.95; }
  :global(.homepage .footer-links) { display: grid; grid-template-columns: repeat(3, auto); gap: 6px 28px; text-align: left; font-size: 11px; color: #d4e9df; }
  :global(.homepage .footer-links a) { display: inline-flex; align-items: center; min-height: 34px; }
  :global(.homepage ::selection) { background: #a2d9bf; color: #0c1310; }
  :global(html[data-motion="off"] .homepage [data-magnetic]) { transition: none; }
  @media (max-width: 1000px) { :global(.homepage .container) { width: calc(100% - 80px); } }
  @media (max-width: 800px) { :global(.homepage .container) { width: calc(100% - 48px); } :global(.homepage .header-inner) { gap: 20px; } :global(.homepage .main-navigation) { gap: 17px; } :global(.homepage .footer-inner) { flex-direction: column; gap: 25px; } }
  @media (max-width: 600px) { :global(body.homepage) { --home-header-height: 73px; } :global(.homepage .container) { width: calc(100% - 36px); } :global(.homepage .header-inner) { min-height: 73px; gap: 10px; } :global(.homepage .brand) { font-size: 14px; gap: 8px; } :global(.homepage .brand-mark) { width: 27px; height: 27px; } :global(.homepage .main-navigation) { display: none; } :global(.homepage .language-switch) { margin-left: auto; } :global(.homepage .footer-links) { grid-template-columns: repeat(3, 1fr); gap: 0 18px; width: 100%; } :global(.homepage .footer-links a) { min-height: 44px; } }
</style>
