---
import CodeBlock from './CodeBlock.astro';
import { TASKS, UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale];
---
<section class="task-workbench" data-task-explorer aria-label={ui.hero.panelTitle}>
  <div class="workbench-heading">
    <div class="workbench-symbol" aria-hidden="true"><span></span><span></span><span></span></div>
    <p>{ui.hero.panelTitle}</p>
  </div>
  <nav class="task-tabs" data-task-tabs aria-label={ui.hero.panelNote}>
    {TASKS[locale].map((task) => <a id={`tab-${task.id}`} href={`#task-${task.id}`} data-task-tab={task.id} aria-controls={`task-${task.id}`}>{task.label}</a>)}
  </nav>
  {TASKS[locale].map((task) => (
    <div class="task-panel" id={`task-${task.id}`} data-task-panel={task.id} aria-labelledby={`tab-${task.id}`}>
      <h2>{task.title}</h2>
      <CodeBlock code={task.prompt} locale={locale} label={ui.hero.promptLabel} />
      <div class="task-deliverables"><span class="small-label">{ui.hero.output}</span><ul>{task.deliverables.map((item) => <li>{item}</li>)}</ul></div>
      <a class="workbench-link" href={href(locale, 'guides', task.id)}>{ui.hero.browse}<span aria-hidden="true">↗</span></a>
    </div>
  ))}
</section>
