---
import DeviceMockup from './DeviceMockup.astro';
import Terminal from './Terminal.astro';
import { PROJECT, type Locale } from '../data/site';
interface Props { locale: Locale; title: string; titleLines?: string[]; description: string; kind?: 'start' | 'guides' | 'quote' | 'case' | 'updates' | 'article' | 'missing'; }
const { locale, title, titleLines, description, kind = 'guides' } = Astro.props;
const zh = locale === 'zh-CN';
const illustrated = ['start', 'guides', 'case'].includes(kind);
const labels = { start: zh ? '开始使用' : 'GET STARTED', guides: zh ? '按任务开始' : 'FIND YOUR TASK', quote: zh ? '可操作示例' : 'LIVE EXAMPLE', case: zh ? '历史执行记录' : 'EXECUTION RECORD', updates: zh ? '最新更新' : 'UPDATES', article: zh ? '使用与更新' : 'NOTES', missing: zh ? '返回首页' : 'BACK TO THE START' };
---
<header class:list={['page-intro', 'brand-intro', { illustrated }]} data-page-intro={kind}>
  <div class="intro-copy"><p class="intro-kicker"><span>SOLO VIBE CODING</span><span>{labels[kind]}</span></p><h1>{titleLines ? titleLines.map((line) => <span>{line}</span>) : title}</h1><p>{description}</p><slot /></div>
  {illustrated && <div class="intro-reference">
    {kind === 'start' && <Terminal locale={locale} compact />}
    {kind === 'guides' && <figure><img class="call-image" src={PROJECT.base + 'media/video-call.webp'} width="1000" height="687" alt={zh ? 'Jitsi Meet 的成品界面参考，展示电脑与手机上的视频通话。不是本 Skill 的实测成果。' : 'Jitsi Meet interface reference showing video calls across desktop and phone, not a measured result of this skill.'} decoding="async" /><figcaption>{zh ? '界面参考：' : 'Interface reference: '}<a href="https://github.com/jitsi/jitsi-meet">Jitsi Meet</a></figcaption></figure>}
    {kind === 'case' && <figure><DeviceMockup src={PROJECT.base + 'case-study/bookmarks-round-2.png'} alt={zh ? '历史执行记录中收藏工具的实际截图，具体条件与限制见正文。' : 'An actual bookmark-tool screenshot from the execution record; conditions and limits are explained below.'} /><figcaption>{zh ? '实际项目截图 · 验证条件见正文' : 'Actual project screenshot · conditions below'}</figcaption></figure>}
  </div>}
</header>

<style>
  .brand-intro { display: block; max-width: none; background: var(--blue); color: #fffefa; border-radius: var(--radius-panel); padding: 43px 40px; margin-bottom: 38px; overflow: hidden; }
  .brand-intro.illustrated { display: grid; grid-template-columns: 1.15fr 1fr; gap: 43px; align-items: center; }
  .intro-copy { min-width: 0; }
  .intro-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 15px; color: #e4ecff; font-size: 9px; letter-spacing: .08em; margin-bottom: 21px; }
  .intro-kicker > span:last-child { color: #daf29b; border-left: 1px solid #7c9cfa; padding-left: 15px; }
  .intro-copy h1 { font-size: clamp(2.2rem, 3.2vw, 3.05rem); line-height: 1.25; letter-spacing: -.035em; max-width: 24ch; font-weight: 750; }
  .intro-copy h1 > span { display: block; }
  .intro-copy > p:not(.intro-kicker) { max-width: 60ch; color: #eef2ff; font-size: .95rem; line-height: 1.9; margin-top: 20px; }
  .intro-copy :global(p) { color: #eef2ff; }
  .intro-copy :global(a) { color: #fffefa; }
  .intro-copy :global(a:focus-visible), .intro-reference :global(a:focus-visible) { outline-color: #fffefa; }
  .intro-copy :global(.text-link) { margin-top: 20px; border-color: #d4e1ff; font-size: .78rem; }
  .intro-copy :global(.article-meta) { color: #e9efff; margin-top: 22px; }
  .intro-reference { min-width: 0; }
  .intro-reference figure { margin: 0; }
  .call-image { display: block; width: 100%; height: auto; }
  .intro-reference figcaption { margin-top: 16px; font-size: 10px; color: #e4ecff; text-align: center; }
  @media (max-width: 1100px) { .brand-intro { padding: 34px; } .brand-intro.illustrated { gap: 30px; } }
  @media (max-width: 800px) { .brand-intro, .brand-intro.illustrated { grid-template-columns: 1fr; padding: 32px; gap: 30px; } .intro-copy h1 { max-width: 28ch; } .intro-reference { width: 100%; max-width: 480px; } }
  @media (max-width: 480px) { .brand-intro, .brand-intro.illustrated { padding: 27px 23px; border-radius: 18px; margin-bottom: 27px; gap: 24px; } .intro-copy h1 { font-size: 2rem; letter-spacing: -.03em; } .intro-copy > p:not(.intro-kicker) { font-size: .86rem; margin-top: 17px; } .intro-kicker { font-size: 8px; margin-bottom: 18px; } .intro-reference figcaption { font-size: 9px; } }
</style>
