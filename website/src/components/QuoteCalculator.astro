---
import { UI, type Locale } from '../data/site';
import { calculateQuote } from '../lib/quote';
interface Props { locale: Locale; compact?: boolean; id?: string; }
const { locale, compact = false, id = 'quote' } = Astro.props;
const ui = UI[locale].calculator;
const initial = calculateQuote({ hours: 12, rate: ui.defaultRate, extras: 0, reserve: 10 });
const format = (cents: number) => new Intl.NumberFormat(locale, { style: 'currency', currency: ui.currency }).format(cents / 100);
const fields = [
  { name: 'hours', label: ui.hours, value: 12, step: 'any', max: 10000 },
  { name: 'rate', label: `${ui.rate} (${ui.currency})`, value: ui.defaultRate, step: 0.01, max: 1000000 },
  { name: 'extras', label: `${ui.extras} (${ui.currency})`, value: 0, step: 0.01, max: 1000000000 },
  { name: 'reserve', label: ui.reserve, value: 10, step: 'any', max: 100 },
];
---
<form class:list={['quote-calculator', { 'quote-compact': compact }]} data-calculator data-locale={locale} data-currency={ui.currency} data-messages={JSON.stringify(ui.messages)} data-success={ui.success} data-filename={ui.filename} data-csv={JSON.stringify(ui.csv)} aria-label={ui.title}>
  <div class="quote-heading"><svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><rect x="5" y="2" width="18" height="24" rx="4" stroke="currentColor" stroke-width="1.7"/><path d="M9 7h10M9 12h2m6 0h2m-10 5h2m6 0h2m-10 5h2m6 0h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><h2>{ui.title}</h2><span>{ui.currency}</span></div>
  <fieldset class="quote-fields" disabled data-calculator-fields><legend class="sr-only">{ui.title}</legend>{fields.map((field) => <div><label for={`${id}-${field.name}`}>{field.label}</label><input id={`${id}-${field.name}`} name={field.name} type="number" value={field.value} min="0" max={field.max} step={field.step} required inputmode="decimal" aria-describedby={`${id}-error`} /></div>)}</fieldset>
  <div class="quote-total"><span>{ui.total}</span><output name="total" data-total aria-live="polite" aria-atomic="true">{format(initial.totalCents)}</output></div>
  <dl class="quote-breakdown"><div><dt>{ui.base}</dt><dd data-base>{format(initial.baseCents)}</dd></div><div><dt>{ui.reserveAmount}</dt><dd data-reserve>{format(initial.reserveCents)}</dd></div></dl>
  <p class="quote-formula">{ui.formula}</p>
  <p class="quote-error" id={`${id}-error`} data-calculator-error role="status" hidden>{ui.invalid}</p>
  {!compact && <button class="button button-download" type="button" data-download hidden><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v10m-4-4 4 4 4-4M4 14v3h12v-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{ui.download}</button>}
  <span class="sr-only" data-download-status role="status"></span>
  <noscript><p class="quote-noscript">{ui.noJS}</p></noscript>
</form>

<script>
  import { calculateQuote } from '../lib/quote';
  document.querySelectorAll<HTMLFormElement>('[data-calculator]').forEach((form) => {
    const fieldset = form.querySelector<HTMLFieldSetElement>('[data-calculator-fields]');
    const inputs = ['hours', 'rate', 'extras', 'reserve'].map((name) => form.querySelector<HTMLInputElement>(`input[name="${name}"]`)!);
    const total = form.querySelector<HTMLOutputElement>('[data-total]')!;
    const base = form.querySelector<HTMLElement>('[data-base]')!;
    const reserve = form.querySelector<HTMLElement>('[data-reserve]')!;
    const error = form.querySelector<HTMLElement>('[data-calculator-error]')!;
    const messages: Record<string, string> = JSON.parse(form.dataset.messages ?? '{}');
    const download = form.querySelector<HTMLButtonElement>('[data-download]');
    const formatter = new Intl.NumberFormat(form.dataset.locale, { style: 'currency', currency: form.dataset.currency });
    const money = (cents: number) => formatter.format(cents / 100);
    if (fieldset) fieldset.disabled = false;
    if (download) download.hidden = false;
    const update = () => {
      const valid = inputs.every((input) => input.validity.valid && Number.isFinite(input.valueAsNumber));
      error.hidden = valid;
      for (const input of inputs) input.setAttribute('aria-invalid', String(!input.validity.valid || !Number.isFinite(input.valueAsNumber)));
      if (download) download.disabled = !valid;
      if (!valid) {
        const invalid = inputs.find((input) => !input.validity.valid || !Number.isFinite(input.valueAsNumber))!;
        const label = form.querySelector(`label[for="${invalid.id}"]`)?.textContent ?? '';
        const template = invalid.validity.rangeOverflow || invalid.validity.rangeUnderflow ? messages.range : invalid.validity.stepMismatch ? messages.precision : messages.missing;
        error.textContent = template.replaceAll('{field}', label).replaceAll('{min}', invalid.min).replaceAll('{max}', invalid.max);
        total.value = '—'; base.textContent = '—'; reserve.textContent = '—'; return null;
      }
      const [hours, rate, extras, percentage] = inputs.map((input) => input.valueAsNumber);
      const result = calculateQuote({ hours, rate, extras, reserve: percentage });
      total.value = money(result.totalCents);
      base.textContent = money(result.baseCents);
      reserve.textContent = money(result.reserveCents);
      return { ...result, hours, percentage };
    };
    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('input', update);
    download?.addEventListener('click', () => {
      const result = update();
      if (!result) return;
      const labels: string[] = JSON.parse(form.dataset.csv ?? '[]');
      const rows = [
        [labels[0], labels[1], labels[2]],
        [labels[3], result.hours, ''], [labels[4], (result.rateCents / 100).toFixed(2), form.dataset.currency],
        [labels[5], (result.extraCents / 100).toFixed(2), form.dataset.currency], [labels[6], result.percentage, ''],
        [labels[7], (result.baseCents / 100).toFixed(2), form.dataset.currency],
        [labels[8], (result.reserveCents / 100).toFixed(2), form.dataset.currency],
        [labels[9], (result.totalCents / 100).toFixed(2), form.dataset.currency],
      ];
      const csv = '\ufeff' + rows.map((row) => row.map((cell) => `"${String(cell ?? '').replaceAll('"', '""')}"`).join(',')).join('\r\n') + '\r\n';
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = form.dataset.filename ?? 'quote.csv';
      document.body.append(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      const status = form.querySelector('[data-download-status]');
      if (status) status.textContent = form.dataset.success ?? '';
    });
    update();
  });
</script>
