---
import { OUTCOMES, OUTCOME_UI } from '../data/outcomes';
import WorkflowDiagram from './WorkflowDiagram.astro';
import { type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
const labels = zh ? { development: '排查与修复', design: '改进产品界面', deployment: '接通并上线', growth: '找到第一批用户' } : { development: 'Fix a regression', design: 'Improve the interface', deployment: 'Get the demo live', growth: 'Reach your first users' };
---
<section class="task-stage" id="usage-demo" aria-labelledby="demo-title" data-task-stage>
  <h2 id="demo-title" class="sr-only">{zh ? '在编程助手中怎样使用' : 'How to use it in your coding assistant'}</h2>
  <fieldset>
    <legend class="sr-only">{OUTCOME_UI[locale].selector}</legend>
    {OUTCOMES[locale].map((outcome) => <input class="sr-only task-choice" type="radio" name={'task-' + locale} id={'choose-' + outcome.id + '-' + locale} value={outcome.id} checked={outcome.id === 'design'} />)}
    <figure class="assistant-demo" data-hero-object aria-label={zh ? '工作方式示意' : 'How it works'}>
      <div class="demo-window" data-art-transform>
        <div class="demo-toolbar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{zh ? '你自己的编程助手' : 'Your own coding assistant'}<span class="toolbar-project"> / {zh ? '当前项目' : 'your project'}</span></span><span class="demo-badge">{zh ? '使用方式示意' : 'Illustrative workflow'}</span></div>
        <div class="demo-layout">
          <aside class="demo-sidebar" aria-label={zh ? '浏览四类任务' : 'Explore four tasks'}>
            <div class="project-label"><span aria-hidden="true">⌘</span><strong>{zh ? '我的产品项目' : 'My product project'}</strong></div>
            <p class="sidebar-caption">{zh ? '今天想推进哪件事？' : 'What are you working on?'}</p>
            <div class="task-options">{OUTCOMES[locale].map((outcome, index) => <label for={'choose-' + outcome.id + '-' + locale} data-choice={outcome.id}><span class="task-number" aria-hidden="true">0{index + 1}</span><span>{labels[outcome.id]}</span><span class="task-option-arrow" aria-hidden="true">↗</span></label>)}</div>
            <div class="sidebar-skill"><span class="skill-symbol" aria-hidden="true">✳</span><div><strong>Solo Vibe Coding</strong><small>{zh ? '为助手补充专业方法' : 'Guidance for your assistant'}</small></div></div>
          </aside>
          <WorkflowDiagram locale={locale} />
        </div>
      </div>
      <figcaption><span>{zh ? '使用方式示意，非实际执行结果。任务在你自己的编程助手中完成。' : 'An illustration, not an executed result. The work happens in your own coding assistant.'}</span><button class="motion-toggle" type="button" data-motion-toggle data-pause={zh ? '暂停动画' : 'Pause motion'} data-play={zh ? '开启动画' : 'Play motion'} data-reduced={zh ? '动画已关闭' : 'Motion reduced'} hidden><span aria-hidden="true">Ⅱ</span><span data-motion-label>{zh ? '暂停动画' : 'Pause motion'}</span></button></figcaption>
    </figure>
  </fieldset>
</section>

<style>
  .task-stage { margin: 48px auto 0; max-width: 1080px; scroll-margin-top: 24px; }
  fieldset { min-width: 0; padding: 0; margin: 0; border: 0; }
  .assistant-demo { margin: 0; min-width: 0; }
  .demo-window { border: 1px solid #fff; border-radius: 20px; background: #ffffff80; padding: 9px; box-shadow: 0 25px 75px -38px #3d5b894f, 0 3px 12px #314a6a08; }
  .demo-toolbar { display: flex; align-items: center; gap: 14px; min-height: 46px; padding: 0 14px 8px; font-size: 12px; color: #566779; }
  .window-dots { display: flex; gap: 5px; }
  .window-dots i { width: 7px; height: 7px; border-radius: 50%; background: #f3aeaa; }
  .window-dots i:nth-child(2) { background: #edce85; }
  .window-dots i:nth-child(3) { background: #a1cbb4; }
  .toolbar-project { color: #5d6f84; }
  .demo-badge { margin-left: auto; font-size: 10px; border: 1px solid #dbe4ee; background: #fff; padding: 3px 8px; border-radius: 5px; white-space: nowrap; }
  .demo-layout { display: grid; grid-template-columns: 218px minmax(0, 1fr); border: 1px solid #dfe5ee; border-radius: 12px; overflow: hidden; background: #fff; }
  .demo-sidebar { background: #f8fafd; border-right: 1px solid #e7ecf2; display: flex; flex-direction: column; padding: 25px 14px 18px; }
  .project-label { display: flex; align-items: center; gap: 10px; padding-inline: 10px; font-size: 12px; }
  .project-label > span { border: 1px solid #dce4ed; background: #fff; border-radius: 7px; padding: 3px 7px; font-size: 18px; }
  .project-label strong { font-weight: 600; }
  .sidebar-caption { color: #596b82; font-size: 11px; margin: 31px 10px 12px; }
  .task-options { display: grid; gap: 7px; }
  .task-options label { min-height: 43px; display: flex; align-items: center; gap: 9px; padding: 10px; border: 1px solid transparent; border-radius: 7px; font-size: 12px; color: #536478; cursor: pointer; }
  .task-number { font: 10px var(--mono); color: #52677f; }
  .task-option-arrow { margin-left: auto; visibility: hidden; }
  .task-options label:hover { background: #eef3f9; }
  fieldset:has(input[value="development"]:checked) label[data-choice="development"], fieldset:has(input[value="design"]:checked) label[data-choice="design"], fieldset:has(input[value="deployment"]:checked) label[data-choice="deployment"], fieldset:has(input[value="growth"]:checked) label[data-choice="growth"] { color: #1e5a9c; background: #e6f0fd; border-color: #c6daf2; font-weight: 600; }
  fieldset:has(input[value="development"]:checked) label[data-choice="development"] .task-option-arrow, fieldset:has(input[value="design"]:checked) label[data-choice="design"] .task-option-arrow, fieldset:has(input[value="deployment"]:checked) label[data-choice="deployment"] .task-option-arrow, fieldset:has(input[value="growth"]:checked) label[data-choice="growth"] .task-option-arrow { visibility: visible; }
  fieldset:has(input[value="development"]:focus-visible) label[data-choice="development"], fieldset:has(input[value="design"]:focus-visible) label[data-choice="design"], fieldset:has(input[value="deployment"]:focus-visible) label[data-choice="deployment"], fieldset:has(input[value="growth"]:focus-visible) label[data-choice="growth"] { outline: 3px solid #2671c5; outline-offset: 2px; }
  .sidebar-skill { display: flex; gap: 9px; margin-top: auto; padding: 45px 10px 0; align-items: center; }
  .skill-symbol { color: #347bc5; font-size: 27px; }
  .sidebar-skill strong { display: block; font-size: 11px; font-weight: 650; }
  .sidebar-skill small { display: block; font-size: 10px; color: #596b82; margin-top: 2px; }
  figcaption { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px 16px; margin-top: 14px; color: #596b82; font-size: 11px; text-align: center; }
  .motion-toggle { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 5px 8px; border: 0; border-radius: 5px; background: transparent; color: #576b81; font-size: 11px; }
  .motion-toggle:hover { background: #eaf0f7; }
  .motion-toggle:disabled { cursor: default; }
  @media (max-width: 800px) { .demo-layout { grid-template-columns: 185px minmax(0, 1fr); } .demo-sidebar { padding-inline: 9px; } .toolbar-project { display: none; } }
  @media (max-width: 600px) {
    .task-stage { margin-top: 31px; }
    .demo-window { border-radius: 14px; padding: 5px; }
    .demo-toolbar { padding: 5px 7px 10px; font-size: 10px; gap: 9px; }
    .window-dots { gap: 3px; } .window-dots i { width: 5px; height: 5px; }
    .demo-badge { font-size: 9px; padding-inline: 5px; }
    .demo-layout { grid-template-columns: 1fr; border-radius: 9px; }
    .demo-sidebar { padding: 12px; border: 0; border-bottom: 1px solid #e7ecf2; }
    .project-label, .sidebar-skill { display: none; }
    .sidebar-caption { margin: 0 0 8px; font-size: 10px; }
    .task-options { grid-template-columns: 1fr 1fr; gap: 5px; }
    .task-options label { font-size: 11px; padding: 8px; min-height: 44px; gap: 7px; }
    .task-number { font-size: 9px; }
    figcaption { margin: 12px 7px 0; font-size: 10px; gap: 0; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-task-stage]');
  const choices = [...(stage?.querySelectorAll<HTMLInputElement>('.task-choice') ?? [])];
  const startLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-home-start]')];
  const synchronizeTask = (task: string, persist = true) => {
    const choice = choices.find((input) => input.value === task) ?? choices.find((input) => input.value === 'design');
    if (!choice) return;
    task = choice.value;
    choice.checked = true;
    for (const link of startLinks) {
      const target = new URL(link.href);
      target.searchParams.set('task', task);
      target.hash = 'task-' + task;
      link.href = target.href;
    }
    if (!persist) return;
    const current = new URL(window.location.href);
    current.searchParams.set('task', task);
    window.history.replaceState(window.history.state, '', current);
    const language = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
    if (language) {
      const alternate = new URL(language.href);
      alternate.searchParams.set('task', task);
      language.href = alternate.href;
    }
  };
  choices.forEach((choice) => choice.addEventListener('change', () => { if (choice.checked) synchronizeTask(choice.value); }));
  window.addEventListener('popstate', () => synchronizeTask(new URLSearchParams(location.search).get('task') ?? 'design', false));
  const requested = new URLSearchParams(window.location.search).get('task');
  synchronizeTask(requested ?? 'design', Boolean(requested));
</script>
