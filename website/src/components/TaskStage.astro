---
import { OUTCOMES, OUTCOME_UI } from '../data/outcomes';
import TaskVisual from './TaskVisual.astro';
import { href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = OUTCOME_UI[locale];
const outcomes = OUTCOMES[locale];
const themes = { development: '#e7edff', design: '#ffebe3', deployment: '#edf4cf', growth: '#e8e9fb' };
---
<section class="task-stage" id="why-skill" aria-labelledby="stage-title" data-task-stage>
  <div class="stage-heading"><h2 id="stage-title">{ui.stageTitle}</h2><p>{ui.stageDescription}</p></div>
  <fieldset>
    <legend class="sr-only">{ui.selector}</legend>
    {outcomes.map((outcome, index) => <input class="sr-only task-choice" type="radio" name={'task-' + locale} id={'choose-' + outcome.id + '-' + locale} value={outcome.id} checked={index === 0} />)}
    <div class="task-options">
      {outcomes.map((outcome, index) => <label for={'choose-' + outcome.id + '-' + locale} data-choice={outcome.id}><small class="task-number" aria-hidden="true">0{index + 1}</small><span>{outcome.label}</span><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" /></svg></label>)}
    </div>
    {outcomes.map((outcome) => <article class="task-panel" data-outcome={outcome.id} aria-labelledby={'pain-' + outcome.id} style={'--case-surface:' + themes[outcome.id]}>
      <div class="task-panel-top">
        <div class="task-context">
          <p class="task-goal"><span>{ui.goal}</span>{outcome.goal}</p>
          <h3 id={'pain-' + outcome.id}>{outcome.pain}</h3>
          <p class="task-situation">{outcome.situation}</p>
          <div class="case-actions"><a class="task-start" data-task-start={outcome.id} href={href(locale, 'getting-started') + '?task=' + outcome.id + '#task-' + outcome.id}>{ui.start}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a><a class="discussion-link" href={outcome.source.url}>{ui.source}<span aria-hidden="true">↗</span></a></div>
        </div>
        <figure class="result-preview">
          <TaskVisual locale={locale} kind={outcome.id} />
          <figcaption><span>{ui.preview}</span><p>{outcome.previewTitle}</p><small>{outcome.previewText}</small></figcaption>
        </figure>
      </div>
      <div class="task-help"><h4>{ui.help}</h4><ol>{outcome.help.map((item) => <li><h5>{item.title}</h5><p>{item.text}</p></li>)}</ol></div>
      <div class="task-delivery"><h4>{ui.deliverables}</h4><ul>{outcome.deliverables.map((item) => <li><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m4 9 3 3 7-7" /></svg>{item}</li>)}</ul></div>
    </article>)}
  </fieldset>
</section>

<style>
  .task-stage { margin-top: 73px; }
  .stage-heading { display: flex; justify-content: space-between; align-items: end; gap: 50px; margin-bottom: 32px; }
  .stage-heading h2 { font-size: clamp(2rem, 3.1vw, 2.8rem); letter-spacing: -.03em; max-width: 19ch; }
  .stage-heading > p { color: var(--muted); font-size: .86rem; max-width: 35ch; line-height: 1.85; }
  fieldset { min-width: 0; border: 0; padding: 0; margin: 0; }
  .task-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 15px; margin-bottom: 20px; }
  .task-options label { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 22px 20px 24px; gap: 14px; cursor: pointer; background: #ebece5; border-radius: 16px; color: #28343e; min-width: 0; }
  .task-number { font-family: var(--mono); font-size: 11px; letter-spacing: .05em; opacity: .8; }
  .task-options label > span { font-size: .87rem; font-weight: 650; text-align: center; line-height: 1.6; }
  .task-options label > svg { position: absolute; top: 17px; right: 17px; width: 16px; height: 16px; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; stroke-linecap: round; opacity: .7; }
  .task-stage:has(input[value="development"]:checked) label[data-choice="development"], .task-stage:has(input[value="design"]:checked) label[data-choice="design"], .task-stage:has(input[value="deployment"]:checked) label[data-choice="deployment"], .task-stage:has(input[value="growth"]:checked) label[data-choice="growth"] { background: #17212e; color: #fffefa; }
  .task-stage:has(input[value="development"]:focus-visible) label[data-choice="development"], .task-stage:has(input[value="design"]:focus-visible) label[data-choice="design"], .task-stage:has(input[value="deployment"]:focus-visible) label[data-choice="deployment"], .task-stage:has(input[value="growth"]:focus-visible) label[data-choice="growth"] { outline: 3px solid #2457f5; outline-offset: 4px; }
  .task-panel { display: none; background: #fffef9; border-radius: 22px; overflow: hidden; border: 1px solid #dfe1d9; }
  .task-stage:has(input[value="development"]:checked) [data-outcome="development"], .task-stage:has(input[value="design"]:checked) [data-outcome="design"], .task-stage:has(input[value="deployment"]:checked) [data-outcome="deployment"], .task-stage:has(input[value="growth"]:checked) [data-outcome="growth"] { display: block; }
  .task-panel-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .task-context { padding: 42px 40px; align-self: center; }
  .task-goal { font-size: .8rem; line-height: 1.85; color: #525e68; }
  .task-goal > span { display: block; color: #65707b; font-size: .71rem; margin-bottom: 7px; }
  .task-context h3 { font-size: clamp(1.7rem, 2.4vw, 2.2rem); line-height: 1.35; letter-spacing: -.025em; max-width: 23ch; margin-top: 22px; font-weight: 700; }
  .task-situation { color: #56616b; font-size: .86rem; line-height: 1.95; margin-top: 20px; max-width: 50ch; }
  .case-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 22px; margin-top: 27px; }
  .task-start { display: inline-flex; align-items: center; gap: 22px; background: #17212e; color: #fffefa; text-decoration: none; border-radius: 8px; padding: 13px 17px; font-weight: 600; font-size: .8rem; transition: transform 160ms var(--ease-out), background-color 160ms ease; }
  .task-start:hover { background: #2d435a; }
  .task-start:active { transform: scale(.97); }
  .task-start svg { width: 18px; height: 18px; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .discussion-link { display: inline-flex; align-items: center; gap: 7px; color: #53616f; font-size: .72rem; text-decoration: none; border-bottom: 1px solid #acb4b9; padding-block: 4px; }
  .discussion-link:hover { color: #183dba; }
  .result-preview { margin: 0; position: relative; min-width: 0; background: var(--case-surface); padding: 20px 28px 30px; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
  figcaption { position: relative; text-align: left; padding-top: 2px; z-index: 1; }
  figcaption > span { display: block; color: #56616b; font-size: .65rem; margin-bottom: 7px; }
  figcaption > p { font-size: 1.43rem; font-weight: 700; letter-spacing: -.02em; line-height: 1.4; }
  figcaption > small { display: block; margin-top: 8px; font-size: .73rem; color: #53616b; line-height: 1.8; }
  .task-help { padding: 28px 40px 31px; border-top: 1px solid #dfe1d9; }
  h4 { margin: 0; font-size: .73rem; font-weight: 500; color: #5b6771; }
  .task-help ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 35px; list-style: none; padding: 0; margin-top: 17px; }
  h5 { margin: 0; font-size: .95rem; line-height: 1.6; font-weight: 650; }
  .task-help li > p { color: #58656e; font-size: .82rem; line-height: 1.95; margin-top: 9px; }
  .task-delivery { display: flex; align-items: baseline; gap: 29px; padding: 20px 40px; background: #edf1e5; }
  .task-delivery h4 { color: #465640; flex: none; }
  .task-delivery ul { display: flex; flex-wrap: wrap; gap: 10px 23px; list-style: none; padding: 0; font-size: .75rem; color: #35472d; }
  .task-delivery li { display: flex; align-items: center; gap: 8px; }
  .task-delivery svg { width: 15px; height: 15px; flex: none; stroke: #537b34; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) and (pointer: fine) {
    .task-options label:hover { background: #e0e5ed; }
    .task-stage:has(input[value="development"]:checked) label[data-choice="development"]:hover, .task-stage:has(input[value="design"]:checked) label[data-choice="design"]:hover, .task-stage:has(input[value="deployment"]:checked) label[data-choice="deployment"]:hover, .task-stage:has(input[value="growth"]:checked) label[data-choice="growth"]:hover { background: #23354b; }
  }
  @media (max-width: 1100px) {
    .task-options { gap: 11px; }
    .task-options label { padding-inline: 15px; }
    .task-options label > span { font-size: .76rem; }
    .task-context { padding: 33px 29px; }
    .result-preview { padding-inline: 27px; }
    .task-help, .task-delivery { padding-inline: 29px; }
    .task-help ol { gap: 24px; }
    .task-delivery { gap: 20px; }
  }
  @media (max-width: 800px) {
    .task-stage { margin-top: 50px; }
    .stage-heading { flex-direction: column; align-items: start; gap: 18px; margin-bottom: 25px; }
    .stage-heading h2 { font-size: 2rem; max-width: 25ch; }
    .stage-heading > p { max-width: 55ch; }
    .task-options { grid-template-columns: 1fr 1fr; gap: 11px; }
    .task-options label { flex-direction: row; justify-content: start; padding: 17px 14px; gap: 7px; min-height: 78px; border-radius: 12px; }
    .task-number { min-width: 24px; font-size: 10px; text-align: center; }
    .task-options label > span { text-align: left; font-size: .8rem; }
    .task-options label > svg { display: none; }
    .task-panel-top { grid-template-columns: 1fr; }
    .task-context { padding: 31px 28px; }
    .task-context h3 { font-size: 1.8rem; max-width: 29ch; }
    .result-preview { padding: 16px 28px 27px; }
    .task-help { padding: 27px 28px; }
    .task-help ol { grid-template-columns: 1fr; gap: 23px; }
    .task-help li > p { max-width: 65ch; margin-top: 6px; }
    .task-delivery { flex-direction: column; gap: 14px; padding: 23px 28px; }
    .task-delivery ul { gap: 12px 20px; font-size: .75rem; }
  }
  @media (max-width: 480px) {
    .task-stage { margin-top: 40px; }
    .stage-heading h2 { font-size: 1.7rem; }
    .stage-heading > p { font-size: .8rem; }
    .task-options { gap: 9px; margin-bottom: 15px; }
    .task-options label { padding: 15px 12px; gap: 4px; min-height: 72px; }
    .task-options label > span { font-size: .69rem; line-height: 1.65; }
    .task-panel { border-radius: 16px; }
    .task-context { padding: 27px 22px; }
    .task-context h3 { font-size: 1.55rem; margin-top: 19px; }
    .task-goal { font-size: .75rem; }
    .task-situation { font-size: .81rem; }
    .case-actions { gap: 13px 18px; margin-top: 24px; }
    .task-start { font-size: .76rem; gap: 17px; padding: 12px 14px; }
    .discussion-link { font-size: .68rem; }
    .result-preview { padding: 15px 22px 25px; }
    figcaption > p { font-size: 1.28rem; }
    figcaption > small { font-size: .69rem; }
    .task-help, .task-delivery { padding-inline: 22px; }
  }
</style>
