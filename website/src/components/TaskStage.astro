---
import { OUTCOMES, OUTCOME_UI } from '../data/outcomes';
import WorkflowDiagram from './WorkflowDiagram.astro';
import { type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
const labels = zh ? { development: '排查与修复', design: '改进产品界面', deployment: '接通并上线', growth: '找到第一批用户' } : { development: 'Fix a regression', design: 'Improve the interface', deployment: 'Get the demo live', growth: 'Reach your first users' };
---
<section class="task-stage" id="usage-demo" aria-labelledby="demo-title" data-task-stage>
  <h2 id="demo-title" class="sr-only">{zh ? '在编程助手中怎样使用' : 'How to use it in your coding assistant'}</h2>
  <fieldset>
    <legend class="sr-only">{OUTCOME_UI[locale].selector}</legend>
    {OUTCOMES[locale].map((outcome) => <input class="sr-only task-choice" type="radio" name={'task-' + locale} id={'choose-' + outcome.id + '-' + locale} value={outcome.id} checked={outcome.id === 'design'} />)}
    <figure class="assistant-demo" data-hero-object aria-label={zh ? '工作方式示意' : 'How it works'}>
      <div class="demo-window" data-art-transform>
        <div class="demo-toolbar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{zh ? '你自己的编程助手' : 'Your own coding assistant'}<span class="toolbar-project"> / {zh ? '当前项目' : 'your project'}</span></span><span class="demo-badge">{zh ? '使用方式示意' : 'Illustrative workflow'}</span></div>
        <div class="demo-layout">
          <aside class="demo-sidebar" aria-label={zh ? '浏览四类任务' : 'Explore four tasks'}>
            <div class="project-label"><span aria-hidden="true">⌘</span><strong>{zh ? '我的产品项目' : 'My product project'}</strong></div>
            <p class="sidebar-caption">{zh ? '今天想推进哪件事？' : 'What are you working on?'}</p>
            <div class="task-options">{OUTCOMES[locale].map((outcome, index) => <label for={'choose-' + outcome.id + '-' + locale} data-choice={outcome.id}><span class="task-number" aria-hidden="true">0{index + 1}</span><span>{labels[outcome.id]}</span><span class="task-option-arrow" aria-hidden="true">↗</span></label>)}</div>
            <div class="sidebar-skill"><span class="skill-symbol" aria-hidden="true">✳</span><div><strong>Solo Vibe Coding</strong><small>{zh ? '为助手补充专业方法' : 'Guidance for your assistant'}</small></div></div>
          </aside>
          <WorkflowDiagram locale={locale} />
        </div>
      </div>
      <figcaption><span>{zh ? '使用方式示意，非实际执行结果。任务在你自己的编程助手中完成。' : 'An illustration, not an executed result. The work happens in your own coding assistant.'}</span></figcaption>
    </figure>
  </fieldset>
</section>

<style>
  .task-stage { min-width: 0; width: 100%; scroll-margin-top: 100px; }
  fieldset { min-width: 0; padding: 0; margin: 0; border: 0; }
  .assistant-demo { margin: 0; min-width: 0; }
  .demo-window { border: 1px solid #564c43; border-radius: 8px; background: linear-gradient(125deg, #221a15, #17110d 55%, #211c18); overflow: hidden; box-shadow: 0 25px 90px -40px #b19f9019, inset 0 1px 0 #dcd3cb22; }
  .demo-toolbar { display: flex; align-items: center; gap: 12px; min-height: 53px; padding: 11px 22px; border-bottom: 1px solid #473c35; font-size: 11px; color: #d7d1cc; background: #211a1680; }
  .window-dots { display: flex; gap: 4px; margin-right: 4px; }
  .window-dots i { width: 6px; height: 6px; border-radius: 50%; background: #aa9e95; }
  .window-dots i:first-child { background: #d1beae; }
  .toolbar-project { color: #cec3ba; }
  .demo-badge { margin-left: auto; font-size: 10px; color: #d6c5b8; border: 1px solid #9c8d81; padding: 3px 8px; border-radius: 99px; white-space: nowrap; }
  .demo-layout { display: block; min-width: 0; }
  .demo-sidebar { display: block; padding: 20px 26px; border-bottom: 1px solid #564539; background: #21180f66; }
  .project-label { display: none; align-items: center; gap: 10px; font-size: 12px; color: #eee8e4; padding-inline: 8px; }
  .project-label > span { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid #857a71; border-radius: 6px; color: #e6d9ce; font-size: 18px; }
  .project-label strong { font-weight: 550; }
  .sidebar-caption { display: none; color: #ccc3bc; font-size: 10px; margin: 28px 8px 12px; }
  .task-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .task-options label { display: flex; align-items: center; gap: 8px; padding: 12px 10px; min-height: 46px; border: 1px solid #5e554d; border-radius: 7px; font-size: 11px; color: #e3dad3; background: #33282154; cursor: pointer; line-height: 1.7; }
  .task-number { font: 9px var(--mono); color: #cec4bc; }
  .task-option-arrow { margin-left: auto; visibility: hidden; color: #d5c0af; }
  .task-options label:hover { background: #5e524957; }
  fieldset:has(input[value="development"]:checked) label[data-choice="development"], fieldset:has(input[value="design"]:checked) label[data-choice="design"], fieldset:has(input[value="deployment"]:checked) label[data-choice="deployment"], fieldset:has(input[value="growth"]:checked) label[data-choice="growth"] { color: #f0e7e0; background: #5a524b45; border-color: #95877b; font-weight: 550; }
  fieldset:has(input[value="development"]:checked) label[data-choice="development"] .task-option-arrow, fieldset:has(input[value="design"]:checked) label[data-choice="design"] .task-option-arrow, fieldset:has(input[value="deployment"]:checked) label[data-choice="deployment"] .task-option-arrow, fieldset:has(input[value="growth"]:checked) label[data-choice="growth"] .task-option-arrow { visibility: visible; }
  fieldset:has(input[value="development"]:focus-visible) label[data-choice="development"], fieldset:has(input[value="design"]:focus-visible) label[data-choice="design"], fieldset:has(input[value="deployment"]:focus-visible) label[data-choice="deployment"], fieldset:has(input[value="growth"]:focus-visible) label[data-choice="growth"] { outline: 3px solid #e4d2c4; outline-offset: 3px; }
  .sidebar-skill { display: none; align-items: center; gap: 10px; margin-top: auto; padding: 38px 8px 0; color: #f6f2ee; }
  .skill-symbol { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid #897c72; border-radius: 50%; color: #ebdfd5; font-size: 20px; }
  .sidebar-skill strong { display: block; font-size: 11px; font-weight: 550; }
  .sidebar-skill small { display: block; font-size: 9px; color: #d3c9c0; margin-top: 3px; }
  figcaption { display: block; margin-top: 14px; color: #c9bfb7; font-size: 11px; line-height: 1.85; }
  @media (max-width: 1100px) { .demo-layout { grid-template-columns: 205px minmax(0, 1fr); } .demo-sidebar { padding-inline: 12px; } }
  @media (max-width: 900px) {
    .demo-layout { display: block; }
    .demo-sidebar { padding: 18px; border-right: 0; border-bottom: 1px solid #5c534b; }
    .project-label, .sidebar-caption, .sidebar-skill { display: none; }
    .task-options { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .task-options label { font-size: 11px; }
  }
  @media (max-width: 600px) {
    .demo-window { border-radius: 8px; }
    .demo-toolbar { padding: 12px; font-size: 10px; gap: 8px; }
    .toolbar-project { display: none; }
    .demo-badge { font-size: 9px; padding-inline: 6px; }
    .demo-sidebar { padding: 12px; }
    .task-options { grid-template-columns: 1fr 1fr; gap: 6px; }
    .task-options label { padding: 10px 8px; min-height: 46px; gap: 7px; }
    .task-option-arrow { display: none; }
    figcaption { font-size: 11px; }
  }
</style>


<script>
  const stage = document.querySelector<HTMLElement>('[data-task-stage]');
  const choices = [...(stage?.querySelectorAll<HTMLInputElement>('.task-choice') ?? [])];
  const startLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-home-start]')];
  const synchronizeTask = (task: string, persist = true) => {
    const choice = choices.find((input) => input.value === task) ?? choices.find((input) => input.value === 'design');
    if (!choice) return;
    task = choice.value;
    choice.checked = true;
    for (const link of startLinks) {
      const target = new URL(link.href);
      target.searchParams.set('task', task);
      target.hash = 'task-' + task;
      link.href = target.href;
    }
    if (!persist) return;
    const current = new URL(window.location.href);
    current.searchParams.set('task', task);
    window.history.replaceState(window.history.state, '', current);
    const language = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
    if (language) {
      const alternate = new URL(language.href);
      alternate.searchParams.set('task', task);
      language.href = alternate.href;
    }
  };
  choices.forEach((choice) => choice.addEventListener('change', () => { if (choice.checked) synchronizeTask(choice.value); }));
  window.addEventListener('popstate', () => synchronizeTask(new URLSearchParams(location.search).get('task') ?? 'design', false));
  const requested = new URLSearchParams(window.location.search).get('task');
  synchronizeTask(requested ?? 'design', Boolean(requested));
</script>
