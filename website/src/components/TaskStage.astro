---
import { OUTCOMES, OUTCOME_UI } from '../data/outcomes';
import { href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = OUTCOME_UI[locale];
const outcomes = OUTCOMES[locale];
const zh = locale === 'zh-CN';
---
<section class="task-stage" id="why-skill" aria-labelledby="stage-title" data-task-stage>
  <div class="stage-heading"><h2 id="stage-title">{ui.stageTitle}</h2><span>{zh ? '点击切换任务' : 'Choose a task below'}</span></div>
  <fieldset>
    <legend class="sr-only">{ui.selector}</legend>
    {outcomes.map((outcome, index) => <input class="sr-only task-choice" type="radio" name={`task-${locale}`} id={`choose-${outcome.id}-${locale}`} value={outcome.id} checked={index === 0} />)}
    <div class="task-options">
      {outcomes.map((outcome) => <label for={`choose-${outcome.id}-${locale}`} data-choice={outcome.id}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={outcome.id === 'growth' ? 'M4 5h16v14H4zM4 9h16M8 13h8M8 16h5' : outcome.id === 'design' ? 'M4 4h16v16H4zM4 10h16M10 10v10' : outcome.id === 'requirements' ? 'M4 5h6v6H4zM14 13h6v6h-6zM7 11v5h7M10 8h7v5' : 'M12 16V3m-5 5 5-5 5 5M4 14v6h16v-6'} /></svg><span>{outcome.label}</span></label>)}
    </div>
    {outcomes.map((outcome) => <article class="task-panel" data-outcome={outcome.id} aria-labelledby={`pain-${outcome.id}`}>
      <div class="task-context">
        <p class="task-goal"><span>{ui.goal}</span>{outcome.goal}</p>
        <h3 id={`pain-${outcome.id}`}>{outcome.pain}</h3>
        <p class="task-situation">{outcome.situation}</p>
        <a class="task-start" data-task-start={outcome.id} href={href(locale, 'getting-started') + `?task=${outcome.id}#task-${outcome.id}`}>{ui.start}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
      </div>
      <figure class:list={['result-preview', `result-${outcome.id}`]}>
        <div class="result-surface" aria-hidden="true">
          {outcome.id === 'growth' && <div class="page-specimen">
            <div class="specimen-navigation"><span>Solo Vibe Coding</span><span>{zh ? '从这里开始' : 'Get started'} ↗</span></div>
            <div class="specimen-body"><span class="specimen-rule"></span><p class="specimen-title">{outcome.previewTitle}</p><p class="specimen-description">{outcome.previewText}</p><div class="specimen-topics"><span>{zh ? '用户的困难' : 'The problem'}</span><span>{zh ? '实际的成果' : 'The outcome'}</span><span>{zh ? '下一步行动' : 'The next step'}</span></div></div>
            <div class="specimen-bottom"><span>{zh ? '从产品目标，走到可发布的页面' : 'From a product goal to a publishable page'}</span><svg viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" /></svg></div>
          </div>}
          {outcome.id === 'design' && <div class="interface-specimen">
            <div class="interface-sidebar"><svg viewBox="0 0 24 24" fill="none"><path d="M4 4h7v7H4zM15 4h5v5h-5zM4 15h5v5H4zM13 13h7v7h-7z" /></svg><span></span><span></span><span></span></div>
            <div class="interface-body"><p class="interface-small">{zh ? '你的工作空间' : 'Your workspace'}</p><p class="interface-title">{zh ? '手边的项目' : 'Your projects'}</p><div class="interface-project"><span class="project-symbol"></span><div><strong>{zh ? '产品首页' : 'Product homepage'}</strong><p>{zh ? '文案与页面设计' : 'Copy and page design'}</p></div><span class="interface-open">{zh ? '打开' : 'Open'} ↗</span></div><p class="interface-caption">{outcome.previewText}</p></div>
          </div>}
          {outcome.id === 'requirements' && <div class="flow-specimen"><p>{zh ? '第一版，先走通这条路' : 'A first version with a complete journey'}</p><div class="flow-steps">{(zh ? ['提交内容', '得到结果', '保存下来'] : ['Submit', 'Get a result', 'Save it']).map((step, index) => <div><span>{index + 1}</span><strong>{step}</strong></div>)}</div><p class="flow-caption">{zh ? '把精力留给真正需要定制的部分。' : 'Save custom work for the parts that need it.'}</p></div>}
          {outcome.id === 'deployment' && <div class="release-specimen"><svg class="release-symbol" viewBox="0 0 48 48" fill="none"><path d="M24 31V6m-9 9 9-9 9 9M9 28v13h30V28" /></svg><p>{zh ? '发布前，把这些确认清楚' : 'Know what you are releasing'}</p><ul>{(zh ? ['谁能访问这个网址', '关键操作是否正常', '出问题怎样恢复'] : ['Who can access the address', 'Whether the core task works', 'How to recover if needed']).map((item) => <li><span></span>{item}</li>)}</ul></div>}
        </div>
        <figcaption><span>{ui.preview}</span><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" /></svg></figcaption>
      </figure>
      <div class="task-help"><h4>{ui.help}</h4><ol>{outcome.help.map((item) => <li><h5>{item.title}</h5><p>{item.text}</p></li>)}</ol></div>
      <div class="task-delivery"><h4>{ui.deliverables}</h4><ul>{outcome.deliverables.map((item) => <li><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m4 9 3 3 7-7" /></svg>{item}</li>)}</ul></div>
    </article>)}
  </fieldset>
</section>

<style>
  .stage-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
  .stage-heading h2 { font-size: 1rem; letter-spacing: 0; }
  .stage-heading > span { font-size: .7rem; color: var(--muted); }
  fieldset { min-width: 0; border: 0; padding: 0; margin: 0; }
  .task-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); background: #e9ebe3; border-radius: 14px 14px 0 0; overflow: hidden; }
  .task-options label { display: flex; gap: 12px; align-items: center; justify-content: center; padding: 21px 14px; cursor: pointer; font-size: .81rem; font-weight: 600; color: #586052; border-bottom: 2px solid transparent; transition: background .18s, color .18s; }
  .task-options label:hover { background: #dfe3d6; color: var(--ink); }
  .task-options svg { width: 21px; height: 21px; flex: none; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; stroke-linecap: round; }
  .task-stage:has(input[value="growth"]:checked) label[data-choice="growth"], .task-stage:has(input[value="design"]:checked) label[data-choice="design"], .task-stage:has(input[value="requirements"]:checked) label[data-choice="requirements"], .task-stage:has(input[value="deployment"]:checked) label[data-choice="deployment"] { background: var(--panel); color: var(--paper); border-bottom-color: var(--accent); }
  .task-stage:has(input[value="growth"]:focus-visible) label[data-choice="growth"], .task-stage:has(input[value="design"]:focus-visible) label[data-choice="design"], .task-stage:has(input[value="requirements"]:focus-visible) label[data-choice="requirements"], .task-stage:has(input[value="deployment"]:focus-visible) label[data-choice="deployment"] { outline: 3px solid var(--accent); outline-offset: -5px; }
  .task-panel { display: none; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); background: var(--panel); color: var(--paper); border-radius: 0 0 14px 14px; overflow: hidden; }
  .task-stage:has(input[value="growth"]:checked) [data-outcome="growth"], .task-stage:has(input[value="design"]:checked) [data-outcome="design"], .task-stage:has(input[value="requirements"]:checked) [data-outcome="requirements"], .task-stage:has(input[value="deployment"]:checked) [data-outcome="deployment"] { display: grid; }
  .task-context { padding: 40px 40px 32px; align-self: center; }
  .task-goal { font-size: .78rem; line-height: 1.85; color: #d0d8cf; }
  .task-goal > span { display: block; color: #aebcae; font-size: .68rem; margin-bottom: 6px; }
  .task-context h3 { font-size: clamp(1.6rem, 2.4vw, 2.1rem); line-height: 1.35; letter-spacing: -.025em; max-width: 23ch; margin-top: 23px; }
  .task-situation { color: #c0ccc0; font-size: .84rem; line-height: 1.95; margin-top: 18px; max-width: 50ch; }
  .task-start { display: inline-flex; align-items: center; gap: 23px; color: #f4a58a; text-decoration: none; font-weight: 600; font-size: .82rem; margin-top: 24px; padding-block: 5px; }
  .task-start:hover { color: #ffd2bf; }
  .task-start svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .result-preview { margin: 0; padding: 38px 38px 22px 12px; min-width: 0; align-self: center; }
  .result-surface { background: #f8f6ef; color: #283429; min-height: 300px; border-radius: 5px; overflow: hidden; }
  figcaption { display: flex; align-items: center; justify-content: space-between; color: #b8c4b8; font-size: .64rem; padding-top: 12px; }
  figcaption svg { width: 13px; height: 13px; stroke: currentColor; stroke-width: 1; }
  .specimen-navigation { display: flex; align-items: center; justify-content: space-between; padding: 17px 22px; border-bottom: 1px solid #dce0d4; font-size: .55rem; }
  .specimen-navigation > span:first-child { font-weight: 750; font-size: .65rem; }
  .specimen-body { padding: 30px 30px 25px; }
  .specimen-rule { display: block; width: 30px; height: 3px; background: var(--accent); margin-bottom: 15px; }
  .specimen-title { font-size: 1.7rem; line-height: 1.3; font-weight: 650; letter-spacing: -.025em; max-width: 19ch; }
  .specimen-description { color: #68705f; font-size: .7rem; margin-top: 12px; }
  .specimen-topics { display: flex; flex-wrap: wrap; gap: 10px 21px; margin-top: 24px; font-size: .6rem; color: #5b654f; }
  .specimen-topics > span { padding-bottom: 6px; border-bottom: 1px solid #c9cfba; }
  .specimen-bottom { display: flex; justify-content: space-between; align-items: center; background: #e4e9d8; padding: 16px 25px; font-size: .62rem; }
  .specimen-bottom svg { width: 19px; height: 19px; stroke: currentColor; stroke-width: 1.5; }
  .interface-specimen { display: grid; grid-template-columns: 46px 1fr; min-height: 300px; }
  .interface-sidebar { border-right: 1px solid #dce0d4; padding: 18px 12px; display: flex; flex-direction: column; align-items: center; gap: 21px; }
  .interface-sidebar svg { width: 21px; height: 21px; stroke: #4f5b44; stroke-width: 1.3; margin-bottom: 13px; }
  .interface-sidebar > span { width: 12px; height: 2px; background: #aeb79f; }
  .interface-body { padding: 34px 24px; min-width: 0; }
  .interface-small { font-size: .62rem; color: #67705b; }
  .interface-title { font-size: 1.7rem; font-weight: 650; margin-top: 8px; letter-spacing: -.02em; }
  .interface-project { display: flex; align-items: center; gap: 12px; border-block: 1px solid #dce0d4; padding-block: 21px; margin-top: 22px; }
  .project-symbol { width: 24px; height: 30px; border: 1px solid #a7b290; border-radius: 3px; background: #e1e7d5; flex: none; }
  .interface-project strong { font-size: .73rem; font-weight: 600; }
  .interface-project p { font-size: .6rem; color: #67705b; margin-top: 3px; }
  .interface-open { margin-left: auto; background: #344a34; color: #f3f4ea; font-size: .6rem; border-radius: 4px; padding: 7px 9px; white-space: nowrap; }
  .interface-caption { font-size: .63rem; color: #67705b; margin-top: 22px; }
  .flow-specimen { padding: 38px 28px; min-height: 300px; }
  .flow-specimen > p:first-child { font-size: .83rem; font-weight: 600; }
  .flow-steps { display: flex; gap: 15px; margin-top: 30px; position: relative; }
  .flow-steps::before { content: ''; position: absolute; top: 20px; left: 20px; right: 20px; height: 1px; background: #bec8ae; }
  .flow-steps > div { flex: 1; z-index: 1; }
  .flow-steps span { display: grid; place-items: center; width: 40px; height: 40px; background: #e2e8d6; border: 5px solid #f8f6ef; border-radius: 50%; font-size: .68rem; }
  .flow-steps strong { display: block; font-size: .75rem; margin-top: 10px; font-weight: 600; }
  .flow-caption { color: #67705b; font-size: .65rem; border-top: 1px solid #dce0d4; padding-top: 19px; margin-top: 26px; }
  .release-specimen { padding: 29px 34px; }
  .release-symbol { width: 39px; height: 39px; stroke: #6d8057; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .release-specimen > p { font-size: 1.1rem; font-weight: 600; margin-top: 15px; }
  .release-specimen ul { list-style: none; padding: 0; margin-top: 17px; display: grid; gap: 12px; font-size: .7rem; color: #57634b; }
  .release-specimen li { display: flex; align-items: center; gap: 10px; }
  .release-specimen li > span { width: 10px; height: 10px; border: 1px solid #9fac8b; border-radius: 2px; }
  .task-help { grid-column: 1 / -1; padding: 26px 40px 29px; border-top: 1px solid #465346; }
  h4 { margin: 0; font-size: .7rem; font-weight: 500; color: #b8c5b6; }
  .task-help ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; list-style: none; padding: 0; margin-top: 15px; }
  h5 { margin: 0; font-size: .9rem; line-height: 1.6; font-weight: 600; }
  .task-help li > p { color: #b8c5b6; font-size: .82rem; line-height: 1.9; margin-top: 8px; }
  .task-delivery { display: flex; align-items: baseline; gap: 30px; padding: 18px 40px; grid-column: 1 / -1; background: #2d3d30; border-top: 1px solid #465346; }
  .task-delivery h4 { flex: none; }
  .task-delivery ul { display: flex; flex-wrap: wrap; gap: 10px 27px; list-style: none; padding: 0; font-size: .73rem; color: #e6ebdf; }
  .task-delivery li { display: flex; align-items: center; gap: 8px; }
  .task-delivery svg { width: 15px; height: 15px; flex: none; stroke: #b5c99d; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 1100px) {
    .task-options label { gap: 8px; font-size: .73rem; padding-inline: 10px; }
    .task-context { padding: 30px; }
    .result-preview { padding: 30px 28px 23px 0; }
    .specimen-body { padding: 26px 23px; }
    .task-help, .task-delivery { padding-inline: 30px; }
    .task-help ol { gap: 24px; }
    .task-delivery { gap: 20px; }
  }
  @media (max-width: 800px) {
    .task-options { grid-template-columns: 1fr 1fr; }
    .task-options label { padding: 17px 12px; justify-content: start; gap: 10px; font-size: .79rem; }
    .task-panel { grid-template-columns: 1fr; }
    .task-context { padding: 30px 27px 24px; }
    .task-context h3 { font-size: 1.8rem; max-width: 28ch; }
    .result-preview { padding: 0 27px 27px; max-width: 580px; width: 100%; justify-self: center; }
    .task-help { padding: 24px 27px; }
    .task-help ol { grid-template-columns: 1fr; gap: 21px; }
    .task-help li > p { max-width: 65ch; margin-top: 5px; font-size: .8rem; }
    .task-delivery { flex-direction: column; gap: 12px; padding: 21px 27px; }
    .task-delivery ul { gap: 10px 20px; font-size: .75rem; }
    .result-surface { min-height: 275px; }
  }
  @media (max-width: 480px) {
    .stage-heading { gap: 10px; }
    .stage-heading h2 { font-size: .9rem; }
    .stage-heading > span { font-size: .62rem; }
    .task-options label { font-size: .7rem; gap: 8px; padding: 15px 11px; }
    .task-options svg { width: 18px; height: 18px; }
    .task-context { padding: 27px 23px 24px; }
    .task-context h3 { font-size: 1.5rem; margin-top: 18px; }
    .task-goal { font-size: .73rem; }
    .task-situation { font-size: .79rem; }
    .result-preview { padding-inline: 23px; }
    .specimen-navigation { padding: 14px 17px; }
    .specimen-navigation > span:first-child { font-size: .6rem; }
    .specimen-navigation > span:last-child { font-size: .5rem; }
    .specimen-body { padding: 25px 21px; }
    .specimen-title { font-size: 1.4rem; }
    .specimen-description { font-size: .64rem; }
    .specimen-topics { gap: 10px 14px; font-size: .56rem; }
    .specimen-bottom { padding: 15px 20px; font-size: .56rem; gap: 12px; }
    .task-help, .task-delivery { padding-inline: 23px; }
    .interface-specimen { grid-template-columns: 36px 1fr; min-height: 275px; }
    .interface-sidebar { padding-inline: 9px; }
    .interface-body { padding: 28px 15px; }
    .interface-title { font-size: 1.5rem; }
    .interface-project { gap: 8px; }
    .interface-project strong { font-size: .66rem; }
    .interface-project p { font-size: .55rem; }
    .interface-open { font-size: .55rem; padding: 7px; }
    .flow-specimen { min-height: 275px; padding: 31px 22px; }
    .flow-steps { gap: 10px; }
    .flow-steps strong { font-size: .68rem; }
    .release-specimen { padding: 28px; }
    .release-specimen > p { font-size: 1rem; }
  }
</style>
