---
import { PROJECT } from '../data/site';
---
<div class="fold-scene" data-hero-scene aria-hidden="true">
  <canvas data-hero-canvas></canvas>
  <div class="fold-art"><img src={PROJECT.base + 'media/fold/cobalt-fold.webp'} width="1536" height="1024" alt="" fetchpriority="high" decoding="async" /></div>
  <div class="fold-stamp">S<span>V</span>C<span class="stamp-star">✳</span></div>
  <div class="fold-label"><span class="label-rule"></span>THE SHAPE OF YOUR NEXT IDEA</div>
  <span class="fold-coordinate">FIG. 01 / UNFOLD THE POSSIBLE</span>
</div>
<style>
  .fold-scene { position: relative; display: flow-root; min-width: 0; width: 100%; pointer-events: none; isolation: isolate; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
  .fold-art { position: relative; width: 115%; margin-top: -30px; z-index: 2; transform: translate3d(var(--fold-x, 0px), var(--fold-y, 0px), 0) rotate(var(--fold-r, 0deg)); transition: transform 750ms cubic-bezier(.16,1,.3,1); }
  .fold-art img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 62%, transparent 90%); }
  .fold-stamp { position: absolute; right: 5%; top: -55px; width: 93px; height: 93px; border-radius: 50%; border: 1px solid #b43215; background: #f4f1e8; transform: rotate(12deg); display: flex; align-items: center; justify-content: center; gap: 2px; color: #b43215; font: 18px var(--mono); z-index: 3; }
  .fold-stamp > span:first-child { align-self: start; margin-top: 17px; }
  .stamp-star { position: absolute; bottom: 9px; right: 24px; font-size: 22px; }
  .fold-label { position: relative; width: fit-content; margin: -10px 0 0 auto; font: 9px/1.8 var(--mono); letter-spacing: .05em; color: #3447a0; z-index: 3; display: flex; align-items: center; gap: 12px; background: #f4f1e8; padding: 5px; }
  .label-rule { display: inline-block; width: 60px; height: 1px; background: #3447a0; }
  .fold-coordinate { position: absolute; top: 25%; right: -18px; writing-mode: vertical-rl; font: 9px var(--mono); letter-spacing: .08em; color: #3447a0; z-index: 3; }
  @media (max-width: 1100px) { .fold-stamp { width: 75px; height: 75px; font-size: 15px; } .fold-coordinate { display: none; } }
  @media (max-width: 1000px) { .fold-scene { max-width: 800px; justify-self: end; } .fold-art { width: 100%; margin-top: 0; } .fold-stamp { top: 4%; right: 7%; } .fold-label { margin-top: 0; } }
  @media (max-width: 600px) {
    .fold-art { width: 118%; margin-left: -9%; }
    .fold-stamp { width: 59px; height: 59px; top: 4%; right: 4%; font-size: 12px; }
    .fold-stamp > span:first-child { margin-top: 9px; } .stamp-star { right: 13px; bottom: 4px; font-size: 18px; }
    .fold-label { font-size: 7px; } .label-rule { width: 24px; }
  }
  :global(html[data-motion="off"]) .fold-art { transition: none; }
  @media (prefers-reduced-motion: reduce) { .fold-art { transition: none; } }
</style>
<script>
  const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
  const hero = scene?.closest<HTMLElement>('.product-hero');
  const canvas = scene?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const ctx = canvas?.getContext('2d', { alpha: true });
  if (scene && hero && canvas && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    let width = 0, height = 0, frame = 0, last = 0, visible = true, px = 0, py = 0;
    const enabled = () => !reduce.matches && document.documentElement.dataset.motion === 'on' && visible && !document.hidden;
    const paint = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      const phase = enabled() ? time * .00008 : 0;
      const top = width < 700 ? height * .58 : height * .46;
      const left = width < 700 ? -40 : width * .45;
      ctx.strokeStyle = '#263cc11c'; ctx.lineWidth = .7;
      for (let i = 0; i < 8; i++) {
        const y = top + i * 62;
        ctx.beginPath(); ctx.moveTo(left, y); ctx.lineTo(width, y - width * .11); ctx.stroke();
      }
      for (let i = 0; i < 10; i++) {
        const x = left + i * 90;
        ctx.beginPath(); ctx.moveTo(x, top); ctx.lineTo(x + 110, height); ctx.stroke();
      }
      const x = left + ((Math.sin(phase) + 1) / 2) * (width - left);
      const y = top + 90 + Math.cos(phase) * 30;
      ctx.strokeStyle = '#3043b888'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x - 10, y); ctx.lineTo(x + 10, y); ctx.moveTo(x, y - 10); ctx.lineTo(x, y + 10); ctx.stroke();
      ctx.fillStyle = '#b43215';
      ctx.beginPath(); ctx.arc(x, y, 2.2, 0, Math.PI * 2); ctx.fill();
    };
    const loop = (time: number) => {
      if (!enabled()) { frame = 0; return; }
      if (time - last >= 1000 / 30) { paint(time); last = time; }
      frame = requestAnimationFrame(loop);
    };
    const reset = () => {
      px = 0; py = 0;
      scene.style.setProperty('--fold-x', '0px'); scene.style.setProperty('--fold-y', '0px'); scene.style.setProperty('--fold-r', '0deg');
    };
    const sync = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      scene.dataset.sceneState = enabled() ? 'running' : 'static';
      if (enabled()) frame = requestAnimationFrame(loop);
      else { reset(); paint(0); }
    };
    const resize = () => {
      width = scene.clientWidth; height = scene.clientHeight;
      const ratio = Math.min(devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0); paint(0);
    };
    new ResizeObserver(resize).observe(scene);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, { threshold: .01 }).observe(scene);
    hero.addEventListener('pointermove', (event) => {
      if (!fine.matches || !enabled()) return;
      const rect = hero.getBoundingClientRect();
      px = (event.clientX - rect.left) / rect.width * 2 - 1; py = (event.clientY - rect.top) / rect.height * 2 - 1;
      scene.style.setProperty('--fold-x', `${px * 22}px`); scene.style.setProperty('--fold-y', `${py * 14}px`); scene.style.setProperty('--fold-r', `${px * 1.1}deg`);
    }, { passive: true });
    hero.addEventListener('pointerleave', reset);
    document.addEventListener('website-motion-change', sync);
    document.addEventListener('visibilitychange', sync); reduce.addEventListener('change', sync);
    resize(); sync();
  }
</script>
