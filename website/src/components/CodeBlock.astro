---
import { UI, type Locale } from '../data/site';
interface Props { code: string; locale: Locale; label?: string; install?: boolean; }
const { code, locale, label, install = false } = Astro.props;
const ui = UI[locale];
---
<div class:list={['code-block', { 'install-code': install }]} data-install={install || undefined}>
  <div class="code-toolbar">
    <span>{label ?? (install ? ui.terminal : ui.guides.prompt)}</span>
    <button type="button" class="copy-button" data-copy data-copy-label={ui.copy} data-copied-label={ui.copied} data-failed-label={ui.copyFailed} hidden>
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><rect x="7" y="7" width="9" height="10" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M12 4H5a2 2 0 0 0-2 2v7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      <span data-copy-text>{ui.copy}</span>
    </button>
  </div>
  <pre tabindex="0" aria-label={label ?? (install ? ui.installationCommand : ui.guides.prompt)}><code>{code}</code></pre>
  <span class="sr-only" aria-live="polite" data-copy-status></span>
</div>
