---
import { PROJECT, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
---
<figure class="hero-art" data-brand-art aria-label={zh ? '层层展开的朱橙色金属结构，象征专业方法共同支撑产品制作' : 'An ascending assembly of vermilion metal frames, representing professional methods brought together'}>
  <div class="art-register" aria-hidden="true"><span>FIG. 01 / A CONSIDERED PRACTICE</span><span>↗</span></div>
  <div class="art-canvas">
    <img src={PROJECT.base + 'media/method-assembly.webp'} srcset={PROJECT.base + 'media/method-assembly-small.webp 640w, ' + PROJECT.base + 'media/method-assembly.webp 1120w'} sizes="(max-width: 800px) 94vw, 52vw" width="1120" height="1120" alt="" fetchpriority="high" decoding="async" />
  </div>
  <figcaption><span class="art-caption-mark" aria-hidden="true">+</span>{zh ? '品牌概念视觉 · AI 生成的金属结构，非产品界面或执行结果' : 'Concept artwork · AI-generated sculpture, not a product interface or executed result'}</figcaption>
</figure>
<style>
  .hero-art { width: 100%; margin: 0; min-width: 0; position: relative; }
  .art-register { display: flex; justify-content: space-between; align-items: center; position: absolute; top: 1%; left: 12%; right: 0; z-index: 1; font: 8px/1.6 var(--mono); color: #626159; letter-spacing: .07em; }
  .art-register > span:last-child { font-size: 27px; color: #bd3b1c; }
  .art-canvas { width: 114%; margin-left: -6%; aspect-ratio: 1; position: relative; }
  img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 19px 14px #34280e12); }
  figcaption { display: flex; align-items: baseline; gap: 9px; position: relative; margin: -1% 0 0 12%; font-size: 10px; line-height: 1.8; color: #626159; max-width: 48ch; }
  .art-caption-mark { font: 19px var(--mono); color: #bd3b1c; }
  @media (max-width: 1100px) and (min-width: 801px) { .art-canvas { width: 120%; margin-left: -10%; } .art-register { top: -3%; left: 6%; } figcaption { margin-left: 6%; font-size: 9px; } }
  @media (max-width: 800px) { .hero-art { max-width: 560px; margin: 18px auto 0; } .art-canvas { width: 100%; margin: 0; } .art-register { left: 5%; right: 5%; top: 0; } figcaption { margin: 0 5%; } }
  @media (max-width: 480px) { .hero-art { margin-top: 18px; } .art-register { font-size: 6px; } .art-register > span:last-child { font-size: 22px; } figcaption { font-size: 9px; } }
</style>
