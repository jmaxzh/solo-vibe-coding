---
import { OUTCOMES, WORKFLOW_PREVIEWS } from '../data/outcomes';
import { href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
---
<div class="workflow-scenes">
  {OUTCOMES[locale].map((outcome) => {
    const preview = WORKFLOW_PREVIEWS[locale][outcome.id];
    return <article class="workflow-scene task-panel" data-workflow={outcome.id} data-outcome={outcome.id} aria-label={outcome.label}>
      <div class="request-heading"><span>{zh ? '你提出具体需求' : 'You describe the task'}</span><span class="user-avatar" aria-hidden="true">{zh ? '你' : 'You'}</span></div>
      <div class="workflow-request"><span class="skill-mention">$solo-vibe-coding</span><p>{preview.request}</p></div>
      <div class="assistant-heading"><span class="assistant-symbol" aria-hidden="true">✳</span><div><strong>{zh ? '你的编程助手' : 'Your coding assistant'}</strong><small>{zh ? '按任务使用 Solo Vibe Coding 专业指导' : 'Using Solo Vibe Coding guidance for this task'}</small></div></div>
      <div class="task-help"><p>{zh ? '结合现有项目，按这三个方向推进：' : 'Build on your project with these three steps:'}</p><ol>{preview.methods.map((method, index) => <li><span aria-hidden="true">{index + 1}</span><div><strong>{method}</strong></div></li>)}</ol></div>
      <div class="task-delivery"><p class="delivery-label">{zh ? '本次交付与检查目标' : 'Delivery and check goals'}</p><p class="delivery-output">{preview.output}</p><ul>{outcome.checks.map((check) => <li>{check}</li>)}</ul></div>
      <div class="workflow-bottom"><span>{zh ? '保留现有项目 · 交代未验证项' : 'Keep the project · Report unverified work'}</span><a data-task-start={outcome.id} href={href(locale, 'getting-started') + '?task=' + outcome.id + '#task-' + outcome.id}>{zh ? '用这个任务开始' : 'Start with this task'}<span aria-hidden="true">↗</span></a></div>
    </article>;
  })}
</div>

<style>
  .workflow-scenes { min-width: 0; }
  .workflow-scene { display: none; padding: 28px 27px 18px; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 0 26px; }
  :global([data-task-stage]:has(input[value="development"]:checked)) [data-workflow="development"], :global([data-task-stage]:has(input[value="design"]:checked)) [data-workflow="design"], :global([data-task-stage]:has(input[value="deployment"]:checked)) [data-workflow="deployment"], :global([data-task-stage]:has(input[value="growth"]:checked)) [data-workflow="growth"] { display: grid; }
  .request-heading { grid-column: 1; display: flex; align-items: center; justify-content: space-between; color: #c4dacf; font-size: 11px; }
  .user-avatar { color: #edf9f3; font-size: 10px; padding: 3px 7px; border: 1px solid #7d968a; border-radius: 50%; }
  .workflow-request { grid-column: 1; margin: 10px 0 23px; padding: 14px 16px; background: #3954475e; border: 1px solid #6b8d7d; border-radius: 9px; }
  .skill-mention { font: 10px var(--mono); color: #def3e9; }
  .workflow-request p { font-size: 14px; font-weight: 500; line-height: 1.9; margin-top: 6px; color: #f4fbf8; }
  .assistant-heading { grid-column: 1; display: flex; align-items: center; gap: 10px; }
  .assistant-symbol { display: grid; place-items: center; background: #4d6a5c5c; color: #dcf3e8; width: 31px; height: 31px; border: 1px solid #89ac9b; border-radius: 50%; font-size: 22px; flex: none; }
  .assistant-heading strong { display: block; font-size: 13px; color: #f2fbf7; font-weight: 550; }
  .assistant-heading small { display: block; font-size: 10px; color: #c2dbcf; margin-top: 3px; }
  .task-help { grid-column: 1; margin-top: 17px; }
  .task-help > p { color: #c1d7cc; font-size: 11px; line-height: 1.8; }
  .task-help ol { padding: 0; list-style: none; margin-top: 13px; display: grid; gap: 12px; }
  .task-help li { display: flex; align-items: center; gap: 10px; }
  .task-help li > span { display: grid; place-items: center; width: 22px; height: 22px; flex: none; border: 1px solid #799b8b; border-radius: 50%; color: #d9f2e6; font: 10px var(--mono); }
  .task-help strong { display: block; color: #e8f5ef; font-size: 13px; font-weight: 500; line-height: 1.75; }
  .task-delivery { grid-column: 2; grid-row: 1 / 5; display: flex; flex-direction: column; justify-content: center; align-self: stretch; padding: 24px 22px; background: linear-gradient(140deg, #3b28484a, #16202166); border: 1px solid #726080; border-radius: 10px; }
  .delivery-label { font: 10px/1.8 var(--mono); color: #ddcaef; letter-spacing: .03em; }
  .delivery-output { margin-top: 16px; font-size: 20px; line-height: 1.6; color: #e8f1ed; font-weight: 550; letter-spacing: -.03em; }
  .task-delivery ul { padding-left: 17px; margin-top: 21px; font-size: 12px; line-height: 1.95; color: #d1c8d9; display: grid; gap: 12px; }
  .workflow-bottom { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 24px; padding-top: 11px; border-top: 1px solid #4e675b; font-size: 10px; color: #c1dace; }
  .workflow-bottom a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; text-decoration: none; color: #c8ecdb; font-size: 12px; font-weight: 550; }
  .workflow-bottom a:hover { text-decoration: underline; }
  @media (max-width: 1100px) { .workflow-scene { padding: 24px 22px 17px; gap: 0 19px; } .task-delivery { padding: 20px 17px; } .delivery-output { font-size: 18px; } }
  @media (max-width: 600px) {
    .workflow-scene { padding: 19px 15px 13px; grid-template-columns: 1fr; }
    .workflow-request p { font-size: 14px; }
    .task-help strong { font-size: 13px; }
    .assistant-heading small { font-size: 11px; }
    .task-help ol { gap: 13px; }
    .task-delivery { grid-column: 1; grid-row: auto; margin-top: 23px; padding: 20px 18px; }
    .delivery-output { font-size: 18px; margin-top: 10px; }
    .task-delivery ul { font-size: 13px; margin-top: 14px; gap: 10px; }
    .workflow-bottom { flex-wrap: wrap; gap: 0 9px; margin-top: 18px; }
  }
</style>
