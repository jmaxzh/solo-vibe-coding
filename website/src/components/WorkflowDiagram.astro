---
import { OUTCOMES, WORKFLOW_PREVIEWS } from '../data/outcomes';
import { href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
---
<div class="workflow-scenes">
  {OUTCOMES[locale].map((outcome) => {
    const preview = WORKFLOW_PREVIEWS[locale][outcome.id];
    return <article class="workflow-scene task-panel" data-workflow={outcome.id} data-outcome={outcome.id} aria-label={outcome.label}>
      <div class="request-heading"><span>{zh ? '你提出具体需求' : 'You describe the task'}</span><span class="user-avatar" aria-hidden="true">{zh ? '你' : 'You'}</span></div>
      <div class="workflow-request"><span class="skill-mention">$solo-vibe-coding</span><p>{preview.request}</p></div>
      <div class="assistant-heading"><span class="assistant-symbol" aria-hidden="true">✳</span><div><strong>{zh ? '你的编程助手' : 'Your coding assistant'}</strong><small>{zh ? '按任务使用 Solo Vibe Coding 专业指导' : 'Using Solo Vibe Coding guidance for this task'}</small></div></div>
      <div class="task-help"><p>{zh ? '结合现有项目，按这三个方向推进：' : 'Build on your project with these three steps:'}</p><ol>{preview.methods.map((method, index) => <li><span aria-hidden="true">{index + 1}</span><div><strong>{method}</strong></div></li>)}</ol></div>
      <div class="task-delivery"><p class="delivery-label">{zh ? '本次交付与检查目标' : 'Delivery and check goals'}</p><p class="delivery-output">{preview.output}</p><ul>{outcome.checks.map((check) => <li>{check}</li>)}</ul></div>
      <div class="workflow-bottom"><span>{zh ? '保留现有项目 · 交代未验证项' : 'Keep the project · Report unverified work'}</span><a data-task-start={outcome.id} href={href(locale, 'getting-started') + '?task=' + outcome.id + '#task-' + outcome.id}>{zh ? '用这个任务开始' : 'Start with this task'}<span aria-hidden="true">↗</span></a></div>
    </article>;
  })}
</div>

<style>
  .workflow-scenes { min-width: 0; }
  .workflow-scene { display: none; padding: 30px 27px 18px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.05fr); gap: 0 30px; }
  :global([data-task-stage]:has(input[value="development"]:checked)) [data-workflow="development"], :global([data-task-stage]:has(input[value="design"]:checked)) [data-workflow="design"], :global([data-task-stage]:has(input[value="deployment"]:checked)) [data-workflow="deployment"], :global([data-task-stage]:has(input[value="growth"]:checked)) [data-workflow="growth"] { display: grid; }
  .request-heading { grid-column: 1; grid-row: 1; display: flex; align-items: center; justify-content: space-between; color: #3447a0; font-size: 11px; align-self: start; min-height: 38px; }
  .user-avatar { border: 1px solid #949ac0; padding: 3px 7px; color: #3447a0; font-size: 10px; }
  .workflow-request { grid-column: 1; grid-row: 2 / 4; align-self: start; padding: 15px; border: 1px solid #949ac0; background: #ece9dd; margin-top: 12px; }
  .skill-mention { font: 10px var(--mono); color: #182fc4; }
  .workflow-request p { color: #333951; font-size: 14px; line-height: 1.9; margin-top: 10px; }
  .assistant-heading { grid-column: 2; grid-row: 1; display: flex; align-items: center; gap: 10px; }
  .assistant-symbol { display: grid; place-items: center; width: 32px; height: 32px; flex: none; font-size: 24px; background: #182fc4; color: #fffaf0; }
  .assistant-heading strong { display: block; color: #182fc4; font-size: 13px; font-weight: 650; }
  .assistant-heading small { display: block; color: #545972; font-size: 10px; line-height: 1.7; margin-top: 3px; }
  .task-help { grid-column: 2; grid-row: 2 / 4; margin-top: 12px; }
  .task-help > p { color: #545972; font-size: 11px; line-height: 1.9; }
  .task-help ol { list-style: none; padding: 0; display: grid; gap: 18px; margin-top: 18px; }
  .task-help li { display: flex; align-items: start; gap: 10px; }
  .task-help li > span { width: 22px; height: 22px; flex: none; display: grid; place-items: center; font: 10px var(--mono); color: #8e351e; border: 1px solid #b2614a; }
  .task-help strong { display: block; color: #34416f; font-size: 13px; font-weight: 550; line-height: 1.75; }
  .task-delivery { grid-column: 3; grid-row: 1 / 4; padding: 21px; background: #f7d5bc; border: 1px solid #b2614a; }
  .delivery-label { color: #78321f; font: 10px/1.8 var(--mono); }
  .delivery-output { color: #18245d; font-size: 21px; font-weight: 650; line-height: 1.55; margin-top: 16px; letter-spacing: -.035em; }
  .task-delivery ul { display: grid; gap: 12px; margin-top: 20px; padding-left: 16px; color: #4f4550; font-size: 12px; line-height: 1.9; }
  .workflow-bottom { grid-column: 1 / -1; grid-row: 4; display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-top: 12px; margin-top: 27px; border-top: 1px solid #949ac0; color: #545972; font-size: 10px; }
  .workflow-bottom a { display: inline-flex; align-items: center; gap: 15px; min-height: 44px; color: #182fc4; font-size: 12px; text-decoration: none; font-weight: 650; }
  .workflow-bottom a:hover { text-decoration: underline; }
  .workflow-bottom a > span { font-size: 18px; color: #8e351e; }
  @media (max-width: 1000px) { .workflow-scene { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 25px; } .task-delivery { grid-column: 1 / -1; grid-row: 4; margin-top: 26px; } .workflow-bottom { grid-row: 5; } }
  @media (max-width: 600px) { .workflow-scene { padding: 20px 15px 13px; grid-template-columns: 1fr; } .request-heading, .workflow-request, .assistant-heading, .task-help, .task-delivery, .workflow-bottom { grid-column: 1; grid-row: auto; } .workflow-request { margin: 10px 0 24px; } .task-help { margin-top: 17px; } .task-help ol { gap: 14px; } .task-help strong { font-size: 13px; } .assistant-heading small { font-size: 11px; } .task-delivery { margin-top: 25px; padding: 20px 18px; } .delivery-output { font-size: 20px; margin-top: 12px; } .task-delivery ul { font-size: 13px; margin-top: 15px; } .workflow-bottom { flex-wrap: wrap; gap: 0 9px; margin-top: 20px; } }
</style>
