---
import { OUTCOMES, WORKFLOW_PREVIEWS } from '../data/outcomes';
import { href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
---
<div class="workflow-scenes">
  {OUTCOMES[locale].map((outcome) => {
    const preview = WORKFLOW_PREVIEWS[locale][outcome.id];
    return <article class="workflow-scene task-panel" data-workflow={outcome.id} data-outcome={outcome.id} aria-label={outcome.label}>
      <div class="request-heading"><span>{zh ? '你提出具体需求' : 'You describe the task'}</span><span class="user-avatar" aria-hidden="true">{zh ? '你' : 'You'}</span></div>
      <div class="workflow-request"><span class="skill-mention">$solo-vibe-coding</span><p>{preview.request}</p></div>
      <div class="assistant-heading"><span class="assistant-symbol" aria-hidden="true">✳</span><div><strong>{zh ? '你的编程助手' : 'Your coding assistant'}</strong><small>{zh ? '按任务使用 Solo Vibe Coding 专业指导' : 'Using Solo Vibe Coding guidance for this task'}</small></div></div>
      <div class="task-help"><p>{zh ? '结合现有项目，按这三个方向推进：' : 'Build on your project with these three steps:'}</p><ol>{preview.methods.map((method, index) => <li><span aria-hidden="true">{index + 1}</span><div><strong>{method}</strong></div></li>)}</ol></div>
      <div class="task-delivery"><p class="delivery-label">{zh ? '本次交付与检查目标' : 'Delivery and check goals'}</p><p class="delivery-output">{preview.output}</p><ul>{outcome.checks.map((check) => <li>{check}</li>)}</ul></div>
      <div class="workflow-bottom"><span>{zh ? '保留现有项目 · 交代未验证项' : 'Keep the project · Report unverified work'}</span><a data-task-start={outcome.id} href={href(locale, 'getting-started') + '?task=' + outcome.id + '#task-' + outcome.id}>{zh ? '用这个任务开始' : 'Start with this task'}<span aria-hidden="true">↗</span></a></div>
    </article>;
  })}
</div>

<style>
  .workflow-scenes { min-width: 0; }
  .workflow-scene { display: none; padding: 20px 21px 13px; }
  :global([data-task-stage]:has(input[value="development"]:checked)) [data-workflow="development"], :global([data-task-stage]:has(input[value="design"]:checked)) [data-workflow="design"], :global([data-task-stage]:has(input[value="deployment"]:checked)) [data-workflow="deployment"], :global([data-task-stage]:has(input[value="growth"]:checked)) [data-workflow="growth"] { display: block; }
  .request-heading { display: flex; align-items: center; justify-content: space-between; color: #a4b0c1; font-size: 10px; }
  .user-avatar { color: #bcc7d6; font-size: 10px; }
  .workflow-request { margin: 9px 0 20px; padding: 12px 15px; background: #1e2631; border: 1px solid #34404f; border-left: 2px solid #baf19b; border-radius: 0 6px 6px 0; }
  .skill-mention { font: 10px var(--mono); color: #c1f4a7; }
  .workflow-request p { font-size: 13px; font-weight: 500; line-height: 1.85; margin-top: 6px; color: #edf1f6; }
  .assistant-heading { display: flex; align-items: center; gap: 9px; }
  .assistant-symbol { display: grid; place-items: center; background: #2a3826; color: #baf19b; width: 28px; height: 28px; border: 1px solid #4a6240; border-radius: 6px; font-size: 20px; flex: none; }
  .assistant-heading strong { display: block; font-size: 12px; color: #eef1f6; font-weight: 600; }
  .assistant-heading small { display: block; font-size: 10px; color: #a2aec0; margin-top: 2px; }
  .task-help { margin-top: 15px; }
  .task-help > p { color: #a2aec0; font-size: 11px; }
  .task-help ol { padding: 0; list-style: none; margin-top: 11px; display: grid; gap: 9px; }
  .task-help li { display: flex; align-items: center; gap: 10px; }
  .task-help li > span { display: grid; place-items: center; width: 19px; height: 19px; flex: none; border: 1px solid #44523d; border-radius: 4px; color: #b8e59f; font: 9px var(--mono); }
  .task-help strong { display: block; color: #dce3ed; font-size: 12px; font-weight: 500; line-height: 1.7; }
  .task-delivery { margin-top: 17px; padding: 12px 14px; background: #192219; border: 1px solid #3b4c32; border-radius: 6px; }
  .delivery-label { font: 10px/1.7 var(--mono); color: #c5e7b2; letter-spacing: .02em; }
  .delivery-output { margin-top: 4px; font-size: 12px; color: #e8f1e3; font-weight: 550; }
  .task-delivery ul { padding-left: 14px; margin-top: 6px; font-size: 10px; line-height: 1.9; color: #b2c4ab; }
  .workflow-bottom { display: flex; align-items: center; justify-content: space-between; gap: 9px; margin-top: 12px; padding-top: 7px; border-top: 1px solid #2c3541; font-size: 10px; color: #99a8bc; }
  .workflow-bottom a { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; text-decoration: none; color: #c2f0a7; font-size: 11px; font-weight: 550; }
  .workflow-bottom a:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    .workflow-scene { padding: 17px 14px 11px; }
    .workflow-request p { font-size: 13px; }
    .task-help strong { font-size: 13px; }
    .task-help > p, .assistant-heading small { font-size: 11px; }
    .task-help ol { gap: 12px; }
    .delivery-output { font-size: 13px; }
    .task-delivery ul { font-size: 12px; }
    .delivery-label { font-size: 10px; }
    .workflow-bottom { flex-wrap: wrap; gap: 0 6px; }
    .workflow-bottom a { font-size: 12px; }
  }
</style>
