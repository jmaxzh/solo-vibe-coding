---
import { OUTCOMES, WORKFLOW_PREVIEWS } from '../data/outcomes';
import { href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
---
<div class="workflow-scenes">
  {OUTCOMES[locale].map((outcome) => {
    const preview = WORKFLOW_PREVIEWS[locale][outcome.id];
    return <article class="workflow-scene task-panel" data-workflow={outcome.id} data-outcome={outcome.id} aria-label={outcome.label}>
      <div class="request-heading"><span>{zh ? '你提出具体需求' : 'You describe the task'}</span><span class="user-avatar" aria-hidden="true">{zh ? '你' : 'You'}</span></div>
      <div class="workflow-request"><span class="skill-mention">$solo-vibe-coding</span><p>{preview.request}</p></div>
      <div class="assistant-heading"><span class="assistant-symbol" aria-hidden="true">✳</span><div><strong>{zh ? '你的编程助手' : 'Your coding assistant'}</strong><small>{zh ? '按任务使用 Solo Vibe Coding 专业指导' : 'Using Solo Vibe Coding guidance for this task'}</small></div></div>
      <div class="task-help"><p>{zh ? '结合现有项目，按这三个方向推进：' : 'Build on your project with these three steps:'}</p><ol>{preview.methods.map((method, index) => <li><span aria-hidden="true">{index + 1}</span><div><strong>{method}</strong></div></li>)}</ol></div>
      <div class="task-delivery"><p class="delivery-label">{zh ? '本次交付与检查目标' : 'Delivery and check goals'}</p><p class="delivery-output">{preview.output}</p><ul>{outcome.checks.map((check) => <li>{check}</li>)}</ul></div>
      <div class="workflow-bottom"><span>{zh ? '保留现有项目 · 交代未验证项' : 'Keep the project · Report unverified work'}</span><a data-task-start={outcome.id} href={href(locale, 'getting-started') + '?task=' + outcome.id + '#task-' + outcome.id}>{zh ? '用这个任务开始' : 'Start with this task'}<span aria-hidden="true">↗</span></a></div>
    </article>;
  })}
</div>

<style>
  .workflow-scenes { min-width: 0; }
  .workflow-scene { display: none; padding: 24px 32px 20px; }
  :global([data-task-stage]:has(input[value="development"]:checked)) [data-workflow="development"], :global([data-task-stage]:has(input[value="design"]:checked)) [data-workflow="design"], :global([data-task-stage]:has(input[value="deployment"]:checked)) [data-workflow="deployment"], :global([data-task-stage]:has(input[value="growth"]:checked)) [data-workflow="growth"] { display: block; }
  .request-heading { display: flex; align-items: center; justify-content: end; gap: 9px; color: #596b82; font-size: 10px; }
  .user-avatar { display: grid; place-items: center; min-width: 25px; height: 25px; border: 1px solid #dce4ed; border-radius: 50%; background: #f4f7fb; font-size: 9px; }
  .workflow-request { max-width: 540px; margin: 7px 0 23px auto; padding: 13px 17px; background: #f1f5fa; border: 1px solid #e5eaf2; border-radius: 11px 3px 11px 11px; }
  .skill-mention { font: 10px var(--mono); color: #2861a1; }
  .workflow-request p { font-size: 13px; font-weight: 550; line-height: 1.75; margin-top: 4px; }
  .assistant-heading { display: flex; align-items: center; gap: 10px; }
  .assistant-symbol { display: grid; place-items: center; background: #eaf3ff; color: #3379c6; width: 31px; height: 31px; border: 1px solid #d7e6fa; border-radius: 8px; font-size: 22px; }
  .assistant-heading strong { display: block; font-size: 12px; font-weight: 650; }
  .assistant-heading small { display: block; font-size: 10px; color: #596b82; margin-top: 1px; }
  .task-help { margin: 15px 0 0 41px; }
  .task-help > p { color: #596b7f; font-size: 11px; }
  .task-help ol { padding: 0; list-style: none; margin-top: 13px; display: grid; gap: 11px; }
  .task-help li { display: flex; align-items: start; gap: 10px; }
  .task-help li > span { display: grid; place-items: center; width: 20px; height: 20px; flex: none; border: 1px solid #d8e5f6; border-radius: 50%; color: #2765aa; background: #f4f8ff; font: 10px var(--mono); }
  .task-help strong { display: block; font-size: 12px; font-weight: 600; line-height: 1.7; }
  .task-delivery { margin: 19px 0 0 41px; padding: 13px 16px; background: #f7faff; border: 1px solid #dce7f5; border-radius: 8px; }
  .delivery-label { font-size: 10px; color: #4b6e99; }
  .delivery-output { margin-top: 4px; font-size: 12px; font-weight: 600; }
  .task-delivery ul { padding-left: 15px; margin-top: 7px; font-size: 10px; line-height: 1.9; color: #607187; }
  .workflow-bottom { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 19px; padding-top: 13px; border-top: 1px solid #edf0f5; font-size: 10px; color: #596b82; }
  .workflow-bottom a { display: inline-flex; align-items: center; gap: 8px; min-height: 32px; text-decoration: none; color: #225d9d; font-weight: 600; }
  .workflow-bottom a:hover { text-decoration: underline; }
  @media (max-width: 800px) { .workflow-scene { padding: 22px; } .task-help, .task-delivery { margin-left: 0; } }
  @media (max-width: 600px) {
    .workflow-scene { padding: 17px 14px 11px; }
    .workflow-request { margin-bottom: 19px; padding: 11px 13px; }
    .workflow-request p { font-size: 13px; }
    .task-help { margin-top: 14px; }
    .task-help strong { font-size: 13px; }
    .task-help ol { gap: 14px; }
    .task-delivery { padding: 12px; }
    .delivery-output { font-size: 13px; } .task-delivery ul { font-size: 12px; }
    .workflow-bottom { gap: 6px; flex-wrap: wrap; margin-top: 14px; }
    .workflow-bottom a { min-height: 44px; font-size: 12px; }
  }
</style>
