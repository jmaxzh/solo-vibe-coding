---
import DeviceMockup from './DeviceMockup.astro';
import { PROJECT, type Locale } from '../data/site';
interface Props { locale: Locale; kind: 'development' | 'design' | 'deployment' | 'growth'; }
const { locale, kind } = Astro.props;
const zh = locale === 'zh-CN';
const references = {
  development: { source: 'Jitsi Meet', url: 'https://github.com/jitsi/jitsi-meet', image: 'video-call.webp', label: zh ? '视频通话界面参考' : 'Video-call interface reference', alt: zh ? 'Jitsi Meet 官方展示图：电脑与手机上的多人视频通话。这是成品界面参考，不是本 Skill 修复后的实测结果。' : 'Official Jitsi Meet illustration of a video call across desktop and phone. An interface reference, not a repair measured with this skill.' },
  design: { source: 'shadcn/ui', url: 'https://ui.shadcn.com/blocks', image: 'app-mobile.webp', label: zh ? '改造起点示意 · 图中为模板演示数据' : 'Starting-point illustration · template sample data', alt: zh ? '用 shadcn/ui 移动端模板表示已有界面的改造起点。图中数字是模板演示数据，不是本 Skill 的用户或收入。' : 'A shadcn/ui mobile template illustrating the starting point for a redesign. Figures are template sample data, not this skill’s users or revenue.' },
  deployment: { source: 'shadcn/ui', url: 'https://ui.shadcn.com/view/new-york-v4/login-01', image: 'login.webp', label: zh ? '登录界面参考' : 'Sign-in interface reference', alt: zh ? '现成登录界面参考：邮箱、密码及第三方登录入口。并非已经接通数据与部署的本 Skill 成果。' : 'A ready-made sign-in reference with email, password and provider sign-in. Not a measured application release produced with this skill.' },
  growth: { source: 'Impeccable', url: 'https://github.com/pbakaus/impeccable', image: 'design-after.webp', label: zh ? '产品展示页参考' : 'Product landing-page reference', alt: zh ? 'Impeccable 的酒店展示页参考，以具体场景、清楚的介绍和预订入口组织页面。并非本 Skill 的客户案例或获客结果。' : 'An Impeccable hotel landing-page reference with a concrete setting, clear message and booking entry. Not this skill’s customer or acquisition result.' },
};
const reference = references[kind];
---
<div class:list={['task-visual', 'stock-scene-' + kind]} data-case-art role="group" aria-label={reference.label}>
  <div class="stock-stage">
    <span class="stock-overline">{kind === 'design' ? (zh ? '从现有界面开始' : 'START WITH THE EXISTING APP') : (zh ? '界面参考' : 'INTERFACE REFERENCE')}</span>
    {kind === 'development' ? <img class="call-reference" src={PROJECT.base + 'media/' + reference.image} width="1000" height="687" loading="lazy" decoding="async" alt={reference.alt} /> : <div class:list={['device-display', { 'phone-display': kind === 'design' }]}><DeviceMockup src={PROJECT.base + 'media/' + reference.image} alt={reference.alt} model={kind === 'design' ? 'phone' : 'laptop'} /></div>}
  </div>
  <p class="stock-source"><span>{reference.label}</span><a href={reference.url}>{reference.source}<span aria-hidden="true"> ↗</span></a></p>
</div>

<style>
  .task-visual { width: 100%; min-width: 0; }
  .stock-stage { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 1.25; padding: 39px 12px 18px; border-radius: var(--radius-card); background: var(--panel); overflow: hidden;  }
  .stock-overline { position: absolute; top: 18px; left: 20px; font-size: 11px; letter-spacing: .1em; color: #bdcce8; }
  .call-reference { display: block; width: 100%; height: auto; max-height: 100%; object-fit: contain; }
  .device-display { width: 100%;  }
  .phone-display { max-width: 40%;  }
  .stock-scene-design .stock-stage { background: var(--subtle); aspect-ratio: 1.08; }
  .stock-scene-design .stock-overline { color: var(--muted); }
  .stock-scene-deployment .stock-stage { background: var(--subtle); }
  .stock-scene-deployment .stock-overline { color: #4b5a43; }
  .stock-scene-growth .stock-stage { background: var(--panel); }
  .stock-source { display: flex; align-items: start; justify-content: space-between; gap: 10px; color: var(--muted); font-size: 11px; line-height: 1.8; margin-top: 13px; }
  .stock-source > span { max-width: 72%; }
  .stock-source > a { white-space: nowrap; }
  @media (max-width: 480px) { .stock-stage { border-radius: var(--radius-card); padding: 31px 8px 15px; } .stock-scene-design .stock-stage { aspect-ratio: .95; } .stock-overline { font-size: 11px; top: 13px; left: 15px; } .stock-source { font-size: 11px; gap: 7px; } }
</style>
