---
import TaskExplorer from './TaskExplorer.astro';
import CodeBlock from './CodeBlock.astro';
import { PROJECT, UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale];
---
<div class="container">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-context"><span class="context-dot" aria-hidden="true"></span>{ui.hero.context}</p>
      <h1 id="hero-title">{ui.hero.title}</h1>
      <p class="hero-description">{ui.hero.description}</p>
      <div class="hero-actions"><a class="button button-primary" href="#install">{ui.hero.primary}<svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a><a class="text-link" href={PROJECT.repository}>{ui.hero.secondary}</a></div>
      <p class="hero-note"><svg viewBox="0 0 72 28" fill="none" aria-hidden="true"><path d="M2 18c15-14 36-13 43-3 6 10-15 14-15 6 0-7 22-13 38-12m-7-6 8 6-8 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{ui.hero.note}</p>
    </div>
    <TaskExplorer locale={locale} />
  </section>

  <section class="principles-section" aria-labelledby="principles-title">
    <div class="section-heading"><h2 id="principles-title">{ui.home.introTitle}</h2><p>{ui.home.introText}</p></div>
    <div class="principles-grid">{ui.home.principles.map((principle, index) => <div class="principle"><div class={`principle-symbol symbol-${index}`} aria-hidden="true"><i></i><i></i><i></i></div><h3>{principle.title}</h3><p>{principle.text}</p></div>)}</div>
  </section>

  <section class="how-section" aria-labelledby="how-title">
    <div><h2 id="how-title">{ui.home.howTitle}</h2><p>{ui.home.howText}</p></div>
    <ol class="steps">{ui.home.steps.map((step, index) => <li><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol>
  </section>

  <section class="install-section" id="install" aria-labelledby="install-title">
    <div class="install-heading"><div><span class="installation-symbol" aria-hidden="true">$ _</span><h2 id="install-title">{ui.home.installTitle}</h2></div><p>{ui.home.installText}</p></div>
    <CodeBlock code={PROJECT.install} locale={locale} install />
    <a class="text-link" href={href(locale, 'getting-started')}>{ui.home.installLink}<span aria-hidden="true">↗</span></a>
  </section>

  <section class="public-section" aria-labelledby="public-title">
    <div class="public-illustration" aria-hidden="true"><div class="notebook-paper"><div class="notebook-holes"><i></i><i></i><i></i></div><span class="notebook-title">build / learn / share</span><div class="notebook-lines"><span></span><span></span><span></span></div><svg viewBox="0 0 120 48" fill="none"><path d="m4 36 24-20 15 9L67 8l15 12 32-14m-14 0h14v14" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div><div class="notebook-seal">↗</div></div>
    <div><h2 id="public-title">{ui.home.logTitle}</h2><p>{ui.home.logText}</p><a class="text-link" href={href(locale, 'build-log')}>{ui.home.logLink}<span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="faq-section" aria-labelledby="faq-title"><h2 id="faq-title">{ui.home.faqTitle}</h2><div class="faq-list">{ui.home.faq.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
</div>
