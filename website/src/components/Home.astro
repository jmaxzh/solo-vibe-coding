---
import Hero from './Hero.astro';
import TaskStage from './TaskStage.astro';
import HomeInteractions from './HomeInteractions.astro';
import WebsiteMotion from './WebsiteMotion.astro';
import Terminal from './Terminal.astro';
import TaskVisual from './TaskVisual.astro';
import { OUTCOMES, OUTCOME_UI } from '../data/outcomes';
import { UI, PROJECT, SCENARIOS, PAGE_PATHS, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale];
const zh = locale === 'zh-CN';
const copy = zh ? {
  painEyebrow: '从卡住的地方，继续往前', painTitle: '做产品，总有几步不只靠写代码。',
  painText: '把这些任务里的专业方法，补到你已经在用的助手里。',
  community: '公开社区求助场景', source: '原始讨论', start: '从这个任务开始', method: '给助手补上的方法',
  sourceNote: '这些困难来自公开社区讨论，原帖作者并非本 Skill 的客户；这里不代表他们已用 Skill 解决问题。',
  howEyebrow: 'HOW IT WORKS', howTitle: '熟悉的助手，多一套做产品的方法。', howText: '不必换一个地方工作。装好 Skill，回到自己的项目，说明你现在想做的事。',
  steps: [
    {title: '装进你的编程助手', text: '在当前项目安装 Skill。上手指南提供 Codex 与 Claude Code 的安装方式。', link: '查看完整安装指南', target: 'getting-started'},
    {title: '说清这一次的需求', text: '选一份接近你目标的任务需求，补上项目现状、参考和要保留的功能。', link: '浏览任务与需求示例', target: 'guides'},
    {title: '一起推进，检查结果', text: '助手按任务补充专业指导。打开成果试一遍，核对交付目标，再继续修改。', link: '看看实际执行记录', target: PAGE_PATHS['case-study']},
  ],
  evidenceEyebrow: '看得见，也能试一试', evidenceTitle: '从真实记录里了解，从小成果开始。', evidenceText: '实际执行记录与功能示例分开呈现，帮助你判断是否适合自己的项目。',
  caseLabel: '实际执行记录 · 2026.11.13', caseTitle: '给收藏工具加导出，再新开会话继续改。',
  caseText: '同一编程助手，分别直接执行与启用 Skill：比较 CSV 导出、原有功能和后续修改。记录包含结果、成本与限制。', caseLink: '阅读完整记录',
  caseCaption: '实际产物截图 · 启用 Skill 组 · 修订批次第 1 配对 · 示例数据', caseLimit: '维护者的小规模任务比较，尚未进行真实用户研究；不代表普遍效果优势。',
  exampleLabel: '功能示例 · 可以实际操作', exampleTitle: '一个能计算，也能下载的小工具。', exampleText: '输入工时、单价、额外费用与预留比例，试试手机操作和 CSV 明细下载。', exampleLink: '打开报价计算器',
  quoteTitle: '项目报价', quoteSub: '浏览器内计算 · 示例金额', quoteHours: '12 小时 × ¥300', quoteExtras: '额外费用', quoteReserve: '预留 10%', quoteTotal: '报价总额', quoteAmount: '¥3,960.00',
  installEyebrow: '从你的下一项任务开始', installTitle: '让专业方法，进入你的日常开发。', installText: '在项目文件夹中执行安装命令，或让助手按完整指南帮你安装。装好后，继续使用你熟悉的助手。', installLink: '安装并开始使用', installNote: 'Skill 免费 · MIT 许可。编程助手、API 与托管等第三方服务可能另外收费。',
  faqEyebrow: 'FAQ', faqTitle: '开始前，你可能还想知道。', faqText: '先了解适用方式，再带着自己的项目开始。',
  allTasks: '继续探索', guideLink: '全部任务指南', reference: '查看界面参考（非执行结果）',
} : {
  painEyebrow: 'MOVE PAST THE STICKING POINT', painTitle: 'Building a product takes more than code.',
  painText: 'Bring the methods behind these tasks into the assistant you already use.',
  community: 'Public community question', source: 'Original discussion', start: 'Start with this task', method: 'Methods your assistant can draw on',
  sourceNote: 'These problems come from public community discussions. The authors are not customers of this skill, and these are not claims that it solved their problems.',
  howEyebrow: 'HOW IT WORKS', howTitle: 'Your familiar assistant. A considered approach.', howText: 'Stay where you work. Install the skill, open your project and describe the task in front of you.',
  steps: [
    {title: 'Install in your coding assistant', text: 'Add the skill to your current project. The guide covers setup for Codex and Claude Code.', link: 'Read the setup guide', target: 'getting-started'},
    {title: 'Describe this particular task', text: 'Choose a relevant request. Add your project, references and the working features you want to keep.', link: 'Explore tasks and requests', target: 'guides'},
    {title: 'Make progress. Check the result.', text: 'Your assistant draws on guidance for the task. Open the result, check the delivery goals, then keep refining.', link: 'See an actual execution record', target: PAGE_PATHS['case-study']},
  ],
  evidenceEyebrow: 'LOOK CLOSER. TRY SOMETHING.', evidenceTitle: 'Real work to inspect. A small tool to try.', evidenceText: 'Execution evidence and functional examples are shown separately, so you can judge what fits your project.',
  caseLabel: 'Actual execution record · 13 Nov 2026', caseTitle: 'Add bookmark export. Pick up in a fresh session.',
  caseText: 'The same coding assistant, with and without the skill: CSV export, existing features and a follow-up change. Includes results, costs and limits.', caseLink: 'Read the full record',
  caseCaption: 'Actual output · Skill group · Corrected cohort, pair 01 · Example data', caseLimit: 'A small task comparison by the maintainer, not research with real users or evidence of a general advantage.',
  exampleLabel: 'Functional example · Try it yourself', exampleTitle: 'A small tool with a useful, downloadable result.', exampleText: 'Enter hours, rate, extra costs and reserve. Try the mobile experience and download a CSV breakdown.', exampleLink: 'Open the quote calculator',
  quoteTitle: 'Project quote', quoteSub: 'Browser-local calculation · Sample amounts', quoteHours: '12 hours × $50', quoteExtras: 'Extra costs', quoteReserve: 'Reserve 10%', quoteTotal: 'Total quote', quoteAmount: '$660.00',
  installEyebrow: 'START WITH YOUR NEXT TASK', installTitle: 'Put professional methods to work.', installText: 'Run the command in your project folder, or follow the full guide with your assistant. Then keep working in the assistant you know.', installLink: 'Install and get started', installNote: 'The skill is free under MIT. Your coding assistant, APIs, hosting and other services may charge separately.',
  faqEyebrow: 'FAQ', faqTitle: 'A few things before you begin.', faqText: 'Understand how it fits, then start with a project of your own.',
  allTasks: 'KEEP EXPLORING', guideLink: 'All task guides', reference: 'View an interface reference (not an execution result)',
};
const icons = ['M6 8h12M8 4l2 4m6-4-2 4M6 12h12M8 16h8M4 8v4m16-4v4M8 8v8a4 4 0 0 0 8 0V8M12 12v8', 'M4 4h16v16H4zM4 10h16M10 10v10M7 7h.01M10 7h.01', 'M5 16a4 4 0 0 1 0-8 6 6 0 0 1 12-1 4.5 4.5 0 0 1 2 9M12 20V10m-4 4 4-4 4 4', 'M4 20V10m8 10V4m8 16v-7M2 20h20'];
---
<div class="immersive-home">
  <Hero locale={locale} />
  <div class="orbit-ribbon" aria-hidden="true"><div class="ribbon-track">{[0, 1].map(() => <span>DESIGN <i>✳</i> BUILD <i>✳</i> DEBUG <i>✳</i> SHIP <i>✳</i> LAUNCH <i>✳</i></span>)}</div></div>
  <section class="experience-section" aria-labelledby="experience-title">
    <div class="experience-heading"><p class="eyebrow">01 / THE METHOD</p><h2 id="experience-title">{zh ? '专业方法，进入你的工作流。' : 'Professional methods. Your familiar workflow.'}</h2><p>{zh ? '说清需求，按任务用上专业指导，明确这次交付与检查目标。继续在自己的编程助手中做项目。' : 'Describe the task, draw on relevant guidance and set clear delivery and check goals. Keep working in your own coding assistant.'}</p></div>
    <TaskStage locale={locale} />
  </section>

  <section class="pain-section home-section" id="why-skill" aria-labelledby="pain-title">
    <div class="section-intro"><p class="eyebrow">{copy.painEyebrow}</p><h2 id="pain-title">{copy.painTitle}</h2><p>{copy.painText}</p></div>
    <div class="pain-grid">{OUTCOMES[locale].map((outcome, index) => <article class="pain-card" id={'outcome-' + outcome.id}>
      <div class="pain-card-top"><span class="pain-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={icons[index]} /></svg></span><span class="pain-index"><b>0{index + 1}</b><small>{copy.community}</small></span></div>
      <h3>{outcome.pain}</h3><p class="pain-situation">{outcome.situation}</p>
      <div class="pain-methods"><p>{copy.method}</p><ul>{outcome.help.map((method) => <li>{method.title}</li>)}</ul></div>
      <div class="pain-actions"><a class="text-link" href={href(locale, 'getting-started') + '?task=' + outcome.id + '#task-' + outcome.id}>{copy.start}<span aria-hidden="true">↗</span></a><a class="source-link" href={outcome.source.url}>{copy.source}<span aria-hidden="true">↗</span></a></div>
      {outcome.id === 'design' && <details class="interface-reference"><summary>{copy.reference}</summary><TaskVisual locale={locale} kind="design" /></details>}
    </article>)}</div>
    <p class="source-note">{copy.sourceNote}</p>
  </section>

  <section class="home-how home-section" id="how-it-helps" aria-labelledby="how-title">
    <div class="section-intro"><p class="eyebrow">{copy.howEyebrow}</p><h2 id="how-title">{copy.howTitle}</h2><p>{copy.howText}</p></div>
    <ol class="how-steps">{copy.steps.map((step, index) => <li><span class="step-index">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p><a class="text-link" data-home-start={index === 0 || undefined} href={href(locale, step.target)}>{step.link}<span aria-hidden="true">↗</span></a></li>)}</ol>
    <a class="skill-source" href={PROJECT.repository + '/blob/main/skills/solo-vibe-coding/SKILL.md'}>{OUTCOME_UI[locale].skillSource}<span aria-hidden="true"> ↗</span></a>
  </section>

  <section class="evidence-section home-section" aria-labelledby="evidence-title">
    <div class="section-intro"><p class="eyebrow">{copy.evidenceEyebrow}</p><h2 id="evidence-title">{copy.evidenceTitle}</h2><p>{copy.evidenceText}</p></div>
    <div class="evidence-grid">
      <article class="evidence-card">
        <figure class="case-image"><a data-case-link href={href(locale, PAGE_PATHS['case-study'])}><img src={PROJECT.base + 'case-study/bookmarks-round-1.png'} alt={zh ? '收藏工具实际执行产物，显示列表、搜索、筛选和导出按钮' : 'Actual bookmark tool output showing the list, search, filters and export button'} width="1440" height="1000" loading="lazy" /></a><figcaption>{copy.caseCaption}</figcaption></figure>
        <div class="evidence-copy"><p class="content-label">{copy.caseLabel}</p><h3>{copy.caseTitle}</h3><p>{copy.caseText}</p><a class="text-link" data-case-link href={href(locale, PAGE_PATHS['case-study'])}>{copy.caseLink}<span aria-hidden="true">↗</span></a><p class="evidence-limit">{copy.caseLimit}</p></div>
      </article>
      <article class="evidence-card">
        <div class="quote-visual" aria-label={copy.quoteSub}><div class="quote-sheet"><div class="quote-sheet-top"><span class="quote-symbol" aria-hidden="true">↗</span><span>{copy.quoteTitle}<small>{copy.quoteSub}</small></span><span class="quote-file" aria-hidden="true">.csv</span></div><div class="quote-line"><span>{copy.quoteHours}</span><strong>{zh ? '¥3,600.00' : '$600.00'}</strong></div><div class="quote-line"><span>{copy.quoteExtras}</span><strong>{zh ? '¥0.00' : '$0.00'}</strong></div><div class="quote-line"><span>{copy.quoteReserve}</span><strong>{zh ? '¥360.00' : '$60.00'}</strong></div><div class="sample-quote-total"><span>{copy.quoteTotal}</span><strong>{copy.quoteAmount}</strong></div></div></div>
        <div class="evidence-copy"><p class="content-label">{copy.exampleLabel}</p><h3>{copy.exampleTitle}</h3><p>{copy.exampleText}</p><a class="text-link" href={href(locale, PAGE_PATHS.examples)}>{copy.exampleLink}<span aria-hidden="true">↗</span></a></div>
      </article>
    </div>
  </section>

  <section class="install-section" id="install" aria-labelledby="start-title">
    <div class="install-copy"><p class="eyebrow">{copy.installEyebrow}</p><h2 id="start-title">{copy.installTitle}</h2><p>{copy.installText}</p><a class="button button-primary" data-start data-home-start href={href(locale, 'getting-started') + '?task=design#task-design'}>{copy.installLink}<span aria-hidden="true">↗</span></a><p class="install-note">{copy.installNote}</p></div>
    <Terminal locale={locale} animate={false} />
  </section>

  <section class="home-faq home-section" aria-labelledby="faq-title"><div><p class="eyebrow">{copy.faqEyebrow}</p><h2 id="faq-title">{copy.faqTitle}</h2><p class="faq-intro">{copy.faqText}</p></div><div class="faq-list">{ui.home.faq.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>

  <section class="more-tasks" aria-labelledby="scenarios-title"><div><p class="eyebrow" id="scenarios-title">{copy.allTasks}</p><a href={href(locale, 'guides')}>{copy.guideLink} ↗</a></div><div class="scenario-links">{SCENARIOS[locale].map((scenario) => <a id={'task-' + scenario.id} href={href(locale, 'guides', scenario.id)}>{scenario.label}<span aria-hidden="true">↗</span></a>)}</div></section>
  <div class="brand-signature" aria-hidden="true">SOLO VIBE<span>✳</span></div>
</div>
<WebsiteMotion />
<HomeInteractions />

<style>
  .immersive-home { --home-space: 96px; overflow: clip; }
  .home-section, .experience-section, .install-section, .more-tasks { width: min(1280px, calc(100% - 112px)); margin-inline: auto; }
  .home-section { padding-block: var(--home-space); }
  .orbit-ribbon { padding-block: 26px; border-block: 1px solid #31405a; background: #090e17; overflow: hidden; transform: rotate(-2deg) scale(1.03); margin-block: 17px 72px; }
  .ribbon-track { display: flex; width: max-content; }
  .ribbon-track > span { display: flex; align-items: center; gap: 35px; padding-right: 35px; color: #d6e5fb; font-size: clamp(30px, 3.8vw, 56px); font-weight: 550; line-height: 1; letter-spacing: -.055em; white-space: nowrap; }
  .ribbon-track i { color: #fb946c; font-size: 29px; font-style: normal; }
  .experience-section { padding-block: 40px 80px; }
  .experience-heading { display: grid; grid-template-columns: 1.2fr 1fr; gap: 0 80px; align-items: end; margin-bottom: 35px; }
  .experience-heading .eyebrow { grid-column: 1 / -1; }
  .experience-heading h2 { max-width: 26ch; font-size: 40px; }
  .experience-heading > p:last-child { color: #aab9cf; font-size: 14px; line-height: 1.95; max-width: 44ch; justify-self: end; }
  .section-intro { display: grid; grid-template-columns: 1.05fr 1fr; gap: 0 65px; align-items: end; }
  .eyebrow { color: #b8cee9; font: 10px/1.8 var(--mono); letter-spacing: .12em; margin-bottom: 19px; }
  .eyebrow::before { content: ''; display: inline-block; width: 5px; height: 5px; background: #f49b75; border-radius: 50%; margin-right: 10px; vertical-align: middle; }
  .section-intro .eyebrow { grid-column: 1 / -1; }
  h2 { color: #edf2f9; font-size: clamp(30px, 3.2vw, 46px); font-weight: 600; letter-spacing: -.055em; line-height: 1.26; }
  .section-intro h2 { max-width: 24ch; }
  .section-intro > p:last-child { color: #aab9cf; font-size: 14px; line-height: 1.95; max-width: 43ch; justify-self: end; }
  .pain-section { border-top: 1px solid #2e3c51; }
  .pain-grid { display: grid; margin-top: 42px; border-top: 1px solid #384961; }
  .pain-card { display: grid; grid-template-columns: 92px minmax(0, 1.1fr) minmax(0, 1fr); gap: 13px 35px; position: relative; padding: 34px 25px; border-bottom: 1px solid #384961; background: radial-gradient(circle at var(--spot-x, 50%) var(--spot-y, 50%), #263d5b26, transparent 58%); }
  .pain-card-top { display: flex; flex-direction: column; gap: 17px; grid-column: 1; grid-row: 1 / 4; align-items: start; }
  .pain-icon { display: grid; place-items: center; color: #adc9eb; width: 29px; height: 29px; }
  .pain-icon svg { width: 25px; height: 25px; stroke: currentColor; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .pain-index b { display: block; color: #afc4df; font: 30px/1 var(--mono); letter-spacing: -.08em; font-weight: 400; }
  .pain-index small { display: block; color: #9caec8; font-size: 9px; line-height: 1.8; margin-top: 15px; }
  .pain-card h3 { grid-column: 2; color: #f0f4fa; font-size: 27px; line-height: 1.45; font-weight: 550; letter-spacing: -.045em; max-width: 24ch; }
  .pain-situation { grid-column: 2; color: #a8b9d1; font-size: 13px; line-height: 1.95; }
  .pain-methods { grid-column: 3; grid-row: 1 / 3; align-self: center; padding-left: 25px; border-left: 1px solid #34445e; }
  .pain-methods > p { font-size: 10px; color: #9cafd0; }
  .pain-methods ul { display: grid; gap: 12px; list-style: none; padding: 0; margin-top: 17px; }
  .pain-methods li { font-size: 13px; color: #d2dff1; line-height: 1.7; }
  .pain-methods li::before { content: '↗'; color: #f9a47f; margin-right: 10px; }
  .pain-actions { grid-column: 2 / -1; display: flex; flex-wrap: wrap; gap: 8px 23px; align-items: center; margin-top: 5px; }
  .text-link { display: inline-flex; align-items: center; gap: 13px; color: #dceaff; font-size: 12px; text-decoration: none; font-weight: 550; min-height: 44px; }
  .text-link > span { color: #ffae88; transition: transform 200ms ease; }
  .text-link:hover { text-decoration: underline; }
  .text-link:hover > span { transform: translate(3px, -3px); }
  .source-link { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font-size: 10px; color: #adc0dc; text-decoration: none; }
  .source-link:hover { color: #f9ae8d; text-decoration: underline; }
  .source-note { margin-top: 22px; color: #99acc8; font-size: 11px; line-height: 1.9; max-width: 100ch; }
  .interface-reference { grid-column: 2 / -1; border-top: 1px solid #34435b; }
  .interface-reference summary { display: flex; align-items: center; justify-content: space-between; min-height: 44px; color: #b8cbe6; font-size: 10px; cursor: pointer; }
  .interface-reference summary::after { content: '+'; font-size: 18px; }
  .interface-reference[open] summary::after { content: '−'; }
  .home-how { border-top: 1px solid #2e3c51; }
  .how-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; gap: 35px; margin-top: 48px; }
  .how-steps li { position: relative; padding: 0 0 0 0; }
  .step-index { display: block; color: #657f9f; -webkit-text-stroke: 1px #a7c4e7; font: 72px/1 var(--mono); letter-spacing: -.1em; margin-bottom: 24px; }
  .how-steps li::after { content: '↗'; position: absolute; right: 10px; top: 16px; color: #f1a27a; font-size: 27px; }
  .how-steps h3 { font-size: 20px; font-weight: 550; color: #ecf2fa; }
  .how-steps p { margin-top: 13px; color: #aebed4; font-size: 14px; line-height: 1.95; }
  .how-steps a { margin-top: 13px; }
  .skill-source { display: flex; align-items: center; min-height: 44px; width: fit-content; margin-top: 25px; color: #adbfda; font-size: 11px; }
  .evidence-section { border-top: 1px solid #2e3c51; }
  .evidence-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px; margin-top: 40px; align-items: start; }
  .evidence-card { background: #0d1420; border: 1px solid #3c4e67; border-radius: 17px; overflow: hidden; }
  .case-image { margin: 0; padding: 23px 24px 15px; background: linear-gradient(140deg, #25354c, #121c2b); min-height: 315px; }
  .case-image a { display: block; border: 1px solid #7e8da2; border-radius: 7px; overflow: hidden; height: 245px; box-shadow: 0 18px 30px -22px #000c; }
  .case-image img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .case-image figcaption { color: #c2d3eb; font-size: 10px; margin-top: 12px; line-height: 1.7; }
  .evidence-copy { padding: 28px 29px; }
  .content-label { color: #f5ac88; font-size: 10px; }
  .evidence-copy h3 { margin-top: 14px; font-size: 25px; line-height: 1.45; font-weight: 550; color: #eff4fc; }
  .evidence-copy > p:not(.content-label) { color: #aabed8; font-size: 14px; line-height: 1.95; margin-top: 15px; }
  .evidence-copy > .text-link { margin-top: 17px; }
  .evidence-copy > p.evidence-limit { font-size: 11px; color: #a1b7d5; padding-top: 15px; border-top: 1px solid #344761; margin-top: 18px; }
  .quote-visual { display: grid; align-items: center; background: radial-gradient(ellipse at 50% 10%, #395b854f, transparent 75%), #131d2d; padding: 28px 33px; min-height: 315px; overflow: hidden; }
  .quote-sheet { width: 100%; background: linear-gradient(140deg, #293951, #121d2c 75%); border: 1px solid #7193bd80; border-radius: 12px; padding: 23px; transform: rotate(-3deg); box-shadow: 15px 20px 40px #0006; }
  .quote-sheet-top { display: flex; gap: 11px; align-items: center; font-size: 13px; color: #eaf3ff; margin-bottom: 20px; }
  .quote-symbol { display: grid; place-items: center; color: #ffd7c3; font-size: 23px; background: #68432f66; border: 1px solid #bb795b; border-radius: 50%; width: 34px; height: 34px; }
  .quote-sheet-top small { color: #bbd1ee; display: block; font-size: 9px; margin-top: 3px; }
  .quote-file { margin-left: auto; color: #b9cee9; font: 10px var(--mono); }
  .quote-line { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-block: 13px; font-size: 11px; color: #b6c9e5; }
  .quote-line strong { color: #e0ecfd; font-size: 11px; font-weight: 500; }
  .sample-quote-total { display: flex; align-items: center; justify-content: space-between; gap: 10px; border-top: 1px dashed #6684a7; padding-top: 15px; margin-top: 17px; }
  .sample-quote-total > span { font-size: 10px; color: #bbd1ed; }
  .sample-quote-total strong { color: #ffba98; font-size: 27px; line-height: 1.3; font-weight: 650; letter-spacing: -.04em; }
