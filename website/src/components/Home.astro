---
import Hero from './Hero.astro';
import TaskEntries from './TaskEntries.astro';
import DeliveryMethod from './DeliveryMethod.astro';
import HomeInteractions from './HomeInteractions.astro';
import WebsiteMotion from './WebsiteMotion.astro';
import Terminal from './Terminal.astro';
import { UI, PROJECT, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale];
const zh = locale === 'zh-CN';
const copy = zh ? {
  howEyebrow: 'HOW IT WORKS', howTitle: '熟悉的助手，多一套做产品的方法。', howText: '不必换一个地方工作。装好 Skill，回到自己的项目，说明你现在想做的事。',
  steps: [
    {title: '装进你的编程助手', text: '在当前项目安装 Skill。上手指南提供 Codex 与 Claude Code 的安装方式。', link: '查看完整安装指南', target: 'getting-started'},
    {title: '说清这一次的需求', text: '选一份接近你目标的任务需求，补上项目现状、参考和要保留的功能。', link: '浏览任务与需求示例', target: 'guides'},
    {title: '一起推进，检查结果', text: '助手按任务补充专业指导。打开成果试一遍，核对交付目标，再继续修改。', link: '了解工程交付方法', target: '#delivery-method'},
  ],
  installEyebrow: '从你的下一项任务开始', installTitle: '让专业方法，进入你的日常开发。', installText: '在项目文件夹中执行安装命令，或让助手按完整指南帮你安装。装好后，继续使用你熟悉的助手。', installLink: '安装并开始使用', installNote: 'Skill 免费 · MIT 许可。编程助手、API 与托管等第三方服务可能另外收费。',
  faqEyebrow: 'FAQ', faqTitle: '开始前，你可能还想知道。', faqText: '先了解适用方式，再带着自己的项目开始。',
} : {
  howEyebrow: 'HOW IT WORKS', howTitle: 'Your familiar assistant. A considered approach.', howText: 'Stay where you work. Install the skill, open your project and describe the task in front of you.',
  steps: [
    {title: 'Install in your coding assistant', text: 'Add the skill to your current project. The guide covers setup for Codex and Claude Code.', link: 'Read the setup guide', target: 'getting-started'},
    {title: 'Describe this particular task', text: 'Choose a relevant request. Add your project, references and the working features you want to keep.', link: 'Explore tasks and requests', target: 'guides'},
    {title: 'Make progress. Check the result.', text: 'Your assistant draws on guidance for the task. Open the result, check the delivery goals, then keep refining.', link: 'Explore the delivery method', target: '#delivery-method'},
  ],
  installEyebrow: 'START WITH YOUR NEXT TASK', installTitle: 'Put professional methods to work.', installText: 'Run the command in your project folder, or follow the full guide with your assistant. Then keep working in the assistant you know.', installLink: 'Install and get started', installNote: 'The skill is free under MIT. Your coding assistant, APIs, hosting and other services may charge separately.',
  faqEyebrow: 'FAQ', faqTitle: 'A few things before you begin.', faqText: 'Understand how it fits, then start with a project of your own.',
};
---
<div class="immersive-home">
  <Hero locale={locale} />
  <div class="orbit-ribbon" aria-hidden="true"><div class="ribbon-track">{[0, 1].map(() => <span>DESIGN <i>✳</i> BUILD <i>✳</i> DEBUG <i>✳</i> SHIP <i>✳</i> LAUNCH <i>✳</i></span>)}</div></div>
  <TaskEntries locale={locale} />
  <section class="home-how home-section" id="how-it-helps" aria-labelledby="how-title">
    <div class="section-intro"><p class="eyebrow">{copy.howEyebrow}</p><h2 id="how-title">{copy.howTitle}</h2><p>{copy.howText}</p></div>
    <ol class="how-steps">{copy.steps.map((step, index) => <li><span class="step-index">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p><a class="text-link" href={step.target.startsWith('#') ? step.target : href(locale, step.target)}>{step.link}<span aria-hidden="true">↗</span></a></li>)}</ol>
    <div id="delivery-method"><DeliveryMethod locale={locale} /></div>
    <a class="skill-source" href={PROJECT.repository + '/blob/main/skills/solo-vibe-coding/SKILL.md'}>{zh ? '查看 Skill 的专业指导' : 'Explore the skill’s guidance'}<span aria-hidden="true"> ↗</span></a>
  </section>

  <section class="install-section" id="install" aria-labelledby="start-title">
    <div class="install-copy"><p class="eyebrow">{copy.installEyebrow}</p><h2 id="start-title">{copy.installTitle}</h2><p>{copy.installText}</p><a class="button button-primary" data-start href={href(locale, 'getting-started')}>{copy.installLink}<span aria-hidden="true">↗</span></a><p class="install-note">{copy.installNote}</p></div>
    <Terminal locale={locale} animate={false} />
  </section>

  <section class="home-faq home-section" aria-labelledby="faq-title"><div><p class="eyebrow">{copy.faqEyebrow}</p><h2 id="faq-title">{copy.faqTitle}</h2><p class="faq-intro">{copy.faqText}</p></div><div class="faq-list">{ui.home.faq.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}{item.help && <a class="faq-help" href={href(locale, 'getting-started', item.help.section)}>{item.help.label}</a>}</p></details>)}</div></section>

  <div class="brand-signature" aria-hidden="true">SOLO VIBE<span>✳</span></div>
</div>
<WebsiteMotion />
<HomeInteractions />

<style>
  .faq-help { display: block; width: fit-content; color: #ffae88; font-size: .875rem; line-height: 1.8; padding-top: .75rem; min-height: 44px; text-underline-offset: .2em; }
  .immersive-home { --home-space: 96px; overflow: clip; }
  .home-section, .install-section { width: min(1280px, calc(100% - 112px)); margin-inline: auto; }
  .home-section { padding-block: var(--home-space); }
  .orbit-ribbon { padding-block: 26px; border-block: 1px solid #31405a; background: #090e17; overflow: hidden; transform: rotate(-2deg) scale(1.03); margin-block: 17px 72px; }
  .ribbon-track { display: flex; width: max-content; }
  .ribbon-track > span { display: flex; align-items: center; gap: 35px; padding-right: 35px; color: #d6e5fb; font-size: clamp(30px, 3.8vw, 56px); font-weight: 550; line-height: 1; letter-spacing: -.055em; white-space: nowrap; }
  .ribbon-track i { color: #fb946c; font-size: 29px; font-style: normal; }
  .section-intro { display: grid; grid-template-columns: 1.05fr 1fr; gap: 0 65px; align-items: end; }
  .eyebrow { color: #b8cee9; font: 10px/1.8 var(--mono); letter-spacing: .12em; margin-bottom: 19px; }
  .eyebrow::before { content: ''; display: inline-block; width: 5px; height: 5px; background: #f49b75; border-radius: 50%; margin-right: 10px; vertical-align: middle; }
  .section-intro .eyebrow { grid-column: 1 / -1; }
  h2 { color: #edf2f9; font-size: clamp(30px, 3.2vw, 46px); font-weight: 600; letter-spacing: -.055em; line-height: 1.26; }
  .section-intro h2 { max-width: 24ch; }
  .section-intro > p:last-child { color: #aab9cf; font-size: 14px; line-height: 1.95; max-width: 43ch; justify-self: end; }
  .text-link { display: inline-flex; align-items: center; gap: 13px; color: #dceaff; font-size: 12px; text-decoration: none; font-weight: 550; min-height: 44px; }
  .text-link > span { color: #ffae88; transition: transform 200ms ease; }
  .text-link:hover { text-decoration: underline; }
  .text-link:hover > span { transform: translate(3px, -3px); }
  .home-how { border-top: 1px solid #2e3c51; }
  .how-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; gap: 35px; margin-top: 48px; }
  .how-steps li { position: relative; padding: 0 0 0 0; }
  .step-index { display: block; color: #657f9f; -webkit-text-stroke: 1px #a7c4e7; font: 72px/1 var(--mono); letter-spacing: -.1em; margin-bottom: 24px; }
  .how-steps li::after { content: '↗'; position: absolute; right: 10px; top: 16px; color: #f1a27a; font-size: 27px; }
  .how-steps h3 { font-size: 20px; font-weight: 550; color: #ecf2fa; }
  .how-steps p { margin-top: 13px; color: #aebed4; font-size: 14px; line-height: 1.95; }
  .how-steps a { margin-top: 13px; }
  .skill-source { display: flex; align-items: center; min-height: 44px; width: fit-content; margin-top: 25px; color: #adbfda; font-size: 11px; }
  .install-section { display: grid; grid-template-columns: 1.1fr 1fr; gap: 55px; align-items: center; padding: 58px 48px; border: 1px solid #8c6d5f; border-radius: 18px; background: radial-gradient(ellipse at 0 0, #804a2b2e, transparent 55%), radial-gradient(ellipse at 100% 100%, #284e795e, transparent 70%), #101722; color: #edf3fc; margin-top: 12px; box-shadow: inset 0 1px 0 #d7ac8a33; }
  .install-copy h2 { font-size: 43px; color: #f2f4f8; max-width: 17ch; }
  .install-copy > p:not(.eyebrow) { color: #b9c8dc; font-size: 14px; line-height: 1.95; margin-top: 22px; }
  .install-copy .button { margin-top: 26px; min-height: 52px; padding-inline: 22px; background: #f39165; color: #170e08; border: 1px solid #ffc3a0; font-size: 13px; gap: 30px; border-radius: 99px; }
  .install-copy .button:hover { background: #ffb18e; }
  .install-copy > p.install-note { font-size: 11px; margin-top: 18px; }
  .install-section :global(.install-terminal) { --panel: #0b121d; --surface: #fff; border-color: #4a6383; border-radius: 12px; box-shadow: 0 24px 45px -20px #0008; }
  .install-section :global(.install-terminal .copy-button) { min-height: 44px; min-width: 44px; }
  .install-section :global(.install-terminal .code-toolbar) { background: #1b293d; border-color: #4a6383; color: #d5e7ff; }
  .install-section :global(.install-terminal .terminal-caption) { border-color: #4a6383; color: #c4d8f3; }
  .install-section :global(.install-terminal .terminal-comment), .install-section :global(.install-terminal .terminal-next) { color: #c4d8f3; }
  .home-faq { display: grid; grid-template-columns: .8fr 1.2fr; gap: 95px; }
  .home-faq h2 { font-size: 39px; max-width: 14ch; }
  .faq-intro { color: #aebfda; font-size: 14px; line-height: 1.95; margin-top: 22px; max-width: 32ch; }
  .home-faq :global(.faq-list details) { border-color: #3b4d67; }
  .home-faq :global(summary) { font-size: 14px; padding-block: 21px; font-weight: 500; gap: 20px; color: #e4efff; }
  .home-faq :global(summary > span) { color: #e9b69a; font-size: 23px; font-weight: 400; }
  .home-faq :global(details > p) { font-size: 14px; line-height: 1.95; color: #b2c4e1; padding-bottom: 22px; max-width: 58ch; }
  .brand-signature { width: min(1320px, calc(100% - 64px)); margin: 20px auto -15px; display: flex; justify-content: center; gap: 15px; white-space: nowrap; color: #536b89; -webkit-text-stroke: 1px #9ebfe6; font-size: clamp(75px, 14.8vw, 230px); line-height: 1.05; font-weight: 650; letter-spacing: -.085em; overflow: hidden; }
  .brand-signature > span { font-size: .35em; color: #dd936d88; -webkit-text-stroke: 0; margin-top: .2em; }
  :global(html[data-motion="on"]) .ribbon-track { animation: ribbon-drift 28s linear infinite; }
  @keyframes ribbon-drift { to { transform: translateX(-50%); } }
  @media (max-width: 1000px) { .home-section, .install-section { width: calc(100% - 80px); } .section-intro { gap: 0 35px; } .install-section { gap: 30px; padding: 38px 32px; } .home-faq { gap: 45px; } }
  @media (max-width: 800px) {
    .immersive-home { --home-space: 70px; } .home-section, .install-section { width: calc(100% - 48px); }
    .section-intro { grid-template-columns: 1fr; gap: 0; } .section-intro > p:last-child { justify-self: start; max-width: 65ch; margin-top: 18px; } .section-intro h2 { max-width: 27ch; }
    .how-steps { gap: 25px; }
    .install-section { grid-template-columns: 1fr; gap: 33px; } .install-copy h2 { max-width: 22ch; } .home-faq { grid-template-columns: 1fr; gap: 28px; } .home-faq h2 { max-width: none; }
  }
  @media (max-width: 600px) {
    .immersive-home { --home-space: 57px; } .home-section, .install-section { width: calc(100% - 36px); } h2 { font-size: 28px; } .eyebrow { font-size: 9px; margin-bottom: 15px; }
    .orbit-ribbon { padding-block: 20px; margin-block: 10px 38px; } .ribbon-track > span { font-size: 35px; gap: 23px; padding-right: 23px; } .ribbon-track i { font-size: 23px; }
    .section-intro > p:last-child { font-size: 14px; margin-top: 17px; }
    .how-steps { grid-template-columns: 1fr; margin-top: 32px; gap: 28px; } .how-steps li { padding: 5px 0 0 65px; border-top: 1px solid #33465f; padding-top: 21px; } .step-index { position: absolute; left: 0; top: 22px; margin: 0; font-size: 38px; }
    .how-steps li::after { display: none; } .how-steps h3 { font-size: 19px; } .how-steps p { font-size: 14px; margin-top: 10px; } .how-steps a { margin-top: 8px; } .skill-source { font-size: 11px; }
    .install-section { padding: 32px 24px; border-radius: 14px; gap: 29px; } .install-copy h2 { font-size: 32px; } .install-copy > p.install-note { font-size: 11px; }
    .home-faq h2 { font-size: 30px; } .home-faq :global(summary) { font-size: 14px; } .home-faq :global(details > p) { font-size: 14px; }
    .brand-signature { width: calc(100% - 25px); font-size: 16.2vw; margin-block: 10px 0; gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .ribbon-track { animation: none !important; } .text-link > span { transition: none; } }
</style>
