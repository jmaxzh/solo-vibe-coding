---
import Hero from './Hero.astro';
import WebsiteMotion from './WebsiteMotion.astro';
import { OUTCOMES, OUTCOME_UI } from '../data/outcomes';
import { UI, PROJECT, SCENARIOS, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale];
const copy = OUTCOME_UI[locale];
---
<div class="container outcome-home">
  <Hero locale={locale} />

  <section class="how-it-helps" id="how-it-helps" aria-labelledby="mechanism-title">
    <div class="mechanism-introduction"><h2 id="mechanism-title">{copy.mechanismTitle}</h2><div><p>{copy.mechanismText}</p><a class="text-link" href={PROJECT.repository + '/blob/main/skills/solo-vibe-coding/SKILL.md'}>{copy.skillSource}<span aria-hidden="true">↗</span></a></div></div>
    <div class="mechanism-list">{copy.mechanisms.map((item, index) => <div data-reveal-order={index}><svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d={index === 0 ? 'M9 9h22v22H9zM15 15h10M15 20h10M15 25h6' : index === 1 ? 'M7 12h12v12H7zM21 7h12v12H21zM21 23h12v12H21zM12 24v6h9' : 'M8 8h24v24H8zM14 20l4 4 9-10'} /></svg><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>
  </section>

  <section class="real-work" aria-labelledby="evidence-title">
    <div class="evidence-heading"><h2 id="evidence-title">{copy.evidenceTitle}</h2><p>{copy.evidenceText}</p></div>
    <div class="discussion-sources">{OUTCOMES[locale].map((outcome) => <a href={outcome.source.url}><span>{outcome.label}</span><small>{outcome.source.label}</small><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" /></svg></a>)}</div>
  </section>

  <section class="own-task" id="install" aria-labelledby="start-title">
    <div><h2 id="start-title">{ui.home.installTitle}</h2><p>{ui.home.installText}</p><a class="button button-primary" data-start href={href(locale, 'getting-started')}>{ui.home.installLink}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a></div>
    <img src={PROJECT.base + 'art/case-growth-768.webp'} width="768" height="768" loading="lazy" decoding="async" alt="" />
  </section>

  <section class="faq-section" aria-labelledby="faq-title"><h2 id="faq-title">{ui.home.faqTitle}</h2><div class="faq-list">{ui.home.faq.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>

  <section class="more-tasks" aria-labelledby="scenarios-title"><h2 id="scenarios-title">{copy.allTasks}</h2><div class="scenario-links">{SCENARIOS[locale].map((scenario) => <a id={'task-' + scenario.id} href={href(locale, 'guides', scenario.id)}><span>{scenario.label}</span><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>)}</div></section>
</div>
<WebsiteMotion />

<style>
  .how-it-helps { padding-block: 67px 75px; border-top: 1px solid var(--line); }
  .mechanism-introduction { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .mechanism-introduction h2 { max-width: 20ch; font-size: clamp(2rem, 3.1vw, 2.8rem); letter-spacing: -.03em; }
  .mechanism-introduction p { color: var(--muted); font-size: .94rem; line-height: 1.95; max-width: 48ch; }
  .mechanism-introduction a { margin-top: 22px; font-size: .78rem; }
  .mechanism-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 43px; }
  .mechanism-list > div { padding: 30px; border-radius: 16px; background: #e7edff; }
  .mechanism-list > div:nth-child(2) { background: #ffebe3; }
  .mechanism-list > div:nth-child(3) { background: #eaf0d5; }
  .mechanism-list svg { width: 34px; height: 34px; stroke: #304c93; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 25px; }
  .mechanism-list > div:nth-child(2) svg { stroke: #a0472d; }
  .mechanism-list > div:nth-child(3) svg { stroke: #57732b; }
  .mechanism-list h3 { font-size: 1.14rem; letter-spacing: -.02em; }
  .mechanism-list p { color: #4e5a63; font-size: .85rem; line-height: 1.95; margin-top: 12px; }
  .real-work { padding-block: 57px 66px; border-top: 1px solid var(--line); }
  .evidence-heading { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 80px; }
  .evidence-heading h2 { font-size: 2rem; letter-spacing: -.03em; max-width: 24ch; }
  .evidence-heading > p { color: var(--muted); font-size: .84rem; max-width: 54ch; line-height: 1.9; }
  .discussion-sources { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 50px; margin-top: 32px; }
  .discussion-sources a { display: grid; grid-template-columns: 1fr auto; gap: 5px 20px; text-decoration: none; padding-block: 21px; border-top: 1px solid var(--line); }
  .discussion-sources a > span { font-size: .9rem; font-weight: 650; }
  .discussion-sources a > small { color: var(--muted); font-size: .7rem; grid-column: 1; line-height: 1.8; }
  .discussion-sources a > svg { width: 17px; height: 17px; grid-column: 2; grid-row: 1 / 3; align-self: center; stroke: #2457f5; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: transform 160ms var(--ease-out); }
  .discussion-sources a:hover > span { color: #1745d0; }
  .own-task { position: relative; isolation: isolate; display: grid; grid-template-columns: 1.7fr 1fr; align-items: center; gap: 30px; background: #d5f36b; color: #17212e; padding: 42px 48px; border-radius: 22px; margin-block: 5px 65px; overflow: hidden; }
  .own-task > div { position: relative; z-index: 1; }
  .own-task h2 { font-size: clamp(1.9rem, 2.9vw, 2.6rem); letter-spacing: -.025em; max-width: 22ch; }
  .own-task p { color: #455432; font-size: .9rem; line-height: 1.9; margin-top: 19px; max-width: 58ch; }
  .own-task .button { margin-top: 25px; background: #17212e; color: #fffefa; }
  .own-task .button:hover { background: #2a425d; }
  .own-task svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .own-task > img { width: 115%; max-width: none; height: auto; margin-top: -30px; margin-bottom: -50px; }
  .faq-section { padding-bottom: 65px; }
  .more-tasks { padding-block: 38px 65px; border-top: 1px solid var(--line); }
  .more-tasks h2 { font-size: 1.05rem; letter-spacing: 0; }
  .more-tasks .scenario-links { margin-top: 12px; }
  .more-tasks .scenario-links a { font-size: .84rem; font-weight: 500; padding-block: 17px; }
  @media (hover: hover) and (pointer: fine) { .discussion-sources a:hover > svg { transform: translate(2px, -2px); } }
  @media (max-width: 1100px) {
    .mechanism-introduction, .evidence-heading { gap: 45px; }
    .mechanism-list { gap: 15px; }
    .mechanism-list > div { padding: 26px; }
    .own-task { padding: 35px; gap: 20px; }
  }
  @media (max-width: 800px) {
    .how-it-helps { padding-block: 44px 52px; }
    .mechanism-introduction, .evidence-heading { grid-template-columns: 1fr; gap: 23px; }
    .mechanism-introduction h2 { max-width: 25ch; }
    .mechanism-introduction p { max-width: 65ch; }
    .mechanism-list { grid-template-columns: 1fr; gap: 15px; margin-top: 30px; }
    .mechanism-list > div { display: grid; grid-template-columns: 36px 1fr; gap: 0 22px; padding: 28px; }
    .mechanism-list svg { grid-row: span 2; margin: 0; }
    .mechanism-list p { margin-top: 8px; }
    .real-work { padding-block: 44px 50px; }
    .discussion-sources { gap: 0 25px; margin-top: 27px; }
    .own-task { padding: 32px; grid-template-columns: 1.7fr 1fr; gap: 20px; margin-bottom: 45px; }
    .own-task h2 { font-size: 1.8rem; }
    .faq-section { padding-bottom: 45px; }
    .more-tasks { padding-bottom: 48px; }
  }
  @media (max-width: 480px) {
    .mechanism-introduction h2 { font-size: 1.8rem; }
    .mechanism-introduction p { font-size: .88rem; }
    .mechanism-list > div { padding: 25px 22px; gap: 0 18px; }
    .mechanism-list h3 { font-size: 1.05rem; }
    .mechanism-list p { font-size: .8rem; }
    .evidence-heading h2 { font-size: 1.7rem; }
    .discussion-sources { grid-template-columns: 1fr; }
    .own-task { padding: 31px 25px; grid-template-columns: 1fr; border-radius: 18px; }
    .own-task > img { display: none; }
    .own-task p { font-size: .83rem; }
  }
</style>
