---
import QuoteCalculator from './QuoteCalculator.astro';
import { UI, SCENARIOS, href, PAGE_PATHS, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale];
---
<div class="container">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="hero-context"><span class="context-dot" aria-hidden="true"></span>{ui.hero.context}</p><h1 id="hero-title">{ui.hero.title}</h1><p class="hero-description">{ui.hero.description}</p><div class="hero-actions"><a class="button button-primary" data-start href={href(locale, 'getting-started')}>{ui.hero.primary}<svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a><a class="text-link" href={href(locale, PAGE_PATHS.examples)}>{ui.hero.secondary}</a></div><p class="hero-note">{ui.hero.note}</p></div>
    <div class="hero-example"><p class="example-request-bubble">{ui.hero.request}</p><QuoteCalculator locale={locale} compact id="home-quote" /><p class="example-caption">{ui.hero.example}</p></div>
  </section>

  <section class="principles-section" aria-labelledby="principles-title"><div class="section-heading"><h2 id="principles-title">{ui.home.introTitle}</h2><p>{ui.home.introText}</p></div><div class="principles-grid">{ui.home.principles.map((principle, index) => <div class="principle"><div class={`principle-symbol symbol-${index}`} aria-hidden="true"><i></i><i></i><i></i></div><h3>{principle.title}</h3><p>{principle.text}</p></div>)}</div></section>

  <section class="home-scenarios" aria-labelledby="scenarios-title"><div class="section-heading"><h2 id="scenarios-title">{ui.guides.title}</h2><p>{ui.guides.intro}</p></div><div class="scenario-links">{SCENARIOS[locale].map((scenario) => <a id={`task-${scenario.id}`} href={href(locale, 'guides', scenario.id)}><span>{scenario.label}</span><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>)}</div></section>

  <section class="how-section" aria-labelledby="how-title"><div><h2 id="how-title">{ui.home.howTitle}</h2><p>{ui.home.howText}</p></div><ol class="steps">{ui.home.steps.map((step, index) => <li><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></section>

  <section class="start-section" id="install" aria-labelledby="start-title"><div><h2 id="start-title">{ui.home.installTitle}</h2><p>{ui.home.installText}</p></div><a class="button button-primary" data-start href={href(locale, 'getting-started')}>{ui.home.installLink}<span aria-hidden="true">↗</span></a></section>

  <section class="faq-section" aria-labelledby="faq-title"><h2 id="faq-title">{ui.home.faqTitle}</h2><div class="faq-list">{ui.home.faq.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
</div>
