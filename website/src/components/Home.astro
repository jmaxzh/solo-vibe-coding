---
import Hero from './Hero.astro';
import { POSITIONING } from '../data/positioning';
import { UI, PROJECT, SCENARIOS, href, PAGE_PATHS, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale];
const positioning = POSITIONING[locale];
---
<div class="container">
  <Hero locale={locale} />

  <section class="skill-methods" id="why-skill" aria-labelledby="methods-title"><div class="section-heading"><div><p class="section-eyebrow">{positioning.methodsLabel}</p><h2 id="methods-title">{ui.home.introTitle}</h2></div><p>{ui.home.introText}</p></div><div class="method-list">{positioning.methods.map((method, index) => <div class="method-item"><span class="method-number" aria-hidden="true">0{index + 1}</span><div><h3>{method.title}</h3><p class="method-need">{method.need}</p></div><p class="method-detail">{method.detail}</p></div>)}</div><div class="method-source"><p>{positioning.sourceNote}</p><a href={PROJECT.repository + '/blob/main/skills/solo-vibe-coding/SKILL.md'}>{positioning.source}<span aria-hidden="true">↗</span></a></div></section>

  <section class="case-invitation" aria-labelledby="case-title"><div><p class="section-eyebrow">{positioning.preview.label}</p><h2 id="case-title">{positioning.evidenceTitle}</h2><p>{positioning.evidenceText}</p></div><a class="button button-primary" data-case-link href={href(locale, PAGE_PATHS['case-study'])}>{positioning.preview.open}<span aria-hidden="true">↗</span></a></section>

  <section class="home-scenarios" aria-labelledby="scenarios-title"><div class="section-heading"><h2 id="scenarios-title">{ui.guides.title}</h2><p>{ui.guides.intro}</p></div><div class="scenario-links">{SCENARIOS[locale].map((scenario) => <a id={`task-${scenario.id}`} href={href(locale, 'guides', scenario.id)}><span>{scenario.label}</span><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>)}</div></section>

  <section class="how-section" aria-labelledby="how-title"><div><h2 id="how-title">{ui.home.howTitle}</h2><p>{ui.home.howText}</p></div><ol class="steps">{ui.home.steps.map((step, index) => <li><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></section>

  <section class="start-section" id="install" aria-labelledby="start-title"><div><h2 id="start-title">{ui.home.installTitle}</h2><p>{ui.home.installText}</p></div><a class="button button-primary" data-start href={href(locale, 'getting-started')}>{ui.home.installLink}<span aria-hidden="true">↗</span></a></section>

  <section class="faq-section" aria-labelledby="faq-title"><h2 id="faq-title">{ui.home.faqTitle}</h2><div class="faq-list">{ui.home.faq.map((item, index) => <details open={index === 2}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>

  <section class="secondary-example"><div><h2>{positioning.exampleTitle}</h2><p>{positioning.exampleText}</p></div><a class="text-link" href={href(locale, PAGE_PATHS.examples)}>{positioning.exampleLink}<span aria-hidden="true">↗</span></a></section>
</div>
