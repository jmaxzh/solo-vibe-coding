<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]')];
  let paused = false;
  try { paused = localStorage.getItem('solo-vibe-motion') === 'off'; } catch { /* The preference is optional. */ }
  const synchronize = () => {
    const enabled = !reduced.matches && !paused;
    root.dataset.motion = enabled ? 'on' : 'off';
    for (const button of buttons) {
      button.hidden = false;
      button.disabled = reduced.matches;
      const label = button.querySelector('[data-motion-label]');
      if (label) label.textContent = (reduced.matches ? button.dataset.reduced : enabled ? button.dataset.pause : button.dataset.play) ?? '';
    }
    document.dispatchEvent(new Event('website-motion-change'));
  };
  synchronize();
  reduced.addEventListener('change', synchronize);
  for (const button of buttons) button.addEventListener('click', () => {
    paused = !paused;
    try { localStorage.setItem('solo-vibe-motion', paused ? 'off' : 'on'); } catch { /* This page still works without storage. */ }
    synchronize();
  });
</script>

<style>
  :global(html[data-motion="on"] [data-title-line]) { animation: page-rise 600ms var(--ease-out) both; }
  :global(html[data-motion="on"] [data-title-line] + [data-title-line]) { animation-delay: 70ms; }
  :global(html[data-motion="on"] [data-art-transform]) { animation: page-rise 650ms var(--ease-out) both; }
  :global(html[data-motion="on"] .task-panel) { animation: case-enter 240ms var(--ease-out) both; }
  @keyframes page-rise { from { transform: translateY(16px); } to { transform: none; } }
  @keyframes case-enter { from { transform: translateY(8px); } to { transform: none; } }
  @supports (animation-timeline: view()) {
    :global(html[data-motion="on"] [data-reveal-order]) { animation: reference-enter linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
    @keyframes reference-enter { from { transform: translateY(20px); } to { transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) { :global([data-title-line]), :global([data-art-transform]), :global(.task-panel), :global([data-reveal-order]) { animation: none !important; } }
</style>
