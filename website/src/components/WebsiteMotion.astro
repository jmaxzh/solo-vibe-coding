<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]')];
  const running = new Set<Animation>();
  let paused = false;
  let keyboard = false;
  try { paused = localStorage.getItem('solo-vibe-motion') === 'off'; } catch { /* The preference is optional. */ }
  const enabled = () => !reduced.matches && !paused;
  const synchronize = () => {
    root.dataset.motion = enabled() ? 'on' : 'off';
    for (const button of buttons) {
      button.hidden = false;
      button.disabled = reduced.matches;
      const label = button.querySelector('[data-motion-label]');
      if (label) label.textContent = (reduced.matches ? button.dataset.reduced : enabled() ? button.dataset.pause : button.dataset.play) ?? '';
    }
    if (!enabled()) {
      for (const animation of running) animation.cancel();
      running.clear();
      document.querySelector<HTMLElement>('[data-art-transform]')?.style.removeProperty('transform');
    }
  };
  const animate = (element: Element, frames: Keyframe[], duration: number, delay = 0) => {
    if (!enabled() || !('animate' in element)) return;
    const animation = element.animate(frames, { duration, delay, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
    running.add(animation);
    animation.addEventListener('finish', () => running.delete(animation), { once: true });
    animation.addEventListener('cancel', () => running.delete(animation), { once: true });
  };
  synchronize();
  reduced.addEventListener('change', synchronize);
  for (const button of buttons) button.addEventListener('click', () => {
    paused = !paused;
    try { localStorage.setItem('solo-vibe-motion', paused ? 'off' : 'on'); } catch { /* This page still works without storage. */ }
    synchronize();
  });
  document.addEventListener('keydown', () => { keyboard = true; });
  document.addEventListener('pointerdown', () => { keyboard = false; }, { passive: true });
  document.querySelectorAll('[data-title-line]').forEach((line, index) => animate(line, [{ opacity: .65, transform: 'translateY(16px)' }, { opacity: 1, transform: 'translateY(0)' }], 650, index * 70));
  const sculpture = document.querySelector('[data-art-transform]');
  if (sculpture) animate(sculpture, [{ opacity: .3, transform: 'translateY(32px) rotate(-5deg) scale(.95)' }, { opacity: 1, transform: 'none' }], 900, 60);
  const artArea = document.querySelector<HTMLElement>('[data-hero-tilt]');
  const art = document.querySelector<HTMLElement>('[data-art-transform]');
  if (artArea && art) {
    artArea.addEventListener('pointermove', (event) => {
      if (!enabled() || !finePointer.matches || event.pointerType === 'touch') return;
      const bounds = artArea.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - .5;
      const y = (event.clientY - bounds.top) / bounds.height - .5;
      art.style.transform = `perspective(1000px) rotateX(${-y * 7}deg) rotateY(${x * 9}deg) translate3d(${x * 9}px, ${y * 7}px, 0)`;
    }, { passive: true });
    artArea.addEventListener('pointerleave', () => art.style.removeProperty('transform'));
  }
  for (const stage of document.querySelectorAll('[data-task-stage]')) stage.addEventListener('change', (event) => {
    const input = event.target;
    if (keyboard || !(input instanceof HTMLInputElement)) return;
    for (const animation of running) if (animation.effect instanceof KeyframeEffect && animation.effect.target?.matches('[data-case-art]')) animation.cancel();
    const image = stage.querySelector(`[data-outcome="${input.value}"] [data-case-art]`);
    if (image) animate(image, [{ opacity: .65, transform: 'translateY(12px) scale(.96)' }, { opacity: 1, transform: 'none' }], 260);
  });
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) {
        animate(entry.target, [{ opacity: .55, transform: 'translateX(18px)' }, { opacity: 1, transform: 'none' }], 550, Number((entry.target as HTMLElement).dataset.revealOrder ?? 0) * 60);
        observer.unobserve(entry.target);
      }
    }, { threshold: .16 });
    document.querySelectorAll('[data-reveal-order]').forEach((element) => observer.observe(element));
  }
</script>
