---
import { PROJECT } from '../data/site';
---
<div class="orbit-scene" data-orbit-scene aria-hidden="true">
  <canvas data-orbit-canvas></canvas>
  <div class="orbit-art"><img src={PROJECT.base + 'media/orbit/chrome-orbit.webp'} width="1536" height="1024" alt="" fetchpriority="high" decoding="async" /></div>
  <div class="scene-shade"></div>
  <div class="orbit-label label-design"><i></i><span>01 / DESIGN</span></div>
  <div class="orbit-label label-build"><i></i><span>02 / BUILD</span></div>
  <div class="orbit-label label-ship"><i></i><span>03 / SHIP</span></div>
  <div class="orbit-cross cross-one">+</div><div class="orbit-cross cross-two">+</div>
</div>

<style>
  .orbit-scene { position: absolute; inset: 0; pointer-events: none; overflow: hidden; isolation: isolate; background: #05070b; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; opacity: .7; }
  .orbit-art { position: absolute; width: min(119vw, 1770px); right: -18%; top: -3%; transform: translate3d(var(--orbit-x, 0px), var(--orbit-y, 0px), 0) rotate(var(--orbit-r, 0deg)); transform-origin: 66% 50%; mix-blend-mode: screen; transition: transform 750ms cubic-bezier(.16,1,.3,1); }
  .orbit-art img { display: block; width: 100%; height: auto; }
  .scene-shade { position: absolute; inset: 0; z-index: 3; background: linear-gradient(90deg, #05070bf5 0%, #05070bd9 25%, #05070b82 48%, #05070b0a 76%), linear-gradient(0deg, #05070b 0%, #05070b00 18%, #05070b00 86%, #05070b80 100%); }
  .orbit-label { position: absolute; z-index: 4; display: flex; align-items: center; gap: 9px; color: #d8e7fa; font: 9px/1.5 var(--mono); letter-spacing: .12em; padding: 9px 12px; border: 1px solid #c4ddff40; border-radius: 99px; background: #071323c9; backdrop-filter: blur(10px); }
  .orbit-label i { width: 4px; height: 4px; border-radius: 50%; background: #a5d6ff; box-shadow: 0 0 12px #72bfff; }
  .label-design { top: 22%; right: 12%; }
  .label-build { top: 60%; right: 3.5%; }
  .label-ship { top: 78%; right: 31%; }
  .label-ship i { background: #ffa57e; box-shadow: 0 0 12px #ff834d; }
  .orbit-cross { position: absolute; z-index: 4; color: #a3c7f27a; font: 22px var(--mono); }
  .cross-one { top: 18%; right: 31%; } .cross-two { bottom: 10%; right: 14%; }
  @media (max-width: 1000px) { .orbit-art { width: 1420px; right: -45%; top: 1%; } .label-design { right: 9%; } .scene-shade { background: linear-gradient(90deg, #05070bf7 0%, #05070bb8 40%, #05070b28 80%), linear-gradient(0deg, #05070b, transparent 20%); } }
  @media (max-width: 700px) {
    .orbit-art { width: 850px; right: -235px; top: auto; bottom: -85px; }
    .scene-shade { background: linear-gradient(180deg, #05070b 0%, #05070bf7 31%, #05070b3d 56%, #05070b00 78%, #05070b 100%); }
    canvas { opacity: .55; }
    .label-design { top: auto; bottom: 33%; right: 5%; font-size: 8px; }
    .label-build { top: auto; bottom: 15%; right: 6%; font-size: 8px; }
    .label-ship { top: auto; bottom: 5%; right: 57%; font-size: 8px; }
    .cross-one { top: auto; bottom: 42%; right: 17%; } .cross-two { display: none; }
  }
  :global(html[data-motion="off"]) .orbit-art { transition: none; }
  @media (prefers-reduced-motion: reduce) { .orbit-art { transition: none; } }
</style>

<script>
  const scene = document.querySelector<HTMLElement>('[data-orbit-scene]');
  const hero = scene?.closest<HTMLElement>('.product-hero');
  const canvas = scene?.querySelector<HTMLCanvasElement>('[data-orbit-canvas]');
  const ctx = canvas?.getContext('2d', { alpha: true });
  if (scene && hero && canvas && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    let width = 0, height = 0, frame = 0, last = 0, visible = true, px = 0, py = 0;
    const enabled = () => !reduce.matches && document.documentElement.dataset.motion === 'on' && visible && !document.hidden;
    const paint = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      const count = width < 700 ? 64 : 140;
      const drift = enabled() ? time * .000012 : 0;
      for (let i = 0; i < count; i++) {
        const z = (i % 13) / 13;
        const x = (((Math.sin(i * 127.1) * 43758.5453) % 1 + 1 + drift * (.15 + z)) % 1) * width + px * z * 15;
        const y = (((Math.sin(i * 311.7) * 9621.912) % 1 + 1) % 1) * height + py * z * 12;
        ctx.fillStyle = `rgba(175, 209, 255, ${.14 + z * .38})`;
        ctx.beginPath(); ctx.arc(x, y, .35 + z * .75, 0, Math.PI * 2); ctx.fill();
      }
      ctx.save();
      ctx.translate(width * .71 + px * 12, height * .52 + py * 9);
      ctx.rotate(-.44 + px * .025);
      const rx = width * (width < 700 ? .69 : .32), ry = height * .21;
      const gradient = ctx.createLinearGradient(-rx, 0, rx, 0);
      gradient.addColorStop(0, '#6db9ff00'); gradient.addColorStop(.4, '#6db9ff70'); gradient.addColorStop(.8, '#d7eaff85'); gradient.addColorStop(1, '#ff9c6f00');
      ctx.strokeStyle = gradient; ctx.lineWidth = .7;
      ctx.beginPath(); ctx.ellipse(0, 0, rx, ry, 0, 0, Math.PI * 2); ctx.stroke();
      ctx.setLineDash([2, 11]); ctx.strokeStyle = '#9fcbff2e';
      ctx.beginPath(); ctx.ellipse(0, 0, rx * 1.11, ry * 1.11, .07, 0, Math.PI * 2); ctx.stroke();
      ctx.setLineDash([]);
      const angle = drift * 9 + .4;
      for (let i = 0; i < 3; i++) {
        const t = angle + i * 2.094;
        ctx.fillStyle = i === 2 ? '#ffb491' : '#e2f2ff';
        ctx.shadowColor = i === 2 ? '#ff804a' : '#8ac7ff'; ctx.shadowBlur = 14;
        ctx.beginPath(); ctx.arc(Math.cos(t) * rx, Math.sin(t) * ry, i === 0 ? 2.5 : 1.6, 0, Math.PI * 2); ctx.fill();
      }
      ctx.restore();
    };
    const loop = (time: number) => {
      if (!enabled()) { frame = 0; return; }
      if (time - last >= 1000 / 30) { paint(time); last = time; }
      frame = requestAnimationFrame(loop);
    };
    const reset = () => {
      px = 0; py = 0;
      scene.style.setProperty('--orbit-x', '0px'); scene.style.setProperty('--orbit-y', '0px'); scene.style.setProperty('--orbit-r', '0deg');
    };
    const sync = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      scene.dataset.sceneState = enabled() ? 'running' : 'static';
      if (enabled()) frame = requestAnimationFrame(loop);
      else { reset(); paint(0); }
    };
    const resize = () => {
      width = scene.clientWidth; height = scene.clientHeight;
      const ratio = Math.min(devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0); paint(0);
    };
    new ResizeObserver(resize).observe(scene);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, { threshold: .01 }).observe(scene);
    hero.addEventListener('pointermove', (event) => {
      if (!fine.matches || !enabled()) return;
      const rect = hero.getBoundingClientRect();
      px = (event.clientX - rect.left) / rect.width * 2 - 1; py = (event.clientY - rect.top) / rect.height * 2 - 1;
      scene.style.setProperty('--orbit-x', `${px * 22}px`); scene.style.setProperty('--orbit-y', `${py * 14}px`); scene.style.setProperty('--orbit-r', `${px * 1.1}deg`);
    }, { passive: true });
    hero.addEventListener('pointerleave', reset);
    document.addEventListener('website-motion-change', sync);
    document.addEventListener('visibilitychange', sync); reduce.addEventListener('change', sync);
    resize(); sync();
  }
</script>
