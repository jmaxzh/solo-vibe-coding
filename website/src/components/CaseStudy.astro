---
import CodeBlock from './CodeBlock.astro';
import { CASE_STUDY } from '../data/case-study';
import { CASE_EVIDENCE } from '../data/case-evidence';
import { PROJECT, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = CASE_STUDY[locale];
if (!CASE_EVIDENCE.available) throw new Error('Complete and review the actual case evidence before publishing.');
---
<article class="container case-study-shell" data-case-study>
  <header class="page-intro"><p class="page-context"><time datetime={CASE_EVIDENCE.date}>{ui.label}</time></p><h1>{ui.title}</h1><p>{ui.intro}</p></header>
  <p class="case-result-summary" data-case-summary>{CASE_EVIDENCE.summary[locale]}</p>

  <section class="case-round" aria-labelledby="round-one-title"><div class="case-round-copy"><h2 id="round-one-title">{ui.roundOne}</h2><p>{ui.roundOneText}</p><details class="case-request"><summary>{ui.requestLabel}</summary><blockquote>{ui.request}</blockquote><p>{ui.requestNote}</p></details></div><figure class="case-screenshot"><img src={PROJECT.base + 'case-study/bookmarks-round-1.png'} alt={ui.imageOneAlt} width="1280" height="900" loading="lazy" /><figcaption>{ui.imageCaption}</figcaption></figure></section>

  <section class="case-round" aria-labelledby="round-two-title"><div class="case-round-copy"><h2 id="round-two-title">{ui.roundTwo}</h2><p>{ui.roundTwoText}</p><blockquote class="case-next-request">{ui.roundTwoRequest}</blockquote></div><figure class="case-screenshot"><img src={PROJECT.base + 'case-study/bookmarks-round-2.png'} alt={ui.imageTwoAlt} width="1280" height="900" loading="lazy" /><figcaption>{ui.imageCaption}</figcaption></figure></section>

  <section class="case-findings" aria-labelledby="findings-title"><h2 id="findings-title">{ui.appliedTitle}</h2><p class="case-cost">{ui.appliedNote}</p><div class="case-finding-list">{CASE_EVIDENCE.findings.map((finding, index) => <div class="case-finding"><span class="method-number" aria-hidden="true">0{index + 1}</span><div><h3>{finding.title[locale]}</h3><p>{finding.fact[locale]}</p><p class="case-relevance">{finding.relevance[locale]}</p></div></div>)}</div></section>

  <section class="case-comparison" aria-labelledby="results-title"><h2 id="results-title">{ui.resultTitle}</h2><div class="case-table-container"><table data-case-results><thead><tr><th scope="col">{locale === 'en' ? 'Observation' : '观察项目'}</th><th scope="col">{ui.baseline}</th><th scope="col">{ui.withSkill}</th></tr></thead><tbody>{CASE_EVIDENCE.results.map((result) => <tr><th scope="row">{result.label[locale]}</th><td>{result.baseline[locale]}</td><td>{result.withSkill[locale]}</td></tr>)}</tbody></table></div><p class="case-cost" data-case-cost>{CASE_EVIDENCE.cost[locale]}</p><p class="case-pilot" data-case-pilot>{CASE_EVIDENCE.pilot[locale]}</p>
    <details class="case-method"><summary>{ui.methodTitle}</summary><p>{ui.methodText}</p><p>{CASE_EVIDENCE.scope[locale]}</p><p><span>{locale === 'en' ? 'Experiment configuration: ' : '实验配置：'}</span>{CASE_EVIDENCE.agent}</p><p>{locale === 'en' ? 'Original guidance read in the pictured task:' : '画面所示任务实际读取的原始指导：'}</p><div class="resource-links">{CASE_EVIDENCE.guidanceSources.map((source) => <a href={source.url}>{source.label}<span aria-hidden="true"> ↗</span></a>)}</div></details>
    <div class="case-limit"><h3>{ui.limitsTitle}</h3><p>{ui.limitsText}</p></div>
  </section>

  <section class="case-try" aria-labelledby="try-title"><div><h2 id="try-title">{ui.tryTitle}</h2><p>{ui.tryText}</p><div class="case-try-actions"><a class="button button-primary" data-starter-download href={PROJECT.base + 'case-study/bookmark-starter.zip'} download="link-shelf-starter.zip">{ui.download}<span aria-hidden="true">↓</span></a><a class="text-link" data-start href={href(locale, 'getting-started')}>{ui.setup}<span aria-hidden="true">↗</span></a></div></div><div class="case-try-prompts"><CodeBlock locale={locale} code={ui.originalFirstPrompt} label={ui.firstPromptLabel} /><CodeBlock locale={locale} code={ui.originalNextPrompt} label={ui.nextPromptLabel} /></div></section>
</article>
