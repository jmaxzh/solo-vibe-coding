---
import { POSITIONING } from '../data/positioning';
import { PROJECT, PAGE_PATHS, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = POSITIONING[locale].preview;
const firstID = `case-first-${locale}`;
const secondID = `case-second-${locale}`;
---
<fieldset class="workshop" data-case-preview>
  <legend class="sr-only">{ui.selector}</legend>
  <input class="round-radio round-first sr-only" type="radio" id={firstID} name={`case-round-${locale}`} value="first" checked aria-controls={`${firstID}-panel`} />
  <input class="round-radio round-second sr-only" type="radio" id={secondID} name={`case-round-${locale}`} value="second" aria-controls={`${secondID}-panel`} />
  <div class="round-switch">
    <label for={firstID}><span aria-hidden="true">01</span>{ui.first}</label>
    <label for={secondID}><span aria-hidden="true">02</span>{ui.second}</label>
  </div>
  <div class="request-note">
    <span class="request-label">{ui.requestLabel}</span>
    <p class="request-first">{ui.requestFirst}</p>
    <p class="request-second">{ui.requestSecond}</p>
  </div>
  <div class="project-frame">
    <div class="project-bar"><span class="project-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{ui.project}</span><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="3" y="2" width="10" height="12" rx="2" /><path d="M6 5h4M6 8h4M6 11h2" /></svg></div>
    <figure class="round-panel panel-first" id={`${firstID}-panel`}>
      <a class="project-viewport" href={href(locale, PAGE_PATHS['case-study'])} aria-label={ui.open}><img src={PROJECT.base + 'case-study/bookmarks-round-1.png'} alt={ui.imageAlt} width="1280" height="900" fetchpriority="high" /></a>
      <figcaption><span class="result-check" aria-hidden="true">✓</span>{ui.resultFirst}</figcaption>
    </figure>
    <figure class="round-panel panel-second" id={`${secondID}-panel`}>
      <a class="project-viewport" href={href(locale, PAGE_PATHS['case-study'])} aria-label={ui.open}><img src={PROJECT.base + 'case-study/bookmarks-round-2.png'} alt={ui.imageTwoAlt} width="1280" height="900" loading="lazy" /></a>
      <figcaption><span class="result-check" aria-hidden="true">✓</span>{ui.resultSecond}</figcaption>
    </figure>
  </div>
  <div class="project-context"><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M14 6a6 6 0 1 0 1 6M14 2v5h-5" /></svg>{ui.secondDetail}</div>
  <p class="workshop-source">{ui.caption}<a href={href(locale, PAGE_PATHS['case-study'])}>{ui.open}<span aria-hidden="true"> ↗</span></a></p>
</fieldset>

<style>
  .workshop { position: relative; isolation: isolate; min-width: 0; border: 0; margin: 0; padding: 25px 24px 20px; border-radius: 18px; background: #e8e9da; background-image: radial-gradient(#a2a89155 .7px, transparent .8px); background-size: 12px 12px; }
  .workshop::before { content: ''; position: absolute; z-index: -1; inset: 7px -7px -6px 5px; border: 1px solid #d9dccc; border-radius: 18px; background: #e8e9da; transform: rotate(2deg); }
  .round-switch { display: flex; gap: 8px; position: relative; z-index: 1; }
  .round-switch label { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 9px 12px; border-radius: 7px; font-size: .76rem; font-weight: 600; color: #4c5546; cursor: pointer; transition: background-color .15s ease, color .15s ease; }
  .round-switch label > span { font: .63rem var(--mono); opacity: .8; }
  .round-first:checked ~ .round-switch label:first-child, .round-second:checked ~ .round-switch label:last-child { color: #fffdf4; background: #293b2e; box-shadow: 0 2px 4px #293b2e12; }
  .round-first:focus-visible ~ .round-switch label:first-child, .round-second:focus-visible ~ .round-switch label:last-child { outline: 3px solid #a33c23; outline-offset: 3px; }
  .request-note { position: relative; z-index: 1; padding: 16px 17px 17px; margin-top: 21px; margin-left: 13px; background: #fff8df; border: 1px solid #e8dfb9; box-shadow: 1px 4px 9px #6c674012; transform: rotate(-2deg); border-radius: 2px 8px 5px 3px; }
  .request-label { display: block; color: #786541; font-size: .62rem; margin-bottom: 8px; }
  .request-note p { font-size: .92rem; font-weight: 550; color: #3d3d2c; line-height: 1.65; min-height: 1.65em; }
  .request-second, .panel-second { display: none; }
  .round-second:checked ~ .request-note .request-first, .round-second:checked ~ .project-frame .panel-first { display: none; }
  .round-second:checked ~ .request-note .request-second, .round-second:checked ~ .project-frame .panel-second { display: block; }
  .project-frame { margin-top: 25px; background: #fffdf8; border: 1px solid #bbc2ad; box-shadow: 0 12px 25px -16px #333b2a66; border-radius: 10px; overflow: hidden; transform: rotate(.6deg); }
  .project-bar { display: flex; align-items: center; gap: 13px; min-height: 36px; padding: 8px 13px; border-bottom: 1px solid #d9ddcf; font-size: .65rem; font-weight: 600; color: #565d4d; }
  .project-dots { display: flex; gap: 4px; }
  .project-dots i { width: 5px; height: 5px; border-radius: 50%; background: #c3c8b8; }
  .project-bar > svg { width: 16px; height: 16px; margin-left: auto; stroke: #6d7760; stroke-width: 1.1; }
  .round-panel { margin: 0; }
  .project-viewport { display: block; aspect-ratio: 1.8; overflow: hidden; background: #f7f5ef; position: relative; }
  .project-viewport img { display: block; width: 190%; max-width: none; height: auto; position: absolute; top: -50%; left: -12%; }
  figcaption { display: flex; align-items: center; gap: 9px; padding: 12px 14px; font-size: .76rem; color: #384e32; background: #fcfcf5; border-top: 1px solid #dde2d2; }
  .result-check { display: grid; place-items: center; width: 19px; height: 19px; background: #e5ebda; border-radius: 50%; font-size: .7rem; flex: none; }
  .project-context { display: flex; justify-content: center; align-items: center; gap: 7px; font-size: .69rem; color: #56614b; margin-top: 17px; }
  .project-context svg { width: 16px; height: 16px; flex: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .workshop-source { margin-top: 17px; padding-top: 13px; border-top: 1px solid #c6ccb655; color: #5b6550; font-size: .62rem; line-height: 1.8; }
  .workshop-source a { display: inline; margin-left: 7px; color: #89442d; font-weight: 550; text-decoration-color: #b7a68b; }
  @media (max-width: 1100px) {
    .workshop { padding: 20px 17px 17px; }
    .round-switch { gap: 2px; }
    .round-switch label { font-size: .7rem; padding-inline: 10px; }
    .request-note { margin-left: 6px; padding: 14px; }
    .request-note p { font-size: .84rem; }
  }
  @media (max-width: 480px) {
    .workshop { padding: 18px 15px 15px; }
    .workshop::before { inset-inline: 4px -3px; transform: rotate(1deg); }
    .round-switch { gap: 6px; }
    .round-switch label { padding-inline: 9px; font-size: .72rem; gap: 6px; }
    .request-note { margin-top: 17px; margin-left: 4px; padding: 12px 13px; }
    .request-note p { font-size: .82rem; min-height: 3.3em; }
    .project-frame { margin-top: 20px; }
    .project-bar { padding: 7px 11px; font-size: .62rem; gap: 10px; }
    .project-viewport { aspect-ratio: 1.55; }
    .project-viewport img { top: -40%; }
    figcaption { font-size: .7rem; padding: 10px 11px; }
    .project-context { font-size: .64rem; }
    .workshop-source { font-size: .6rem; }
  }
  @media (prefers-reduced-motion: reduce) { .round-switch label { transition: none; } }
</style>
