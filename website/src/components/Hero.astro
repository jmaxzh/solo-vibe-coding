---
import TaskStage from './TaskStage.astro';
import WorkflowDiagram from './WorkflowDiagram.astro';
import { UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale].hero;
---
<section class="product-hero" aria-labelledby="hero-title">
  <div class="hero-canvas">
    <div class="hero-copy">
      <p class="product-definition"><span aria-hidden="true"></span>{ui.context}</p>
      <h1 id="hero-title"><span data-title-line>{ui.title}</span><span class="hero-accent" data-title-line>{ui.accent}</span></h1>
      <p class="hero-description">{ui.description}</p>
      <div class="product-actions">
        <a class="button button-primary" data-start data-home-start href={href(locale, 'getting-started')}>{ui.primary}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
        <a class="quiet-link" href="#why-skill">{ui.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="product-note">{ui.note}</p>
    </div>
    <WorkflowDiagram locale={locale} />
  </div>
  <TaskStage locale={locale} />
</section>

<style>
  .product-hero { padding-bottom: 65px; }
  .hero-canvas { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 64px; padding-block: 46px 38px; }
  .hero-copy { min-width: 0; }
  .product-definition { display: flex; align-items: center; gap: 9px; font-size: .9375rem; font-weight: 600; line-height: 1.5; letter-spacing: .02em; }
  .product-definition > span { width: 9px; height: 9px; flex: none; background: var(--action); }
  h1 { font-size: clamp(3.2rem, 5vw, 4.75rem); line-height: 1.17; font-weight: 750; letter-spacing: -.055em; margin-top: 25px; text-wrap: initial; }
  h1 > span { display: block; }
  .hero-accent { color: var(--action); }
  :global(:lang(zh-CN)) h1 { font-size: clamp(3.2rem, 5.3vw, 4.75rem); line-height: 1.2; letter-spacing: -.055em; }
  .hero-description { color: var(--muted); font-size: 1rem; line-height: 1.9; max-width: 470px; margin-top: 26px; }
  .product-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 28px; margin-top: 31px; }
  .product-actions .button { min-height: 54px; padding-inline: 23px; gap: 35px; font-size: .9375rem; border-radius: 0; }
  .product-actions svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .quiet-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--ink); text-decoration: none; font-size: .875rem; font-weight: 600; }
  .quiet-link:hover { text-decoration: underline; }
  .product-note { color: var(--muted); font-size: .75rem; line-height: 1.6; margin-top: 17px; }
  @media (max-width: 1100px) {
    .hero-canvas { gap: 35px; padding-block: 45px 35px; }
    h1, :global(:lang(zh-CN)) h1 { font-size: 3.5rem; }
    .hero-description { font-size: .9375rem; }
    .product-definition { font-size: .8125rem; }
    .product-actions { gap: 20px; }
    .product-actions .button { gap: 22px; font-size: .875rem; padding-inline: 18px; }
  }
  @media (max-width: 800px) {
    .hero-canvas { grid-template-columns: 1fr; gap: 35px; padding-block: 35px 30px; }
    h1, :global(:lang(zh-CN)) h1 { font-size: clamp(2.75rem, 7.5vw, 3.875rem); margin-top: 20px; }
    .hero-description { max-width: 560px; }
    .product-hero { padding-bottom: 45px; }
  }
  @media (max-width: 480px) {
    .hero-canvas { padding-block: 24px 23px; gap: 20px; }
    .product-definition { font-size: .75rem; gap: 7px; }
    .product-definition > span { width: 7px; height: 7px; }
    h1 { font-size: 2.375rem; line-height: 1.2; margin-top: 14px; }
    :global(:lang(zh-CN)) h1 { font-size: 2.6875rem; line-height: 1.22; }
    .hero-description { font-size: .875rem; line-height: 1.8; margin-top: 14px; }
    .product-actions { gap: 22px; margin-top: 18px; }
    .product-actions .button { min-height: 48px; padding-inline: 16px; font-size: .8125rem; gap: 21px; }
    .quiet-link { font-size: .75rem; gap: 8px; }
    .product-note { font-size: .6875rem; margin-top: 11px; }
  }
  @media (max-width: 350px) {
    h1, :global(:lang(zh-CN)) h1 { font-size: 2.3125rem; }
    .product-actions { gap: 15px; }
    .product-actions .button { gap: 13px; padding-inline: 13px; }
  }
</style>
