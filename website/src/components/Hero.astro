---
import TaskStage from './TaskStage.astro';
import { UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale].hero;
---
<section class="product-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="product-definition"><span aria-hidden="true">✳</span>{ui.context}<span class="definition-arrow" aria-hidden="true">↗</span></p>
    <h1 id="hero-title"><span data-title-line>{ui.title}</span><span class="hero-accent" data-title-line>{ui.accent}</span></h1>
    <p class="hero-description">{ui.description}</p>
    <div class="product-actions">
      <a class="button button-primary" data-start data-home-start href={href(locale, 'getting-started') + '?task=design#task-design'}>{ui.primary}<span aria-hidden="true">↗</span></a>
      <a class="button button-secondary" href="#usage-demo"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7 4 8 6-8 6V4Z" /></svg>{ui.secondary}</a>
    </div>
    <p class="product-note">{ui.note}</p>
  </div>
  <TaskStage locale={locale} />
</section>

<style>
  .product-hero { padding-top: 58px; }
  .hero-copy { text-align: center; max-width: 1000px; margin-inline: auto; }
  .product-definition { display: inline-flex; align-items: center; gap: 9px; padding: 6px 12px; background: #ffffffbf; border: 1px solid #b7cfe580; border-radius: 99px; font-size: 12px; font-weight: 550; color: #44576c; box-shadow: 0 2px 5px #304a6c04; }
  .product-definition > span:first-child { color: #2671c5; font-size: 17px; line-height: 1; }
  .definition-arrow { margin-left: 4px; }
  h1 { margin-top: 25px; font-size: clamp(44px, 4.5vw, 66px); line-height: 1.16; font-weight: 650; letter-spacing: -.055em; text-wrap: initial; }
  h1 > span { display: block; }
  .hero-accent { color: #586f89; }
  :global(:lang(zh-CN)) h1 { font-size: clamp(40px, 4.4vw, 64px); line-height: 1.28; letter-spacing: -.055em; }
  .hero-description { max-width: 665px; margin: 24px auto 0; color: var(--muted); font-size: 16px; line-height: 1.95; }
  .product-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .product-actions .button { min-height: 48px; padding: 11px 21px; gap: 15px; border-radius: 9px; font-size: 14px; }
  .product-actions .button-primary > span { font-size: 20px; font-weight: 400; line-height: 1; }
  .button-secondary { background: #ffffffc9; border: 1px solid #d4dde7; color: var(--ink); box-shadow: 0 2px 4px #304a6c03; }
  .button-secondary svg { width: 16px; height: 16px; fill: currentColor; }
  .product-note { color: #596b82; margin-top: 15px; font-size: 12px; }
  @media (max-width: 800px) { .product-hero { padding-top: 42px; } .hero-description { max-width: 560px; } }
  @media (max-width: 480px) {
    .product-hero { padding-top: 32px; }
    .product-definition { font-size: 11px; padding: 5px 10px; gap: 7px; }
    h1 { margin-top: 21px; font-size: 38px; line-height: 1.17; letter-spacing: -.05em; }
    :global(:lang(zh-CN)) h1 { font-size: 32px; line-height: 1.4; letter-spacing: -.055em; }
    .hero-description { font-size: 14px; line-height: 1.9; margin-top: 18px; padding-inline: 4px; }
    .product-actions { margin-top: 23px; gap: 9px; }
    .product-actions .button { padding-inline: 14px; font-size: 12px; gap: 9px; }
    .product-note { font-size: 11px; margin-top: 13px; }
  }
  @media (max-width: 360px) { :global(:lang(zh-CN)) h1 { font-size: 28px; } h1 { font-size: 33px; } }
</style>
