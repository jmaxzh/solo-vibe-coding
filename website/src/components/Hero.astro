---
import TaskStage from './TaskStage.astro';
import { UI, PROJECT, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale].hero;
const zh = locale === 'zh-CN';
---
<section class="product-hero" aria-labelledby="hero-title">
  <div class="hero-canvas">
    <div class="hero-copy">
      <p class="product-definition"><span aria-hidden="true"></span>{ui.context}</p>
      <h1 id="hero-title"><span data-title-line>{ui.title}</span><span data-title-line>{ui.accent}</span></h1>
      <p class="hero-description">{ui.description}</p>
      <div class="product-actions">
        <a class="button button-primary" data-start href={href(locale, 'getting-started')}>{ui.primary}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
        <a class="quiet-link" href="#why-skill">{ui.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="product-note">{ui.note}</p>
    </div>
    <figure class="hero-art" data-hero-tilt>
      <div class="art-orbit" aria-hidden="true"></div>
      <div class="art-transform" data-art-transform><img class="hero-object" data-hero-object src={PROJECT.base + 'art/hero-1440.webp'} srcset={PROJECT.base + 'art/hero-720.webp 720w, ' + PROJECT.base + 'art/hero-1440.webp 1440w'} sizes="(max-width: 800px) 95vw, 53vw" width="1440" height="960" fetchpriority="high" decoding="async" alt={zh ? '镀铬轨道串联蓝色玻璃应用窗口、橙色球体和青柠色方块的立体插画。' : 'A sculptural chrome ribbon threading cobalt glass app windows, an orange sphere and a lime glass block.'} /></div>
      <figcaption><span>{zh ? '从目标，到能用的成果。' : 'From a goal to something you can use.'}</span><button class="motion-toggle" type="button" data-motion-toggle data-pause={zh ? '暂停动画' : 'Pause motion'} data-play={zh ? '开启动画' : 'Play motion'} data-reduced={zh ? '动画已关闭' : 'Motion reduced'} hidden><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" /></svg><span data-motion-label>{zh ? '暂停动画' : 'Pause motion'}</span></button></figcaption>
    </figure>
    <div class="hero-footnote"><span>Solo Vibe Coding</span><p>{zh ? '用你熟悉的助手，把眼前的事做好。' : 'Your usual assistant. A better way through the work.'}</p><a href="#why-skill" aria-label={zh ? '浏览四个使用场景' : 'Explore the four scenarios'}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6" /></svg></a></div>
  </div>
  <TaskStage locale={locale} />
</section>

<style>
  .product-hero { padding-block: 24px 72px; }
  .hero-canvas { position: relative; isolation: isolate; display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; min-height: 655px; background: #2457f5; color: #fffefa; border-radius: 28px; overflow: hidden; padding: 60px 52px 100px; }
  .hero-copy { position: relative; z-index: 2; }
  .hero-canvas :is(a, button):focus-visible { outline-color: #fffefa; }
  .product-definition { display: flex; align-items: center; gap: 10px; font-size: .75rem; color: #e6ecff; margin-bottom: 27px; }
  .product-definition > span { width: 7px; height: 7px; flex: none; background: #d5f36b; border-radius: 50%; }
  h1 { font-size: clamp(3.2rem, 4.7vw, 4.6rem); line-height: 1.1; font-weight: 750; letter-spacing: -.04em; }
  h1 > span { display: block; }
  :global(:lang(zh-CN)) h1 { font-size: clamp(2.7rem, 4.15vw, 4rem); line-height: 1.3; letter-spacing: -.03em; }
  .hero-description { color: #e4ebff; font-size: .96rem; line-height: 1.9; max-width: 43ch; margin-top: 27px; }
  .product-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: 29px; }
  .product-actions .button-primary { background: #ff885f; border-radius: 9px; padding: 15px 20px; gap: 22px; color: #17212e; }
  .product-actions .button-primary:hover { background: #ffab8d; }
  .product-actions svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 160ms var(--ease-out); }
  .quiet-link { display: inline-flex; align-items: center; gap: 10px; color: #fffefa; text-decoration: none; font-size: .82rem; font-weight: 600; padding-block: 8px; }
  .quiet-link:hover { text-decoration: underline; text-underline-offset: 6px; }
  .product-note { color: #eef2ff; font-size: .7rem; margin-top: 18px; }
  .hero-art { position: relative; min-width: 0; margin: 0 -65px 0 -40px; align-self: stretch; display: flex; flex-direction: column; justify-content: center; perspective: 1200px; }
  .art-orbit { position: absolute; width: 86%; aspect-ratio: 1; border: 1px solid #ffffff35; border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%, -52%) rotateX(55deg) rotate(-20deg); pointer-events: none; }
  .art-transform { position: relative; width: 100%; transform-style: preserve-3d; transition: transform 260ms var(--ease-out); }
  .hero-object { width: 116%; max-width: none; height: auto; margin-left: -8%; animation: studio-float 12s ease-in-out infinite; animation-play-state: paused; }
  :global(html[data-motion="on"]) .hero-object { animation-play-state: running; }
  .hero-art figcaption { position: absolute; display: flex; align-items: center; justify-content: space-between; gap: 14px; bottom: -30px; left: 65px; right: 42px; font-size: .67rem; color: #e1e8ff; z-index: 2; }
  .motion-toggle { display: inline-flex; align-items: center; gap: 7px; min-height: 36px; border: 1px solid #ffffff55; color: #fffefa; background: #2457f5; border-radius: 20px; padding: 7px 10px; font-size: .64rem; white-space: nowrap; }
  .motion-toggle svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.7; }
  .motion-toggle:disabled { cursor: default; opacity: .8; }
  .hero-footnote { position: absolute; display: flex; align-items: center; gap: 30px; bottom: 0; left: 52px; right: 52px; min-height: 58px; border-top: 1px solid #ffffff38; font-size: .65rem; color: #eef2ff; }
  .hero-footnote > span { font-weight: 700; color: #fffefa; }
  .hero-footnote > p { margin-left: auto; }
  .hero-footnote > a { display: grid; place-items: center; width: 28px; height: 28px; color: #fffefa; }
  .hero-footnote svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  @keyframes studio-float { 0%, 100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-13px) rotate(1.5deg); } }
  @media (hover: hover) and (pointer: fine) { .product-actions .button-primary:hover svg { transform: translateX(4px); } }
  @media (max-width: 1100px) {
    .hero-canvas { padding-inline: 35px; grid-template-columns: 1.05fr 1fr; min-height: 630px; }
    h1 { font-size: 3.25rem; }
    :global(:lang(zh-CN)) h1 { font-size: 2.8rem; }
    .hero-art { margin-right: -40px; }
    .hero-description { font-size: .9rem; }
    .product-actions { gap: 16px; }
    .product-actions .button-primary { padding-inline: 16px; font-size: .8rem; gap: 13px; }
    .hero-art figcaption { left: 45px; right: 28px; }
    .hero-footnote { left: 35px; right: 35px; gap: 20px; }
  }
  @media (max-width: 800px) {
    .product-hero { padding-top: 18px; padding-bottom: 50px; }
    .hero-canvas { grid-template-columns: 1fr; padding: 40px 32px 90px; min-height: 0; gap: 5px; border-radius: 22px; }
    .hero-copy { max-width: 590px; }
    h1 { font-size: clamp(3rem, 6.5vw, 4rem); }
    :global(:lang(zh-CN)) h1 { font-size: clamp(2.6rem, 6vw, 3.5rem); }
    .hero-description { max-width: 52ch; }
    .hero-art { margin: 0; min-height: 340px; max-width: 550px; justify-self: center; width: 100%; }
    .hero-object { width: 112%; margin-left: -6%; }
    .hero-art figcaption { bottom: -8px; left: 0; right: 0; }
    .hero-footnote { left: 32px; right: 32px; gap: 16px; font-size: .6rem; }
    .hero-footnote > p { max-width: 34ch; text-align: right; }
    .hero-footnote > a { display: none; }
    .product-definition { margin-bottom: 21px; }
  }
  @media (max-width: 480px) {
    .hero-canvas { padding: 30px 23px 82px; border-radius: 18px; }
    .product-definition { font-size: .63rem; gap: 8px; margin-bottom: 19px; }
    h1 { font-size: 2.65rem; }
    :global(:lang(zh-CN)) h1 { font-size: clamp(2rem, 7.8vw, 2.6rem); }
    .hero-description { font-size: .83rem; margin-top: 20px; line-height: 1.85; }
    .product-actions { gap: 16px; margin-top: 22px; }
    .product-actions .button-primary { font-size: .75rem; padding: 13px 14px; gap: 12px; }
    .quiet-link { font-size: .73rem; }
    .product-note { font-size: .63rem; margin-top: 14px; }
    .hero-art { min-height: 260px; margin-top: 10px; }
    .hero-art figcaption { font-size: .57rem; gap: 8px; bottom: -4px; }
    .motion-toggle { padding: 6px 8px; font-size: .58rem; }
    .hero-footnote { left: 23px; right: 23px; gap: 15px; font-size: .54rem; min-height: 55px; }
    .hero-footnote > p { max-width: 24ch; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-object { animation: none; } .art-transform { transition: none; } }
</style>
