---
import TaskStage from './TaskStage.astro';
import { UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale].hero;
---
<section class="product-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="product-definition"><span aria-hidden="true">✳</span>{ui.context}<span class="definition-arrow" aria-hidden="true">↗</span></p>
    <h1 id="hero-title"><span data-title-line>{ui.title}</span><span class="hero-accent" data-title-line>{ui.accent}</span></h1>
    <p class="hero-description">{ui.description}</p>
    <div class="product-actions">
      <a class="button button-primary" data-start data-home-start href={href(locale, 'getting-started') + '?task=design#task-design'}>{ui.primary}<span aria-hidden="true">↗</span></a>
      <a class="button button-secondary" href="#usage-demo"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7 4 8 6-8 6V4Z" /></svg>{ui.secondary}</a>
    </div>
    <p class="product-note">{ui.note}</p>
  </div>
  <TaskStage locale={locale} />
</section>

<style>
  .product-hero { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: center; gap: 44px; padding-block: 72px 78px; position: relative; }
  .hero-copy { position: relative; z-index: 1; min-width: 0; }
  .product-definition { display: inline-flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .04em; color: #b3bdca; }
  .product-definition > span:first-child { color: #c0f49b; font-size: 18px; }
  .definition-arrow { display: none; }
  h1 { margin-top: 25px; font-size: clamp(39px, 4.25vw, 60px); line-height: 1.13; font-weight: 650; letter-spacing: -.06em; text-wrap: initial; }
  h1 > span { display: block; }
  .hero-accent { color: #bdf498; margin-top: 4px; }
  :global(:lang(zh-CN)) h1 { font-size: clamp(36px, 3.4vw, 49px); line-height: 1.35; letter-spacing: -.06em; }
  .hero-description { max-width: 490px; margin-top: 26px; color: #abb4c1; font-size: 16px; line-height: 1.95; }
  .product-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 11px; margin-top: 29px; }
  .product-actions .button { min-height: 49px; padding: 12px 19px; gap: 15px; border-radius: 7px; font-size: 13px; }
  .product-actions .button-primary { background: #bdf498; color: #11160e; box-shadow: 0 2px 14px #bdf4980d; }
  .product-actions .button-primary:hover { background: #d3ffb4; }
  .product-actions .button-primary > span { font-size: 20px; font-weight: 400; line-height: 1; }
  .button-secondary { background: #151920; border: 1px solid #343c48; color: #e7ebf0; }
  .button-secondary:hover { background: #20262e; }
  .button-secondary svg { width: 14px; height: 14px; fill: currentColor; }
  .product-note { color: #919cae; margin-top: 17px; font-size: 12px; }
  @media (max-width: 1100px) { .product-hero { gap: 28px; } h1 { font-size: 45px; } :global(:lang(zh-CN)) h1 { font-size: 38px; } .product-actions .button { padding-inline: 14px; gap: 10px; font-size: 12px; } }
  @media (max-width: 900px) { .product-hero { grid-template-columns: 1fr; gap: 36px; padding-block: 45px 60px; } .hero-copy { max-width: 640px; } h1 { font-size: 56px; } :global(:lang(zh-CN)) h1 { font-size: 45px; } .hero-description { max-width: 570px; } }
  @media (max-width: 480px) {
    .product-hero { padding-top: 30px; padding-bottom: 44px; gap: 30px; }
    .product-definition { font-size: 11px; gap: 7px; }
    h1 { margin-top: 20px; font-size: 38px; line-height: 1.18; }
    :global(:lang(zh-CN)) h1 { font-size: 32px; line-height: 1.42; letter-spacing: -.065em; }
    .hero-description { font-size: 14px; line-height: 1.9; margin-top: 18px; }
    .product-actions { margin-top: 24px; gap: 8px; }
    .product-actions .button { padding-inline: 14px; font-size: 12px; gap: 8px; }
    .product-note { font-size: 11px; margin-top: 15px; }
  }
  @media (max-width: 360px) { :global(:lang(zh-CN)) h1 { font-size: 28px; } h1 { font-size: 33px; } }
</style>
