---
import TaskStage from './TaskStage.astro';
import { UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale].hero;
---
<section class="product-hero" aria-labelledby="hero-title">
  <div class="hero-introduction">
    <div>
      <p class="product-definition">{ui.context}</p>
      <h1 id="hero-title">{ui.title}<br />{ui.accent}</h1>
    </div>
    <div class="hero-invitation">
      <p>{ui.description}</p>
      <div class="product-actions">
        <a class="button button-primary" data-start href={href(locale, 'getting-started')}>{ui.primary}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
        <a class="quiet-link" href="#why-skill">{ui.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="product-note">{ui.note}</p>
    </div>
  </div>
  <TaskStage locale={locale} />
</section>

<style>
  .product-hero { padding-block: 65px 74px; }
  .hero-introduction { display: grid; grid-template-columns: 1.22fr 1fr; gap: 80px; align-items: end; margin-bottom: 50px; }
  .product-definition { color: var(--muted); font-size: .77rem; margin-bottom: 20px; }
  h1 { font-size: clamp(3.5rem, 5.4vw, 5rem); line-height: 1.12; font-weight: 650; letter-spacing: -.04em; }
  :global(:lang(zh-CN)) h1 { font-size: clamp(2.7rem, 4.5vw, 4.1rem); line-height: 1.3; letter-spacing: -.025em; }
  .hero-invitation { padding-bottom: 7px; }
  .hero-invitation > p:first-child { color: var(--muted); font-size: .98rem; line-height: 1.9; max-width: 47ch; }
  .product-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 23px; margin-top: 26px; }
  .product-actions svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .quiet-link { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: .84rem; font-weight: 600; }
  .quiet-link:hover { color: var(--accent-ink); }
  .product-note { color: var(--muted); font-size: .72rem; margin-top: 15px; }
  @media (max-width: 1100px) {
    .hero-introduction { gap: 38px; }
    h1 { font-size: 3.5rem; }
    :global(:lang(zh-CN)) h1 { font-size: 3rem; }
  }
  @media (max-width: 800px) {
    .product-hero { padding-block: 38px 52px; }
    .hero-introduction { grid-template-columns: 1fr; gap: 25px; margin-bottom: 34px; }
    .hero-invitation > p:first-child { max-width: 56ch; }
    h1 { font-size: clamp(2.8rem, 7vw, 4.3rem); }
    :global(:lang(zh-CN)) h1 { font-size: clamp(2.4rem, 6.7vw, 3.5rem); }
    .product-definition { margin-bottom: 18px; }
  }
  @media (max-width: 480px) {
    .product-hero { padding-top: 28px; }
    .product-definition { font-size: .69rem; }
    .hero-invitation > p:first-child { font-size: .9rem; line-height: 1.85; }
    .product-actions { gap: 18px; margin-top: 22px; }
    .product-actions .button { font-size: .8rem; padding-inline: 16px; gap: 12px; }
    .quiet-link { font-size: .78rem; }
    .product-note { font-size: .68rem; }
  }
</style>
