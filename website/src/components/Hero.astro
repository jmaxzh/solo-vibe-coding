---
import OrbitScene from './OrbitScene.astro';
import { UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale].hero;
const zh = locale === 'zh-CN';
---
<section class="product-hero" aria-labelledby="hero-title">
  <OrbitScene />
  <div class="hero-shell">
    <div class="hero-overline"><span class="live-dot" aria-hidden="true"></span><span>{ui.context}</span><span class="hero-edition">INDEPENDENT BY DESIGN</span></div>
    <div class="hero-copy">
      <h1 id="hero-title"><span data-title-line>{ui.title}</span><span class="hero-accent" data-title-line>{ui.accent}</span></h1>
      <p class="hero-description">{ui.description}</p>
      <div class="product-actions">
        <a class="button button-primary" data-magnetic data-start data-home-start href={href(locale, 'getting-started') + '?task=design#task-design'}><span>{ui.primary}</span><span class="action-orbit" aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="#usage-demo"><span class="play-symbol" aria-hidden="true">▶</span>{ui.secondary}</a>
      </div>
      <p class="product-note">{ui.note}</p>
    </div>
    <div class="hero-bottom"><a class="hero-scroll" href="#usage-demo"><span class="scroll-circle" aria-hidden="true">↓</span><span>{zh ? '向下探索，看看实际用法' : 'Explore how it works'}</span></a><span class="hero-bottom-label">ONE SKILL. YOUR OWN ASSISTANT.</span></div>
    <button class="motion-toggle hero-motion" type="button" data-motion-toggle data-pause={zh ? '暂停动画' : 'Pause motion'} data-play={zh ? '开启动画' : 'Play motion'} data-reduced={zh ? '动画已关闭' : 'Motion reduced'} hidden><span class="motion-icon" aria-hidden="true">Ⅱ</span><span data-motion-label>{zh ? '暂停动画' : 'Pause motion'}</span></button>
  </div>
</section>

<style>
  .product-hero { position: relative; min-height: 860px; min-height: min(980px, 100svh); overflow: clip; isolation: isolate; background: #05070b; }
  .hero-shell { position: relative; z-index: 5; width: min(1320px, calc(100% - 112px)); min-height: inherit; margin-inline: auto; display: flex; flex-direction: column; justify-content: center; padding-block: 154px 115px; }
  .hero-overline { display: flex; align-items: center; gap: 11px; color: #cad7e8; font-size: 11px; letter-spacing: .07em; margin-bottom: 28px; position: relative; z-index: 2; width: fit-content; }
  .hero-overline::before { content: ''; position: absolute; inset: -8px -13px; background: #05070be6; filter: blur(10px); z-index: -1; pointer-events: none; }
  .live-dot { width: 5px; height: 5px; background: #ffa174; border-radius: 50%; box-shadow: 0 0 18px #fc8e6399; }
  .hero-edition { font: 9px var(--mono); color: #9aaac0; margin-left: 21px; padding-left: 19px; border-left: 1px solid #58677d; }
  .hero-copy { max-width: 920px; }
  h1 { font-size: clamp(58px, 6.2vw, 90px); line-height: 1.03; font-weight: 650; letter-spacing: -.065em; text-wrap: initial; margin: 0; text-shadow: 0 4px 40px #000b; position: relative; isolation: isolate; }
  h1::before { content: ''; position: absolute; inset: -30px -90px -35px -50px; z-index: -1; pointer-events: none; background: linear-gradient(90deg, #05070bf0, #05070bd9 calc(100% - 65px), #05070b00); filter: blur(16px); }
  h1 > span { display: block; }
  .hero-accent { color: #e4ecf6; margin-top: 6px; }
  :global(:lang(zh-CN)) h1 { font-size: clamp(44px, 5.25vw, 80px); line-height: 1.3; letter-spacing: -.065em; }
  .hero-description { max-width: 560px; margin-top: 30px; color: #c0c9d7; font-size: 15px; line-height: 2; text-shadow: 0 1px 14px #000; position: relative; isolation: isolate; }
  .hero-description::before { content: ''; position: absolute; inset: -8px -18px -8px -15px; z-index: -1; pointer-events: none; background: #05070be6; filter: blur(14px); }
  .product-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 13px; margin-top: 30px; }
  .product-actions .button { min-height: 55px; padding: 9px 13px 9px 23px; gap: 22px; border-radius: 99px; font-size: 13px; }
  .product-actions .button-primary { background: #f68c5d; color: #110b07; border: 1px solid #ffb590; box-shadow: 0 0 32px #f68c5d22; }
  .product-actions .button-primary:hover { background: #ffb28d; box-shadow: 0 0 45px #f68c5d44; }
  .action-orbit { display: grid; place-items: center; border: 1px solid #74402d66; border-radius: 50%; width: 34px; height: 34px; font-size: 22px; line-height: 1; font-weight: 400; }
  .product-actions .button-secondary { background: #111b2a73; border: 1px solid #76879e80; color: #edf4fd; padding-inline: 21px; gap: 10px; backdrop-filter: blur(12px); }
  .button-secondary:hover { background: #1d2d43ad; }
  .play-symbol { font-size: 9px; }
  .product-note { color: #afbdd0; margin-top: 18px; font-size: 11px; }
  .hero-bottom { position: absolute; inset: auto 0 26px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .hero-scroll { display: inline-flex; align-items: center; gap: 13px; min-height: 48px; text-decoration: none; color: #c6d1e2; font-size: 10px; letter-spacing: .03em; }
  .scroll-circle { display: grid; place-items: center; width: 43px; height: 43px; border: 1px solid #5c6d85; border-radius: 50%; font-size: 20px; transition: transform 200ms ease; }
  .hero-scroll:hover .scroll-circle { transform: translateY(3px); }
  .hero-bottom-label { color: #a5b6cc; font: 9px var(--mono); letter-spacing: .12em; }
  .hero-motion { position: absolute; top: calc(var(--home-header-height, 88px) + 10px); right: 0; display: inline-flex; align-items: center; gap: 7px; min-height: 44px; padding: 7px 11px; border: 1px solid #6f819c66; border-radius: 99px; background: #0c14218c; color: #c8d8ed; font-size: 10px; backdrop-filter: blur(10px); }
  .motion-icon { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; border: 1px solid #90a6c06b; font-size: 8px; }
  .hero-motion:disabled { color: #afbed1; cursor: default; }
  @media (max-width: 1100px) { .hero-shell { width: calc(100% - 80px); } .hero-copy { max-width: 800px; } h1 { font-size: 70px; } :global(:lang(zh-CN)) h1 { font-size: 55px; } .hero-description { max-width: 500px; } }
  @media (max-width: 700px) {
    .product-hero { min-height: 890px; }
    .hero-shell { width: calc(100% - 36px); padding-block: 140px 375px; justify-content: start; }
    .hero-overline { margin-bottom: 21px; font-size: 10px; gap: 8px; }
    .hero-edition { display: none; }
    h1 { font-size: clamp(38px, 9.8vw, 62px); line-height: 1.08; }
    :global(:lang(zh-CN)) h1 { font-size: clamp(32px, 8.2vw, 46px); line-height: 1.4; }
    .hero-accent { margin-top: 0; }
    .hero-description { font-size: 14px; line-height: 1.95; margin-top: 22px; max-width: 500px; }
    .product-actions { gap: 10px; margin-top: 24px; }
    .product-actions .button { min-height: 53px; padding: 9px 11px 9px 17px; gap: 13px; font-size: 12px; }
    .action-orbit { width: 30px; height: 30px; font-size: 20px; }
    .product-actions .button-secondary { padding-inline: 15px; gap: 8px; }
    .product-note { font-size: 10px; margin-top: 16px; }
    .hero-bottom { bottom: 20px; }
    .hero-bottom-label { max-width: 140px; text-align: right; font-size: 8px; line-height: 1.8; }
    .hero-scroll { font-size: 9px; gap: 9px; }
    .scroll-circle { width: 37px; height: 37px; }
    .hero-motion { font-size: 9px; padding-inline: 9px; }
  }
  @media (max-width: 360px) { .product-actions { gap: 8px; } .product-actions .button { font-size: 11px; gap: 8px; padding-left: 13px; } .product-actions .button-secondary { padding-inline: 12px; } }
  @media (prefers-reduced-motion: reduce) { .scroll-circle { transition: none; } }
</style>
