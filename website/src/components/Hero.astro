---
import PrismScene from './PrismScene.astro';
import { UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale].hero;
const zh = locale === 'zh-CN';
---
<section class="product-hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="hero-shell">
    <div class="hero-composition">
      <div class="hero-copy">
        <p class="hero-overline"><span class="signal" aria-hidden="true"></span>{ui.context}</p>
        <h1 id="hero-title"><span data-title-line>{ui.title}</span><span class="hero-accent" data-title-line>{ui.accent}</span></h1>
        <p class="hero-description">{ui.description}</p>
        <div class="product-actions">
          <a class="button button-primary" data-magnetic data-start data-home-start href={href(locale, 'getting-started') + '?task=design#task-design'}><span>{ui.primary}</span><span class="action-arrow" aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="#usage-demo"><span class="play-symbol" aria-hidden="true">▷</span>{ui.secondary}</a>
        </div>
        <p class="product-note">{ui.note}</p>
      </div>
      <PrismScene />
    </div>
    <div class="hero-bottom"><a class="hero-scroll" href="#usage-demo"><span aria-hidden="true">↓</span>{zh ? '向下探索，看看实际用法' : 'Explore how it works'}</a><span class="hero-bottom-label">OPEN SOURCE. OPEN POSSIBILITIES.</span></div>
    <button class="motion-toggle hero-motion" type="button" data-motion-toggle data-pause={zh ? '暂停动画' : 'Pause motion'} data-play={zh ? '开启动画' : 'Play motion'} data-reduced={zh ? '动画已关闭' : 'Motion reduced'} hidden><span aria-hidden="true">Ⅱ</span><span data-motion-label>{zh ? '暂停动画' : 'Pause motion'}</span></button>
  </div>
</section>
<style>
  .product-hero { position: relative; overflow: clip; isolation: isolate; color: #eff5f1; background: #070b0d; }
  .hero-atmosphere { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 88% 34%, #327a5522, transparent 55%), radial-gradient(ellipse at 85% 80%, #65468117, transparent 44%); }
  .hero-shell { position: relative; width: min(1320px, calc(100% - 112px)); min-height: 980px; margin-inline: auto; padding-block: 160px 115px; display: flex; flex-direction: column; justify-content: center; }
  .hero-composition { display: block; width: 100%; }
  .hero-copy { position: relative; min-width: 0; width: min(920px, 100%); z-index: 3; }
  .hero-overline { display: flex; align-items: center; gap: 10px; font-size: 11px; line-height: 1.8; letter-spacing: .025em; color: #bdd2c7; margin: 0 0 25px; position: relative; z-index: 4; width: fit-content; isolation: isolate; }
  .hero-overline::before, .product-note::before { content: ""; position: absolute; inset: -7px -12px; background: #070b0de6; filter: blur(10px); pointer-events: none; z-index: -1; }
  .signal { width: 6px; height: 6px; border-radius: 50%; background: #c5f8b9; box-shadow: 0 0 16px #b3f7ae80; flex: none; }
  h1 { font-size: clamp(62px, 6.2vw, 88px); font-weight: 600; line-height: 1.07; letter-spacing: -.065em; text-wrap: initial; margin: 0; position: relative; isolation: isolate; }
  h1::before { content: ""; position: absolute; inset: -24px -65px -25px -40px; pointer-events: none; z-index: -1; background: linear-gradient(90deg, #070b0df5, #070b0ddc calc(100% - 75px), #070b0d00); filter: blur(16px); }
  h1 > span { display: block; }
  .hero-accent { color: #dcece3; margin-top: 7px; }
  :global(:lang(zh-CN)) h1 { font-size: clamp(46px, 5.25vw, 76px); line-height: 1.32; letter-spacing: -.065em; }
  .hero-description { color: #b5c2bc; max-width: 560px; margin: 29px 0 0; font-size: 15px; line-height: 1.95; position: relative; isolation: isolate; }
  .hero-description::before { content: ""; position: absolute; inset: -8px -18px -8px -15px; background: #070b0de8; filter: blur(14px); pointer-events: none; z-index: -1; }
  .product-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 13px; margin-top: 31px; }
  .product-actions .button { min-height: 55px; font-size: 13px; border-radius: 99px; gap: 25px; padding: 10px 15px 10px 24px; }
  .product-actions .button-primary { background: #c5f8b9; border: 1px solid #e1ffd8; color: #101b13; box-shadow: 0 0 35px #a0f4a01a; }
  .product-actions .button-primary:hover { background: #dcffd2; box-shadow: 0 0 45px #a0f4a030; }
  .action-arrow { display: grid; place-items: center; border: 1px solid #55705077; border-radius: 50%; width: 33px; height: 33px; font-size: 22px; line-height: 1; font-weight: 400; }
  .product-actions .button-secondary { border: 1px solid #667e7280; background: #16231b99; color: #e7f1eb; padding-inline: 21px; gap: 10px; }
  .product-actions .button-secondary:hover { background: #24372be0; }
  .play-symbol { font-size: 17px; font-weight: 400; }
  .product-note { font-size: 11px; color: #a1b3a9; margin-top: 20px; position: relative; isolation: isolate; width: fit-content; }
  .hero-bottom { position: absolute; bottom: 27px; inset-inline: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .hero-scroll { display: inline-flex; align-items: center; gap: 13px; min-height: 44px; color: #b6cbbf; font-size: 10px; text-decoration: none; }
  .hero-scroll > span { width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid #566a60; border-radius: 50%; font-size: 21px; }
  .hero-bottom-label { position: relative; isolation: isolate; font: 9px var(--mono); color: #93aca0; letter-spacing: .1em; }
  .hero-bottom-label::before { content: ""; position: absolute; inset: -9px -12px; z-index: -1; pointer-events: none; background: #070b0def; filter: blur(8px); }
  .hero-motion { position: absolute; z-index: 5; top: calc(var(--home-header-height, 88px) + 10px); right: 0; min-height: 44px; padding: 8px 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 99px; border: 1px solid #68847477; background: #102019b3; color: #c6dace; font-size: 10px; backdrop-filter: blur(12px); }
  .hero-motion:disabled { color: #a5b8ad; cursor: default; }
  @media (max-width: 1200px) { .hero-shell { width: calc(100% - 80px); } h1 { font-size: 70px; } :global(:lang(zh-CN)) h1 { font-size: 55px; } .hero-description { font-size: 14px; } .product-actions .button { font-size: 12px; gap: 13px; } }
  @media (max-width: 1000px) { .hero-shell { display: block; min-height: 0; padding-block: 155px 100px; } .hero-copy { width: 100%; max-width: 820px; } h1 { font-size: clamp(49px, 7.5vw, 74px); } :global(:lang(zh-CN)) h1 { font-size: clamp(40px, 5.7vw, 59px); } .hero-description { max-width: 650px; font-size: 15px; } }
  @media (max-width: 800px) { .hero-shell { width: calc(100% - 48px); } }
  @media (max-width: 600px) {
    .hero-shell { width: calc(100% - 36px); padding-block: 147px 95px; }
    .hero-overline { font-size: 10px; margin-bottom: 22px; }
    h1 { font-size: clamp(37px, 10vw, 57px); line-height: 1.09; }
    :global(:lang(zh-CN)) h1 { font-size: clamp(31px, 8.25vw, 46px); line-height: 1.4; }
    .hero-accent { margin-top: 0; }
    .hero-description { font-size: 14px; line-height: 1.95; margin-top: 23px; }
    .product-actions { margin-top: 24px; gap: 10px; }
    .product-actions .button { min-height: 53px; padding: 9px 12px 9px 17px; gap: 13px; font-size: 12px; }
    .product-actions .button-secondary { padding-inline: 16px; gap: 8px; }
    .action-arrow { width: 29px; height: 29px; font-size: 20px; }
    .product-note { font-size: 10px; margin-top: 18px; }

    .hero-bottom { bottom: 19px; align-items: end; }
    .hero-bottom-label { max-width: 120px; text-align: right; font-size: 8px; line-height: 1.8; }
    .hero-scroll { font-size: 9px; gap: 9px; }
    .hero-scroll > span { width: 34px; height: 34px; }
    .hero-motion { font-size: 9px; }
  }
  @media (max-width: 360px) { .product-actions .button { font-size: 11px; padding-left: 13px; gap: 9px; } .product-actions .button-secondary { padding-inline: 12px; } }
</style>
