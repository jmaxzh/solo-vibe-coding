---
import FoldScene from './FoldScene.astro';
import { UI, href, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = UI[locale].hero;
const zh = locale === 'zh-CN';
---
<section class="product-hero" aria-labelledby="hero-title">
  <div class="hero-shell">
    <div class="hero-overline"><span>{ui.context}</span><span class="hero-edition">INDEPENDENT BY DESIGN / SOLO VIBE</span></div>
    <h1 id="hero-title"><span data-title-line>{ui.title}</span><span class="hero-accent" data-title-line>{ui.accent}</span></h1>
    <div class="hero-composition">
    <div class="hero-copy">
      <span class="hero-copy-index" aria-hidden="true">↳</span>
      <p class="hero-description">{ui.description}</p>
      <div class="product-actions">
        <a class="button button-primary" data-magnetic data-start data-home-start href={href(locale, 'getting-started') + '?task=design#task-design'}><span>{ui.primary}</span><span class="action-arrow" aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="#usage-demo">{ui.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="product-note">{ui.note}</p>
    </div>
    <FoldScene />
    </div>
    <div class="hero-bottom"><span class="hero-bottom-label">A LITTLE GUIDANCE.<br />A LOT TO MAKE.</span><a class="hero-scroll" href="#usage-demo">{zh ? '展开你的下一步' : 'Unfold your next move'}<span aria-hidden="true">↓</span></a></div>
    <button class="motion-toggle hero-motion" type="button" data-motion-toggle data-pause={zh ? '暂停动画' : 'Pause motion'} data-play={zh ? '开启动画' : 'Play motion'} data-reduced={zh ? '动画已关闭' : 'Motion reduced'} hidden><span aria-hidden="true">◉</span><span data-motion-label>{zh ? '暂停动画' : 'Pause motion'}</span></button>
  </div>
</section>
<style>
  .product-hero { position: relative; overflow: clip; isolation: isolate; background: #f4f1e8; color: #182fc4; }
  .hero-shell { position: relative; z-index: 3; width: min(1320px, calc(100% - 112px)); min-height: 1030px; margin-inline: auto; padding-block: 160px 125px; }
  .hero-overline { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 24px; font-size: 11px; color: #3447a0; letter-spacing: .03em; }
  .hero-overline > span:first-child::before { content: '✳'; color: #b43215; font-size: 17px; margin-right: 12px; }
  .hero-edition { font: 9px var(--mono); letter-spacing: .06em; padding-right: 125px; }
  h1 { font-size: clamp(75px, 7.5vw, 112px); line-height: 1.02; font-weight: 750; letter-spacing: -.075em; text-wrap: initial; margin: 0; max-width: 1280px; }
  h1 > span { display: block; width: fit-content; }
  .hero-accent { margin-top: 5px; }
  :global(:lang(zh-CN)) h1 { font-size: clamp(55px, 6.4vw, 94px); line-height: 1.2; letter-spacing: -.075em; }
  .hero-composition { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.45fr); gap: 35px; align-items: start; margin-top: 65px; }
  .hero-copy { max-width: 435px; padding-left: 48px; position: relative; }
  .hero-copy-index { position: absolute; left: 0; top: -8px; font-size: 44px; font-weight: 400; color: #b43215; line-height: 1; }
  .hero-description { margin: 0; font-size: 15px; color: #333951; line-height: 1.95; }
  .product-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 13px; margin-top: 26px; }
  .product-actions .button { min-height: 57px; padding: 10px 18px; gap: 21px; border-radius: 0; font-size: 12px; }
  .product-actions .button-primary { color: #fffdf3; background: #2036c9; border: 1px solid #2036c9; box-shadow: 5px 5px 0 #ff613d; }
  .product-actions .button-primary:hover { background: #102189; border-color: #102189; box-shadow: 7px 7px 0 #ff613d; }
  .action-arrow { font-size: 24px; line-height: 1; font-weight: 400; }
  .product-actions .button-secondary { color: #182fc4; background: transparent; border: 0; padding-inline: 0; gap: 12px; box-shadow: none; }
  .product-actions .button-secondary:hover { text-decoration: underline; }
  .product-note { color: #545972; font-size: 10px; margin-top: 23px; }
  .hero-bottom { position: absolute; bottom: 30px; left: 0; right: 0; display: flex; justify-content: space-between; gap: 20px; align-items: end; }
  .hero-bottom-label { font: 10px/1.7 var(--mono); color: #33479b; letter-spacing: .04em; }
  .hero-scroll { display: flex; align-items: center; gap: 20px; min-height: 44px; font-size: 11px; color: #243bb8; text-decoration: none; }
  .hero-scroll span { font-size: 30px; font-weight: 400; }
  .hero-motion { position: absolute; top: calc(var(--home-header-height, 88px) + 11px); right: 0; min-height: 44px; border: 1px solid #8b93b6; border-radius: 0; background: #f4f1e8; color: #3447a0; font-size: 10px; padding: 8px 12px; display: inline-flex; gap: 8px; align-items: center; }
  .hero-motion:disabled { color: #545972; cursor: default; }
  @media (max-width: 1100px) { .hero-shell { width: calc(100% - 80px); min-height: 970px; } .hero-copy { max-width: 390px; padding-left: 48px; } .hero-edition { display: none; } }
  @media (max-width: 1000px) {
    .hero-composition { grid-template-columns: 1fr; gap: 30px; margin-top: 40px; }
    .hero-copy { max-width: 560px; }
    h1 { font-size: clamp(49px, 7.5vw, 76px); }
    :global(:lang(zh-CN)) h1 { font-size: clamp(40px, 5.7vw, 60px); }
  }
  @media (max-width: 800px) { .hero-shell { width: calc(100% - 48px); min-height: 1030px; } .hero-copy { max-width: 100%; } }
  @media (max-width: 600px) {
    .hero-shell { width: calc(100% - 36px); padding-block: 145px 105px; min-height: 0; }
    .hero-overline { font-size: 10px; padding-bottom: 22px; }
    .hero-overline > span:first-child::before { font-size: 14px; margin-right: 8px; }
    h1 { font-size: clamp(37px, 10.2vw, 61px); line-height: 1.06; letter-spacing: -.065em; }
    :global(:lang(zh-CN)) h1 { font-size: clamp(31px, 8.4vw, 49px); line-height: 1.35; letter-spacing: -.075em; }
    .hero-composition { margin-top: 28px; gap: 28px; }
    .hero-copy { max-width: 100%; padding-left: 0; }
    .hero-copy-index { display: none; }
    .hero-description { font-size: 14px; line-height: 1.95; }
    .product-actions { gap: 18px; margin-top: 22px; }
    .product-actions .button { font-size: 12px; min-height: 53px; padding: 9px 14px; gap: 15px; }
    .product-actions .button-secondary { padding-inline: 0; gap: 8px; }
    .product-note { font-size: 10px; margin-top: 20px; }
    .hero-bottom { bottom: 19px; align-items: end; }
    .hero-bottom-label { font-size: 8px; line-height: 1.9; }
    .hero-scroll { font-size: 10px; gap: 12px; }
    .hero-motion { font-size: 9px; }
  }
  @media (max-width: 360px) { .product-actions { gap: 13px; } .product-actions .button { font-size: 11px; gap: 9px; } }
</style>
