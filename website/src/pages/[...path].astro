---
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.astro';
import GettingStarted from '../components/GettingStarted.astro';
import Guides from '../components/Guides.astro';
import { PAGE_PATHS, pageMetadata, type Locale, type PageName } from '../data/site';

export const getStaticPaths = (() => (['en', 'zh-CN'] as Locale[]).flatMap((locale) => {
  const prefix = locale === 'en' ? '' : 'zh-CN/';
  return (Object.keys(PAGE_PATHS) as PageName[]).map((page) => ({ params: { path: (prefix + PAGE_PATHS[page]).replace(/\/$/, '') || undefined }, props: { locale, page } }));
})) satisfies GetStaticPaths;

interface Props { locale: Locale; page: PageName; }
const { locale, page } = Astro.props;
const metadata = pageMetadata(locale, page);
---
<Layout locale={locale} page={page} {...metadata}>
  {page === 'home' && <Home locale={locale} />}
  {page === 'getting-started' && <GettingStarted locale={locale} />}
  {page === 'guides' && <Guides locale={locale} />}
</Layout>
